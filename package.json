{
  "name": "cadrin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/brand-assets.mjs && astro build && node scripts/finalize-build.mjs && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "qa": "node scripts/cadrin-browser-qa.mjs",
    "deploy": "node scripts/publication-guard.mjs",
    "audit:mobile": "node scripts/cadrin-lighthouse.mjs",
    "cloudflare:check": "cf deploy dist --dry-run --provision=false",
    "content:check": "node scripts/cadrin-content-check.mjs",
    "launch:check": "node scripts/cadrin-content-check.mjs --strict",
    "dev:archives": "astro dev --root archives/concepts --host 127.0.0.1 --port 4322",
    "cloudflare:dev": "node scripts/serve-cloudflare.mjs",
    "hosting:check": "node scripts/hosting-ci.mjs",
    "qa:i18n": "node scripts/i18n-qa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.9",
    "@axe-core/playwright": "4.14.0",
    "cf": "1.0.0-beta.31",
    "lighthouse": "13.6.0",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.0 || ^26.12.0"
  }
}
