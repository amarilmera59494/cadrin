---
import data from '../data/tempus-catalogue.json';
import {purchaseLabel} from '../lib/tempus-catalogue';
import TempusOffer from './TempusOffer.astro';
import TempusBenefits from './TempusBenefits.astro';
import InternationalNotice from './InternationalNotice.astro';
import {localeOf,textFor} from '../lib/i18n';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
import {dateLabel} from "../lib/editorial";
import {destinations,validDestination} from '../data/destinations';
const {id,placement='fiche'}=Astro.props as {id:string;placement?:string};const destination=destinations[id];
const offer=data.products.find(p=>p.reference===destination?.reference);
---
{validDestination(destination)?<><a class="button merchant-button" href={locale==='en'&&destination.englishUrl?destination.englishUrl:destination.url} rel={destination.affiliate?'sponsored':undefined} data-affiliate={destination.affiliate?'true':undefined} data-content={id} data-reference={destination.reference} data-merchant={destination.merchant} data-placement={placement}><span>{offer?purchaseLabel(offer,locale==='en'):t('Voir chez Tempus','View at Tempus')}</span> <span aria-hidden="true">↗</span></a><p class="small-note">{destination.affiliate?t('Lien affilié : Cadrin peut percevoir une commission.','Affiliate link: Cadrin may earn a commission.'):t('Lien ordinaire, sans commission.','Ordinary link. No commission.')} {t('Destination vérifiée le','Destination checked on')} {dateLabel(locale==='en'&&destination.englishVerifiedAt?destination.englishVerifiedAt:destination.verifiedAt,locale)}.</p>{locale==='en'&&<p class="small-note">The retailer may redirect to French or show only partly translated content.</p>}<slot/><TempusOffer compact/><InternationalNotice/><TempusBenefits compact/></>:<p class="merchant-pending">{t('Aucune destination marchande validée pour cette référence. La fiche fabricant reste disponible dans les sources.','No verified retailer destination for this reference. The manufacturer page is available in the sources.')}</p>}
