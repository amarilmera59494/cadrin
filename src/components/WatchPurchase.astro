---
import type {CollectionEntry} from 'astro:content';
import {localeOf,textFor} from '../lib/i18n';
import {dateLabel} from '../lib/editorial';
import CadrinMerchantLink from './CadrinMerchantLink.astro';
import {englishWatches} from '../data/english-watches';
import data from '../data/tempus-catalogue.json';
import {orderLabel} from '../lib/tempus-catalogue';
import {localPath} from '../lib/i18n';
const {watch}=Astro.props as {watch:CollectionEntry<'watches'>};
const p=watch.data,locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const offer=data.products.find(product=>product.reference===p.reference);
const price=offer?.price??p.price,checkedAt=offer?(data.offersCheckedAt||data.checkedAt):p.priceCheckedAt;
---
<aside class="merchant-panel purchase-panel" aria-label={t('Acheter cette montre','Buy this watch')}>
 <span class="eyebrow">{t('Ce modèle chez notre partenaire','This watch at our partner')}</span>
 {price!=null&&checkedAt&&<p class="purchase-price"><strong>{new Intl.NumberFormat(en?'en-GB':'fr-FR',{style:'currency',currency:'EUR'}).format(price)}</strong><small>{t('Prix France relevé le','France price recorded on')} {dateLabel(checkedAt,locale)}, {t('hors livraison.','excluding delivery.')}</small></p>}
 {offer&&<p class="purchase-status">{orderLabel(offer,en)}</p>}
 {watch.id==='seiko-srpe55k1'&&<p class="purchase-variant">{en?englishWatches[watch.id].limit:p.limit}</p>}
 <CadrinMerchantLink id={watch.id}>
 {offer&&<div class="purchase-tools"><button class="save-watch" type="button" data-save-id={offer.id} data-save-label={p.reference} hidden>{t('Garder en favoris','Save watch')}</button><a href={localPath('/catalogue/',locale)+'?brand='+encodeURIComponent(offer.brand)+'&compare='+offer.id+'#catalogue-count'}>{t('Choisir une montre à comparer','Find a watch to compare')} →</a></div>}
 </CadrinMerchantLink>
</aside>
<style>
.purchase-panel{margin:0;padding:24px!important;position:static!important;align-self:start}.purchase-price{display:flex;align-items:baseline;gap:16px;margin:12px 0 18px!important}.purchase-price strong{font:500 42px/1.1 var(--display);white-space:nowrap}.purchase-price small{font-size:12px;line-height:1.6;max-width:34ch}.purchase-variant{font-size:12px;line-height:1.6;margin:12px 0}
.purchase-tools{display:grid;gap:8px;margin:14px 0 20px}.purchase-tools a{font-size:13px;min-height:44px;display:flex;align-items:center}.purchase-status{font-size:13px;line-height:1.6}.purchase-panel :global(.merchant-button){margin-top:16px}
@media(max-width:700px){.purchase-panel{padding:18px!important}.purchase-price{margin:10px 0 14px!important;gap:14px}.purchase-price strong{font-size:36px}}
</style>
