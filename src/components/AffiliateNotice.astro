---
import {hasAffiliation} from '../data/destinations';
import {localeOf,localPath,textFor} from '../lib/i18n';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
---
<p class="disclosure">{hasAffiliation?t('Certains liens sont affiliés : Cadrin peut percevoir une commission si vous achetez via ces liens.','Some links are affiliate links: Cadrin may earn a commission if you buy through them.'):t('Aucun lien affilié actif. Les destinations marchandes sont des liens ordinaires, sans commission.','No active affiliate links. Retailer links do not earn us a commission.')} <a href={localPath('/notre-methode/',locale)+'#affiliation'}>{t('Notre transparence','Our affiliate disclosure')}</a></p>
