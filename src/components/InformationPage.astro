---
import Cadrin from '../layouts/Cadrin.astro';
import {localeOf,localPath,textFor} from '../lib/i18n';
import {publisher} from '../data/publisher';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const {page}=Astro.props as {page:'contact'|'legal'|'privacy'};
const title=page==='contact'?t('Contacter Cadrin','Contact Cadrin'):page==='legal'?t('Mentions légales','Legal notice'):t('Confidentialité et préférences','Privacy and preferences');
---
<Cadrin title={title} description={t('Les informations utiles pour contacter Cadrin, identifier son éditeur et comprendre le fonctionnement du site.','How to contact Cadrin, identify its publisher and understand how the site works.')} crumbs={[{name:title,url:Astro.url.pathname}]}>
 <div class="container"><nav class="breadcrumb" aria-label={t('Fil d’Ariane','Breadcrumb')}><a href={localPath('/',locale)}>{t('Accueil','Home')}</a><span>/</span><span>{title}</span></nav><header class="reading-heading"><h1>{title}</h1></header><article class="reading method-page">
 {page==='contact'&&<><section><h2>{t('Une question, une correction ?','A question or correction?')}</h2><p>{t('Une référence ne correspond pas, une source a changé ou un lien ne fonctionne plus ? Indiquez l’adresse de la page et le point concerné. Vous pouvez joindre la source qui vous semble plus précise.','If a reference does not match, a source has changed or a link no longer works, send us the page address and the point that needs attention. Include a more precise source if you have one.')}</p><a class="button" href={`mailto:${publisher.email}`}>{publisher.email} ↗</a><p class="small-note">{t('Ce lien ouvre votre application de messagerie. Aucun formulaire ni compte n’est nécessaire.','This link opens your email application. No form or account is required.')}</p></section><section><h2>{t('Une commande chez Tempus ?','An order placed with Tempus?')}</h2><p>{t('Cadrin est un média, pas le vendeur. Pour le paiement, le suivi d’un colis, une garantie ou un retour, contactez directement le marchand auprès duquel vous avez commandé.','Cadrin is a publication, not the seller. For payments, parcel tracking, warranty enquiries or returns, contact the retailer you ordered from.')}</p><a href="https://tempusshop.com/pages/nous-contacter">{t('Contacter Tempus Shop','Contact Tempus Shop')} ↗</a></section><section><h2>{t('Proposer une collaboration','Suggest a collaboration')}</h2><p>{t('Écrivez-nous avec les références concernées et les conditions envisagées. L’envoi d’un produit ou une proposition commerciale ne vaut pas accord éditorial. Toute relation rémunérée devra être signalée au lecteur.','Send the relevant references and proposed terms. A product submission or commercial proposal does not imply editorial acceptance. Any paid relationship must be disclosed to readers.')}</p><a href={localPath('/notre-methode/#affiliation',locale)}>{t('Notre méthode et l’affiliation','Our method and affiliate disclosure')}</a></section></>}
 {page==='legal'&&<><section><h2>{t('Éditeur du site','Website publisher')}</h2><dl class="facts"><div><dt>{t('Nom commercial','Trading name')}</dt><dd>{publisher.tradeName}</dd></div><div><dt>{t('Entrepreneur','Owner')}</dt><dd>{publisher.name} — EI</dd></div><div><dt>{t('Régime déclaré','Declared status')}</dt><dd>{t(publisher.status,'Individual entrepreneur — French micro-enterprise')}</dd></div><div><dt>SIREN</dt><dd>{publisher.siren}</dd></div><div><dt>{t('Commune','Town')}</dt><dd>{publisher.town}</dd></div><div><dt>{t('Contact','Contact')}</dt><dd><a href={`mailto:${publisher.email}`}>{publisher.email}</a></dd></div><div><dt>{t('Direction de publication','Publication director')}</dt><dd>{publisher.publicationDirector}</dd></div><div><dt>TVA / VAT</dt><dd>{t('Non applicable, selon la déclaration de l’éditeur.','Not applicable, as declared by the publisher.')}</dd></div></dl><p class="small-note">{t('Mentions incomplètes : l’adresse complète de domiciliation et le téléphone public de l’éditeur ne sont pas renseignés. Cette page ne constitue pas une validation de conformité.','Incomplete notice: the publisher’s full business address and public telephone number have not been supplied. This page does not establish legal compliance.')}</p></section><section><h2>{t('Hébergement','Hosting')}</h2><p>Cloudflare, Inc.<br/>101 Townsend Street, San Francisco, CA 94107, United States.<br/><a href="tel:+16503198930">+1 (650) 319-8930</a></p><p><a href="https://www.cloudflare.com/policies/terms/">{t('Coordonnées et conditions Cloudflare','Cloudflare contact details and terms')} ↗</a></p></section><section><h2>{t('Le rôle de Cadrin','Cadrin’s role')}</h2><p>{t('Cadrin publie des guides et des sélections documentaires. Les achats se font sur le site du marchand, qui définit ses prix, ses disponibilités et ses conditions. Les dates des relevés ne garantissent pas le maintien d’une offre.','Cadrin publishes guides and documented selections. Purchases take place on the retailer’s website under its prices, availability and terms. A recorded price does not guarantee an ongoing offer.')}</p><a href={localPath('/notre-methode/',locale)}>{t('Lire notre méthode et nos limites','Read our method and limits')}</a></section><section><h2>{t('Images et contenus','Images and content')}</h2><p>{t('Les photographies d’ambiance sont créditées sous les images et utilisées selon leur licence. Elles ne représentent pas les montres sélectionnées. Les références exactes attendent des photographies dont les droits sont documentés.','Mood photographs are credited below each image and used under their licences. They do not represent the selected watches. Exact-reference photography awaits documented usage rights.')}</p></section></>}
 {page==='privacy'&&<><section><h2>{t('Ce qui se passe lorsque vous consultez le site','What happens when you browse')}</h2><p>{t('Cadrin ne propose actuellement ni compte lecteur, ni newsletter, ni formulaire. Aucun outil tiers de mesure d’audience, pixel publicitaire ou enregistrement de session n’est intégré. Les polices et les images affichées sont servies par le site.','Cadrin currently has no reader account, newsletter or form. No third-party audience analytics, advertising pixel or session replay is embedded. Fonts and displayed images are served by the site.')}</p><p>{t('Cloudflare assure la distribution des pages, la sécurité et la redirection des courriels. Ce prestataire traite les informations techniques nécessaires au fonctionnement de ses services, notamment les informations de connexion. L’absence d’outil d’audience ne signifie pas absence de traitement technique.','Cloudflare provides page delivery, security and email forwarding. It processes technical information needed to operate its services, including connection information. The absence of audience analytics does not mean that no technical data is processed.')}</p><a href="https://www.cloudflare.com/privacypolicy/">{t('Politique de confidentialité Cloudflare','Cloudflare privacy policy')} ↗</a></section><section><h2>{t('Langue et sélecteur','Language and watch finder')}</h2><p>{t('La clé locale « cadrin-language » mémorise uniquement votre choix FR ou EN. Elle est écrite après votre action et reste sur cet appareil jusqu’à son remplacement ou sa suppression dans les données du navigateur. Elle ne sert pas au suivi publicitaire. Si le stockage est bloqué, les liens de langue restent utilisables.','The local key “cadrin-language” remembers only your FR or EN choice after you act. It stays on this device until replaced or cleared in your browser’s site data. It is not used for advertising tracking. Language links still work if storage is blocked.')}</p><p>{t('Les filtres et les références comparées figurent dans l’adresse de la page. Un lien partagé reprend donc ces critères. N’y saisissez pas d’informations confidentielles.','Filters and compared references appear in the page address. A shared link includes those choices. Do not enter confidential information there.')}</p></section><section><h2>{t('Si vous nous écrivez','If you email us')}</h2><p>{t('Les messages envoyés à contact@cadrin.fr sont transférés vers la messagerie Gmail de l’éditeur. Votre adresse, le contenu du message et les pièces jointes servent au traitement de votre demande. Envoyez uniquement les éléments utiles ; aucune inscription marketing n’est déclenchée.','Messages sent to contact@cadrin.fr are forwarded to the publisher’s Gmail mailbox. Your address, message and attachments are used to handle your enquiry. Send only relevant information; contacting us does not subscribe you to marketing.')}</p><p>{t('Le responsable indiqué est Pierre Narguet, MicroDev. Les modalités détaillées de conservation des échanges et la documentation des traitements doivent encore être finalisées par l’éditeur.','The identified controller is Pierre Narguet, MicroDev. Detailed correspondence retention arrangements and processing documentation still need to be finalised by the publisher.')}</p></section><section><h2>{t('Liens externes et affiliation','External links and affiliation')}</h2><p>{t('Les liens vers Tempus et les fabricants ouvrent des services qui appliquent leurs propres règles. Aucun lien rémunéré n’est actif aujourd’hui. L’activation future d’un suivi affilié ou d’un outil d’analyse demandera une mise à jour de cette notice et des choix nécessaires.','Links to Tempus and manufacturers open services governed by their own policies. No paid links are active today. Future affiliate tracking or analytics will require this notice and any necessary choices to be updated.')}</p></section><section><h2>{t('Vos demandes concernant les données','Requests about your data')}</h2><p>{t('Vous pouvez écrire à contact@cadrin.fr pour toute question ou demande d’accès, de rectification ou d’effacement concernant vos échanges, ainsi que pour exercer les autres droits applicables.','You can email contact@cadrin.fr with questions or requests to access, correct or erase your correspondence data, and to exercise other applicable rights.')}</p><p><a href="https://www.cnil.fr/fr/les-droits-pour-maitriser-vos-donnees-personnelles">{t('Comprendre vos droits auprès de la CNIL','Understand your rights with the CNIL')} ↗</a></p></section></>}
 </article></div>
</Cadrin>
