---
import Cadrin from '../layouts/Cadrin.astro';
import {localeOf,localPath,textFor} from '../lib/i18n';
import {publisher} from '../data/publisher';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const {page}=Astro.props as {page:'contact'|'legal'|'privacy'};
const title=page==='contact'?t('Contacter Cadrin','Contact Cadrin'):page==='legal'?t('Mentions légales','Legal notice'):t('Confidentialité et préférences','Privacy and preferences');
---
<Cadrin title={title} description={page==='contact'?t('Contacter Cadrin : une question sur une montre, une erreur de prix ou de fiche à signaler, une demande presse.','Contact Cadrin: a question about a watch, a price or listing error to report, or a press enquiry.'):page==='legal'?t('Mentions légales de Cadrin : éditeur, hébergeur, liens d’affiliation et responsabilité éditoriale.','Cadrin legal notice: publisher, host, affiliate links and editorial responsibility.'):t('Confidentialité chez Cadrin : statistiques soumises à votre accord, données collectées, durée de conservation et vos droits.','Privacy at Cadrin: consent-based analytics, data collected, retention and your rights.')} crumbs={[{name:title,url:Astro.url.pathname}]}>
 <div class="container"><nav class="breadcrumb" aria-label={t('Fil d’Ariane','Breadcrumb')}><a href={localPath('/',locale)}>{t('Accueil','Home')}</a><span>/</span><span>{title}</span></nav><header class="reading-heading"><h1>{title}</h1></header><article class="reading method-page">
 {page==='contact'&&<><section><h2>{t('Une question, une correction ?','A question or correction?')}</h2><p>{t('Une référence ne correspond pas, une source a changé ou un lien ne fonctionne plus ? Indiquez l’adresse de la page et le point concerné. Vous pouvez joindre la source qui vous semble plus précise.','If a reference does not match, a source has changed or a link no longer works, send us the page address and the point that needs attention. Include a more precise source if you have one.')}</p><a class="button" href={`mailto:${publisher.email}`}>{publisher.email} ↗</a><p class="small-note">{t('Ce lien ouvre votre application de messagerie. Aucun formulaire ni compte n’est nécessaire.','This link opens your email application. No form or account is required.')}</p></section><section><h2>{t('Une commande chez Tempus ?','An order placed with Tempus?')}</h2><p>{t('Cadrin est un média, pas le vendeur. Pour le paiement, le suivi d’un colis, une garantie ou un retour, contactez directement le marchand auprès duquel vous avez commandé.','Cadrin is a publication, not the seller. For payments, parcel tracking, warranty enquiries or returns, contact the retailer you ordered from.')}</p><a href="https://tempusshop.com/pages/nous-contacter">{t('Contacter Tempus Shop','Contact Tempus Shop')} ↗</a></section><section><h2>{t('Proposer une collaboration','Suggest a collaboration')}</h2><p>{t('Écrivez-nous avec les références concernées et les conditions envisagées. L’envoi d’un produit ou une proposition commerciale ne vaut pas accord éditorial. Toute relation rémunérée devra être signalée au lecteur.','Send the relevant references and proposed terms. A product submission or commercial proposal does not imply editorial acceptance. Any paid relationship must be disclosed to readers.')}</p><a href={localPath('/notre-methode/#affiliation',locale)}>{t('Notre méthode et l’affiliation','Our method and affiliate disclosure')}</a></section></>}
 {page==='legal'&&<><section><h2>{t('Éditeur du site','Website publisher')}</h2><dl class="facts"><div><dt>{t('Nom commercial','Trading name')}</dt><dd>{publisher.tradeName}</dd></div><div><dt>{t('Entrepreneur','Owner')}</dt><dd>{publisher.name} — EI</dd></div><div><dt>{t('Régime déclaré','Declared status')}</dt><dd>{t(publisher.status,'Individual entrepreneur — French micro-enterprise')}</dd></div><div><dt>SIREN</dt><dd>{publisher.siren}</dd></div><div><dt>{t('Commune','Town')}</dt><dd>{publisher.town}</dd></div><div><dt>{t('Contact','Contact')}</dt><dd><a href={`mailto:${publisher.email}`}>{publisher.email}</a></dd></div><div><dt>{t('Direction de publication','Publication director')}</dt><dd>{publisher.publicationDirector}</dd></div><div><dt>TVA / VAT</dt><dd>{t('Non applicable, selon la déclaration de l’éditeur.','Not applicable, as declared by the publisher.')}</dd></div></dl><p class="small-note">{t('Mentions incomplètes : l’adresse complète de domiciliation et le téléphone public de l’éditeur ne sont pas renseignés. Cette page ne constitue pas une validation de conformité.','Incomplete notice: the publisher’s full business address and public telephone number have not been supplied. This page does not establish legal compliance.')}</p></section><section><h2>{t('Hébergement','Hosting')}</h2><p>Cloudflare, Inc.<br/>101 Townsend Street, San Francisco, CA 94107, United States.<br/><a href="tel:+16503198930">+1 (650) 319-8930</a></p><p><a href="https://www.cloudflare.com/policies/terms/">{t('Coordonnées et conditions Cloudflare','Cloudflare contact details and terms')} ↗</a></p></section><section><h2>{t('Le rôle de Cadrin','Cadrin’s role')}</h2><p>{t('Cadrin publie des guides et des sélections documentaires. Les achats se font sur le site du marchand, qui définit ses prix, ses disponibilités et ses conditions. Les dates des relevés ne garantissent pas le maintien d’une offre.','Cadrin publishes guides and documented selections. Purchases take place on the retailer’s website under its prices, availability and terms. A recorded price does not guarantee an ongoing offer.')}</p><a href={localPath('/notre-methode/',locale)}>{t('Lire notre méthode et nos limites','Read our method and limits')}</a></section><section><h2>{t('Images et contenus','Images and content')}</h2><p>{t('Les photographies d’ambiance sont créditées sous les images et utilisées selon leur licence. Elles ne représentent pas les montres sélectionnées. Les photos des références et du catalogue sont fournies par Tempus et réutilisées avec son autorisation, déclarée par l’éditeur.','Mood photographs are credited below each image and used under their licences. They do not represent the selected watches. Product and catalogue photographs are supplied by Tempus and reused with its permission, as declared by the publisher.')}</p></section></>}
 {page==='privacy'&&<><section><h2>{t('Des statistiques uniquement avec votre accord','Analytics only with your permission')}</h2><p>{t('Le réglage « Mes préférences de statistiques », en pied de page, permet d’autoriser ou de refuser le comptage des pages consultées, des utilisations du sélecteur, des comparaisons et des clics vers Tempus. Le refus ne bloque aucune fonctionnalité. Votre choix reste sur cet appareil pendant six mois ; vous pouvez le modifier à tout moment. Les signaux Do Not Track et Global Privacy Control désactivent la collecte.','The “My analytics preferences” control in the footer lets you allow or decline counts of page views, finder use, comparisons and clicks to Tempus. Declining does not block any feature. Your choice is stored on this device for six months and can be changed at any time. Do Not Track and Global Privacy Control disable collection.')}</p><p>{t('Les événements contiennent la page, une catégorie de provenance, une campagne connue et, pour un clic marchand, le chemin du produit. Ils ne contiennent ni identifiant lecteur, ni recherche saisie, ni adresse IP ajoutée par notre code. Cloudflare reçoit nécessairement les informations de connexion pour acheminer la requête et conserve des métadonnées techniques. Les événements sont stockés dans ses journaux pour une courte durée, au plus sept jours selon le plan. Les exports utilisés pour le suivi sont des totaux agrégés, sans profil individuel.','Events contain the page, a source category, a known campaign and, for a retailer click, the product path. They contain no reader identifier, typed search or IP address added by our code. Cloudflare necessarily receives connection information to deliver the request and retains technical metadata. Events are stored in its logs for a short period, at most seven days depending on the plan. Reporting exports contain aggregate totals, without individual profiles.')}</p><p>{t('Cette mesure décrit uniquement les interactions consenties. Elle ne compte pas des visiteurs uniques et ne prouve ni achat ni commission. Ces derniers restent dans le programme partenaire Tempus.','This measurement describes only consented interactions. It does not count unique visitors or prove a purchase or commission. Those remain in the Tempus partner programme.')}</p></section><section><h2>{t('Ce qui se passe lorsque vous consultez le site','What happens when you browse')}</h2><p>{t('Cadrin ne propose actuellement ni compte lecteur, ni newsletter, ni formulaire. Aucun pixel publicitaire ni enregistrement de session n’est intégré. Les polices et les images affichées sont servies par le site.','Cadrin currently has no reader account, newsletter or form. No advertising pixel or session replay is embedded. Fonts and displayed images are served by the site.')}</p><p>{t('Pour connaître la fréquentation, le site utilise Cloudflare Web Analytics : un script de Cloudflare compte les pages vues, le site d’origine de la visite (par exemple TikTok ou Pinterest), le type d’appareil, le pays et des mesures de vitesse. Il ne dépose aucun cookie, n’utilise aucun stockage local et ne crée aucun identifiant ou profil de visiteur ; les résultats ne nous parviennent que sous forme de totaux. Ce comptage n’est pas chargé si vous avez refusé les statistiques ou si votre navigateur envoie Do Not Track ou Global Privacy Control.','To understand traffic, the site uses Cloudflare Web Analytics: a Cloudflare script counts page views, the referring site (for example TikTok or Pinterest), device type, country and speed measurements. It sets no cookie, uses no local storage and creates no visitor identifier or profile; we only see totals. It is not loaded if you have declined analytics or if your browser sends Do Not Track or Global Privacy Control.')}</p><p>{t('Cloudflare assure la distribution des pages, la sécurité et la redirection des courriels. Ce prestataire traite les informations techniques nécessaires au fonctionnement de ses services, notamment les informations de connexion. Ces traitements techniques existent aussi lorsque les statistiques facultatives sont refusées.','Cloudflare provides page delivery, security and email forwarding. It processes technical information needed to operate its services, including connection information. These technical operations also occur when optional analytics are declined.')}</p><a href="https://www.cloudflare.com/privacypolicy/">{t('Politique de confidentialité Cloudflare','Cloudflare privacy policy')} ↗</a></section><section><h2>{t('Langue et sélecteur','Language and watch finder')}</h2><p>{t('La clé locale « cadrin-language » mémorise uniquement votre choix FR ou EN. Elle est écrite après votre action et reste sur cet appareil jusqu’à son remplacement ou sa suppression dans les données du navigateur. Elle ne sert pas au suivi publicitaire. Si le stockage est bloqué, les liens de langue restent utilisables.','The local key “cadrin-language” remembers only your FR or EN choice after you act. It stays on this device until replaced or cleared in your browser’s site data. It is not used for advertising tracking. Language links still work if storage is blocked.')}</p><p>{t('Les filtres et les références comparées figurent dans l’adresse de la page. Un lien partagé reprend donc ces critères. N’y saisissez pas d’informations confidentielles.','Filters and compared references appear in the page address. A shared link includes those choices. Do not enter confidential information there.')}</p></section><section><h2>{t('Vos favoris et listes partagées','Saved watches and shared lists')}</h2><p>{t('La clé locale « cadrin-saved-watches-v1 » conserve au maximum 12 identifiants de montres après votre action. Aucun compte ni envoi de cette liste à notre serveur n’est nécessaire. Retirez une montre avec le même bouton, ou effacez les données du site dans votre navigateur pour supprimer la liste. Sans stockage disponible, les favoris restent uniquement sur la page ouverte.','The local key “cadrin-saved-watches-v1” stores up to 12 watch identifiers after your action. No account or upload of the list to our server is needed. Use the same button to remove a watch, or clear this site’s browser data to delete the list. If storage is unavailable, saved watches last only on the open page.')}</p><p>{t('Le lien de partage encode les identifiants dans le fragment de l’adresse, après #. Le navigateur ne transmet pas ce fragment au serveur lors du chargement. Toute personne disposant du lien peut voir la liste et la transférer ; elle ne contient pas votre nom. La liste partagée ne remplace pas les favoris de son destinataire.','The share link encodes identifiers in the address fragment after #. Browsers do not send this fragment to the server when loading the page. Anyone with the link can see and forward the list; it contains no name. Shared lists do not replace the recipient’s own saved watches.')}</p></section><section><h2>{t('Si vous nous écrivez','If you email us')}</h2><p>{t('Les messages envoyés à contact@cadrin.fr sont transférés vers la messagerie Gmail de l’éditeur. Votre adresse, le contenu du message et les pièces jointes servent au traitement de votre demande. Envoyez uniquement les éléments utiles ; aucune inscription marketing n’est déclenchée.','Messages sent to contact@cadrin.fr are forwarded to the publisher’s Gmail mailbox. Your address, message and attachments are used to handle your enquiry. Send only relevant information; contacting us does not subscribe you to marketing.')}</p><p>{t('Le responsable indiqué est Pierre Narguet, MicroDev. Les modalités détaillées de conservation des échanges et la documentation des traitements doivent encore être finalisées par l’éditeur.','The identified controller is Pierre Narguet, MicroDev. Detailed correspondence retention arrangements and processing documentation still need to be finalised by the publisher.')}</p></section><section><h2>{t('Liens externes et affiliation','External links and affiliation')}</h2><p>{t('Les liens vers Tempus et les fabricants ouvrent des services qui appliquent leurs propres règles. Les liens marchands vers Tempus comportent notre identifiant d’affiliation. Après votre clic, Tempus et son prestataire BixGrow peuvent utiliser cet identifiant et des cookies selon leurs propres règles pour attribuer un achat. Aucun script BixGrow ni cookie publicitaire Tempus n’est déposé par Cadrin.','Links to Tempus and manufacturers open services governed by their own policies. Retailer links to Tempus include our affiliate identifier. After your click, Tempus and its provider BixGrow may use that identifier and cookies under their own policies to attribute a purchase. Cadrin embeds no BixGrow script and sets no Tempus advertising cookie.')}</p></section><section><h2>{t('Vos demandes concernant les données','Requests about your data')}</h2><p>{t('Vous pouvez écrire à contact@cadrin.fr pour toute question ou demande d’accès, de rectification ou d’effacement concernant vos échanges, ainsi que pour exercer les autres droits applicables.','You can email contact@cadrin.fr with questions or requests to access, correct or erase your correspondence data, and to exercise other applicable rights.')}</p><p><a href="https://www.cnil.fr/fr/les-droits-pour-maitriser-vos-donnees-personnelles">{t('Comprendre vos droits auprès de la CNIL','Understand your rights with the CNIL')} ↗</a></p></section></>}
 </article></div>
</Cadrin>
