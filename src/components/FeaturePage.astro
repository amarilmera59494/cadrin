---
import Cadrin from '../layouts/Cadrin.astro';
import {sourceLabel} from '../lib/source-labels';
import {features,featurePath,type Feature} from '../data/features';
import data from '../data/tempus-catalogue.json';
import {affiliateUrl} from '../data/affiliation';
import {purchaseLabel,orderLabel,merchantLinkAvailable} from '../lib/tempus-catalogue';
import {localeOf,localPath,textFor,term} from '../lib/i18n';
import {dateLabel} from '../lib/editorial';
import '../styles/features.css';
const {feature:f}=Astro.props as {feature:Feature};
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale),copy=(v:[string,string])=>v[en?1:0];
const picks=f.choices.map(choice=>({choice,p:data.products.find(p=>p.reference===choice.reference)!}));
const money=(value:number)=>new Intl.NumberFormat(en?'en-GB':'fr-FR',{style:'currency',currency:'EUR'}).format(value);
const category=t(f.kind==='brand'?'Les marques':'Les comparatifs',f.kind==='brand'?'Brands':'Comparisons');
const root=localPath(f.kind==='brand'?'/marques/':'/comparatifs/',locale);
const rows:[string,string][]=[['Cadran','dial'],['Mouvement','movement'],['Dimension du boîtier','caseSize'],['Épaisseur','thickness'],['Boîtier','caseMaterial'],['Bracelet','strap'],['Verre','glass'],['Calibre','calibre'],['Fonctions','functions'],['Étanchéité','water']];
const rowEn:Record<string,string>={'Cadran':'Dial','Fonctions':'Functions','Mouvement':'Movement','Dimension du boîtier':'Case size','Épaisseur':'Thickness','Boîtier':'Case','Bracelet':'Strap / bracelet','Verre':'Crystal','Calibre':'Calibre','Étanchéité':'Water resistance'};
const related=features.filter(v=>v!==f).sort((a,b)=>Number(b.choices.some(c=>f.choices.some(x=>x.reference===c.reference)))-Number(a.choices.some(c=>f.choices.some(x=>x.reference===c.reference)))||Number(b.kind===f.kind)-Number(a.kind===f.kind)).slice(0,3);
---
<Cadrin title={copy(f.title)} description={copy(f.intro)} article verifiedAt={f.verifiedAt} crumbs={[{name:category,url:root},{name:copy(f.title),url:featurePath(f,en)}]}>
 <article class="container feature-page">
  <header class="feature-heading"><a class="eyebrow" href={root}>{category} ↗</a><h1>{copy(f.title)}</h1><p class="feature-intro">{copy(f.intro)}</p><p class="small-note">{t('Dossier documentaire CADRIN','A CADRIN documentary guide')} · {dateLabel(f.verifiedAt,locale)}</p></header>
  <div class="feature-hero" style={`--pick-count:${picks.length}`}>
   {picks.map(({p,choice},i)=><a href={`#choix-${i+1}`}><div><img src={p.image} width={p.width} height={p.height} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} alt={`${p.title} · ${p.reference}`}/></div><span>{copy(choice.label)}</span><small>{p.reference}</small></a>)}
  </div>
  <p class="feature-caption">{t('Photos Tempus utilisées avec autorisation. Les modèles ne sont pas représentés à la même échelle.','Tempus photos used with permission. Models are not shown to the same scale.')}</p>
  <aside class="feature-verdict"><span class="eyebrow">{t('Pour commencer','Start here')}</span><p>{copy(f.verdict)}</p><a class="text-link" href="#les-modeles">{t('Voir les modèles et les prix','See models and prices')} ↓</a></aside>
  <div class="feature-reading">
   <nav class="feature-toc" aria-label={t('Dans ce dossier','In this guide')}><strong>{t('Dans ce dossier','In this guide')}</strong>{f.sections.map((s,i)=><a href={`#section-${i+1}`}>{copy(s.title)}</a>)}<a href="#les-modeles">{t('Nos choix en détail','Our choices in detail')}</a><a href="#caracteristiques">{t('Les caractéristiques','Specifications')}</a><a href="#sources">{t('Sources et méthode','Sources and method')}</a></nav>
   <div class="feature-prose">{f.sections.map((section,i)=><section id={`section-${i+1}`}><h2>{copy(section.title)}</h2>{section.paragraphs.map(p=><p>{copy(p)}</p>)}{section.source&&<a class="text-link" href={section.source}>{t('Consulter la source officielle','Read the official source')} ↗</a>}{section.links&&<ul class="feature-section-links">{section.links.map(link=><li><a href={localPath(link.href.split('?')[0],locale)+(link.href.includes('?')?'?'+link.href.split('?')[1]:'')}>{copy(link.label)} →</a></li>)}</ul>}</section>)}</div>
  </div>
  <section id="les-modeles" class="feature-picks"><div class="feature-section-heading"><h2>{t('Les références à regarder.','The references to consider.')}</h2><p>{t('Des choix par usage, avec leurs points forts et ce qu’il faut regarder avant de commander.','Choices by use, with their strengths and what to consider before ordering.')}</p></div>
   <div class="feature-pick-grid" style={`--pick-count:${picks.length}`}>
   {picks.map(({p,choice},i)=><article class="feature-pick" id={`choix-${i+1}`} data-reference={p.reference}><img src={p.image} width={p.width} height={p.height} loading="lazy" alt={p.title}/><div class="feature-pick-copy"><p class="eyebrow">{copy(choice.label)}</p><h3>{p.title}</h3><p class="small-note">{p.reference}</p><p>{copy(choice.why)}</p><p class="feature-consider"><strong>{t('À regarder','Consider')} — </strong>{copy(choice.limit)}</p><p class="feature-price">{money(p.price)}</p>{!merchantLinkAvailable(p)&&<small>{t("Prix du flux Tempus ; achat non vérifiable actuellement.","Tempus feed price; purchase currently unverified.")}</small>}<p class="small-note">{orderLabel(p,en)}</p>{merchantLinkAvailable(p)&&<a class="button merchant-button" data-reference={p.reference} data-placement="product" href={affiliateUrl(p.source)} rel="sponsored">{purchaseLabel(p,en)} ↗</a>}<small>{merchantLinkAvailable(p)?t('Lien affilié · prix hors livraison','Affiliate link · excludes delivery'):t('Photo Tempus · prix indicatif hors livraison','Tempus photo · indicative price excluding delivery')}</small><button type="button" class="save-watch" data-save-id={p.id} data-save-label={p.reference} hidden>{t('Garder en favoris','Save watch')}</button></div></article>)}
   </div>
   <p class="small-note">{t('Prix France et conditions de commande relevés le ','France prices and ordering status checked on ')}{dateLabel(data.offersCheckedAt||data.checkedAt,locale)}. {f.brand==='Longines'?t('La commande de ces références ne peut pas être vérifiée actuellement.','Ordering these references cannot currently be verified.'):t('Le prix et le délai à votre adresse sont à vérifier chez Tempus. CADRIN peut percevoir une commission si vous achetez via ces liens.','Check price and delivery to your address at Tempus. CADRIN may earn a commission when you buy through these links.')}</p>
   {(f.priceGap||f.slug==='tsuyosa-ou-seiko-5-budget')&&<p class="feature-price-gap">{t('Écart au relevé, hors livraison : ','Recorded difference, excluding delivery: ')}<strong>{money(Math.abs(picks[1].p.price-picks[0].p.price))}</strong>.</p>}
  </section>
  <section id="caracteristiques" class="feature-specs"><h2>{t('Les différences, côte à côte.','The differences, side by side.')}</h2><p class="small-note">{t('Caractéristiques des fiches Tempus. Une donnée absente reste non renseignée. Faites défiler le tableau horizontalement sur mobile.','Specifications from Tempus listings. Missing data stays unspecified. Scroll the table horizontally on mobile.')}</p>
   <div class="feature-table-wrap" role="region" tabindex="0" aria-label={t('Tableau comparatif des caractéristiques','Specification comparison table')}><table><caption class="feature-table-caption">{copy(f.title)}</caption><thead><tr><th scope="col">{t('Le repère','Specification')}</th>{picks.map(({p})=><th scope="col">{p.reference}</th>)}</tr></thead><tbody>{rows.map(([label,key])=><tr><th scope="row">{en?rowEn[label]:label}</th>{picks.map(({p})=><td>{(p as Record<string,unknown>)[key]?term(String((p as Record<string,unknown>)[key]),locale):t('Non renseigné','Not specified')}</td>)}</tr>)}<tr><th scope="row">{t('Fiche technique vérifiée le','Specification check')}</th>{picks.map(({p})=><td>{p.specCheckedAt?dateLabel(p.specCheckedAt,locale):t('Date non renseignée','Date not recorded')}</td>)}</tr></tbody></table></div>
   <a class="text-link" href={localPath('/catalogue/',locale)+'?compare='+picks.map(({p})=>p.id).join(',')+'#catalogue-comparison'}>{t('Ouvrir dans le comparateur','Open in the comparison tool')} →</a>
  </section>
  {f.brand&&<div class="feature-catalogue-callout"><h2>{t('Continuer chez '+f.brand,'Explore more from '+f.brand)}</h2><p>{t('Affinez par budget, couleur ou mouvement dans notre catalogue. Les références proposées ne sont pas toutes en stock : le statut de commande figure sur chaque carte.','Filter by budget, colour or movement in our catalogue. Not every listed reference is in stock: each card shows its ordering status.')}</p><a class="button" href={localPath('/catalogue/',locale)+'?brand='+encodeURIComponent(f.brand)}>{t('Explorer '+f.brand,'Explore '+f.brand)} →</a>{f.slug==='casio-g-shock'&&<a class="text-link" href={localPath('/catalogue/',locale)+'?brand=G-Shock'}>{t('Voir aussi les G-Shock','Explore G-Shock too')} →</a>}</div>}
  <section id="sources" class="feature-sources"><h2>{t('D’où viennent ces informations ?','Where does this information come from?')}</h2><p>{t('Ce dossier repose sur des documents et des fiches produits, pas sur un essai au poignet. L’histoire s’appuie sur les sources officielles citées ; les prix, photos, caractéristiques et destinations d’achat viennent des références Tempus ci-dessous. Notre sélection n’est pas un classement de ventes.','This guide is based on documents and product listings, not a hands-on test. History uses the official sources cited; prices, photos, specifications and purchase destinations come from the exact Tempus references below. Our selection is not a sales ranking.')}</p><ul>{f.sources.map(s=><li><a href={s.url}>{en?sourceLabel(s.url):s.label} ↗</a></li>)}{picks.map(({p})=><li>{merchantLinkAvailable(p)?<a href={affiliateUrl(p.source)} rel="sponsored">Tempus · {p.reference} ↗</a>:<span>Tempus · {p.reference} — {t('relevé conservé, page redirigée','record retained, listing redirects')}</span>}</li>)}</ul><a href={localPath('/notre-methode/',locale)}>{t('Notre méthode de sélection','Our selection method')} →</a></section>
  <section class="feature-related"><h2>{t('Pour poursuivre votre choix.','Keep exploring.')}</h2>{related.map(v=><a href={featurePath(v,en)}>{copy(v.title)} →</a>)}<a href={localPath('/guides/automatique-quartz-solaire/',locale)}>{t('Automatique, quartz ou solaire ?','Automatic, quartz or solar?')} →</a></section>
 </article>
</Cadrin>
