---
// Barre d'achat mobile : prix daté et lien Tempus restent à portée de pouce quand le bloc d'achat
// principal sort de l'écran. Elle disparaît dès que ce bloc est visible, pour ne jamais doubler l'offre.
interface Props {price:number;label:string;href:string;checkedAt:string;reference:string;watch?:string}
const {price,label,href,checkedAt,reference,watch='[data-buy-anchor]'}=Astro.props;
const money=new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(price);
const [,month,day]=checkedAt.split('-');
// Libellé court pour tenir sur une ligne ; le marchand reste nommé juste à côté du prix.
const short=label.replace(/ chez Tempus$/,'');
---
<div class="buy-bar" data-buy-bar data-watch={watch} hidden>
 <p><strong>{money}</strong><small>Tempus · relevé le {day}/{month} · lien affilié</small></p>
 <a class="button merchant-button" data-placement="product-sticky" data-reference={reference} href={href} rel="sponsored"><span>{short}<span class="sr-only">{label.slice(short.length)}</span></span><span aria-hidden="true">↗</span></a>
</div>
<script>
const bar=document.querySelector<HTMLElement>('[data-buy-bar]');
const anchor=bar?document.querySelector(bar.dataset.watch!):null;
if(bar&&anchor&&'IntersectionObserver' in window){
 bar.hidden=false;
 new IntersectionObserver(([entry])=>{const shown=!entry.isIntersecting;bar.classList.toggle('is-shown',shown);document.documentElement.classList.toggle('buy-bar-on',shown);}).observe(anchor);
}
</script>
<style>
.buy-bar{display:none}
@media(max-width:800px){
 .buy-bar{position:fixed;inset:auto 0 0;z-index:20;display:flex;align-items:center;gap:16px;padding:10px var(--gutter) calc(10px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--line);box-shadow:0 -10px 28px rgb(54 19 30 / .1);transform:translateY(110%);visibility:hidden;transition:transform 280ms cubic-bezier(.16,1,.3,1),visibility 0s linear 280ms}
 .buy-bar[hidden]{display:none}
 .buy-bar.is-shown{transform:none;visibility:visible;transition:transform 280ms cubic-bezier(.16,1,.3,1)}
 .buy-bar p{display:grid;margin:0;line-height:1.2;max-width:none;flex-shrink:0}
 .buy-bar strong{font:500 28px/1 var(--display);color:var(--wine);font-variant-numeric:tabular-nums}
 .buy-bar small{margin-top:4px;font-size:12px;color:var(--muted)}
 .buy-bar .button.merchant-button{flex:1;width:auto;min-width:0;min-height:48px;padding:10px 14px;font-size:14px}
 :global(.buy-bar-on) :global(.c-footer){padding-bottom:96px}
}
@media(prefers-reduced-motion:reduce){.buy-bar,.buy-bar.is-shown{transition:none}}
</style>
