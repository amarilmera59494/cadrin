---
// Visuel d'un guide : décor d'ambiance avec la vraie photo de la montre (public/images/guides/<id>.webp),
// sinon la photo produit seule. Le visuel mène à la fiche de la montre.
import fs from 'node:fs';
import visuals from '../data/guide-visuals.json';
import data from '../data/tempus-catalogue.json';
import {localeOf,localPath} from '../lib/i18n';
import {ficheHref} from '../lib/fiches';
import type {CatalogueProduct} from '../lib/tempus-catalogue';
const {id}=Astro.props as {id:string};
const ref=(visuals as Record<string,string>)[id];
const p=(data.products as CatalogueProduct[]).find(p=>p.reference===ref);
const locale=localeOf(Astro.url.pathname),en=locale==='en';
const scene=fs.existsSync(`public/images/guides/${id}.webp`)?`/images/guides/${id}.webp`:null;
const href=p?ficheHref(p,en)||localPath('/catalogue/?q='+encodeURIComponent(p.reference)+'#catalogue-count',locale):null;
---
{p&&<figure class={'guide-visual'+(scene?' is-scene':'')}><a href={href!}>{scene?<img src={scene} width="1200" height="675" alt={p.title} loading="lazy" decoding="async"/>:<img src={p.image} width={p.width} height={p.height} alt={p.title} loading="lazy" decoding="async"/>}</a><figcaption>{en?'Tempus photo · ':'Photo Tempus · '}{p.title}</figcaption></figure>}
<style>.guide-visual{margin:0}.guide-visual a{display:block;background:white}.guide-visual img{display:block;width:100%;height:320px;object-fit:contain}.guide-visual.is-scene a{background:var(--sand)}.guide-visual.is-scene img{height:auto;aspect-ratio:16/9;object-fit:cover}.guide-visual figcaption{font-size:11px;line-height:1.6;margin-top:8px;color:var(--muted);overflow-wrap:anywhere}@media(max-width:700px){.guide-visual img{height:230px}.guide-visual.is-scene img{height:auto}}</style>
