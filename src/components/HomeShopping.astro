---
import {localeOf,textFor,localPath,term} from '../lib/i18n';
import data from '../data/tempus-catalogue.json';
import {filterCatalogue,emptyFilters} from '../lib/tempus-catalogue';
import GuideExamples from './GuideExamples.astro';
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const budgets=['','50','150','350','500','1000'],movements=['','Quartz','Automatique','Solaire'],colours=['','Noir','Bleu','Vert','Blanc','Rose'];
const counts:Record<string,number>={};
for(const budget of budgets)for(const movement of movements)for(const dial of colours)counts[[budget,movement,dial].join('|')]=filterCatalogue(data.products,{...emptyFilters,budget,movement,dial,order:'open'}).length;
---
<section class="container home-shopping" id="choisir" aria-labelledby="shopping-title">
 <div class="shopping-heading"><div><span class="eyebrow">{t('Du goût. Un budget. Une montre.','Your taste. Your budget. Your watch.')}</span><h2 id="shopping-title">{t('Trouvez votre point de départ.','Find your starting point.')}</h2></div><p>{t('Choisissez ce qui compte pour vous. Comparez les modèles, puis achetez directement chez notre partenaire Tempus.','Choose what matters to you. Compare the watches, then buy directly from our partner Tempus.')}</p></div>
 <form data-quick-finder data-counts={JSON.stringify(counts)} data-en={en} action={localPath('/catalogue/',locale)+'#catalogue-count'} method="get" hidden>
  <input type="hidden" name="order" value="open"/>
  <label>{t('Votre budget maximum','Your maximum budget')}<select name="budget">{budgets.map(n=><option value={n}>{n?`${n} €`:t('Sans plafond','No maximum')}</option>)}</select></label>
  <label>{t('Le mouvement','The movement')}<select name="movement">{movements.map(m=><option value={m}>{m?term(m,locale):t('Tous','Any')}</option>)}</select></label>
  <label>{t('Couleur du cadran','Dial colour')}<select name="dial">{colours.map(c=><option value={c}>{c?term(c,locale):t('Toutes','Any')}</option>)}</select></label>
  <button class="button" type="submit">{t('Afficher les montres','Show watches')} <span aria-hidden="true">→</span></button>
  <p class="quick-status" role="status" aria-live="polite"></p><button type="reset" class="quick-reset">{t('Effacer mes critères','Clear my choices')}</button>
 </form>
 <p class="shopping-note">{t('Commande ouverte au dernier relevé ; délai à confirmer chez Tempus. Les caractéristiques non renseignées ne sont pas devinées.','Ordering open at the last check; confirm lead time with Tempus. Missing specifications are not guessed.')}</p>
 <noscript><p><a class="text-link" href={localPath('/catalogue/',locale)}>{t('Parcourir toutes les montres','Browse all watches')} →</a></p></noscript>
 <div class="shopping-subhead"><h3>{t('Quatre envies, quatre points de départ.','Four directions to explore.')}</h3><a class="text-link" href={localPath('/catalogue/?collection=best&order=open',locale)}>{t('Voir les best-sellers Tempus','See Tempus bestsellers')} →</a></div>
 <p class="shopping-note">{t('Une sélection éditoriale, sans classement. Prix relevés, hors livraison. Liens affiliés : vos achats peuvent rémunérer Cadrin.','An editorial selection, without a ranking. Recorded prices exclude delivery. Affiliate links: purchases may earn Cadrin a commission.')}</p>
 <GuideExamples id="home" en={en}/>
 <a class="text-link" href={localPath('/selections/',locale)}>{t('Lire nos sélections commentées','Read our watch selections')} →</a>
</section>
<script>
for(const form of document.querySelectorAll<HTMLFormElement>('[data-quick-finder]')){
 const counts=JSON.parse(form.dataset.counts!),en=form.dataset.en==='true',submit=form.querySelector<HTMLButtonElement>('[type=submit]')!,status=form.querySelector<HTMLElement>('[role=status]')!;
 const update=()=>{const key=['budget','movement','dial'].map(n=>(form.elements.namedItem(n) as HTMLSelectElement).value).join('|'),count=counts[key]??0;submit.disabled=count===0;submit.textContent=en?`Show ${count.toLocaleString('en-GB')} ${count===1?'watch':'watches'} →`:`Voir ${count.toLocaleString('fr-FR')} ${count===1?'montre':'montres'} →`;status.textContent=count===0?(en?'No match. Try a wider budget or remove a colour or movement.':'Aucun modèle ne réunit ces critères. Essayez un budget plus large ou retirez une couleur ou un mouvement.'):(en?'You can refine and compare on the next page.':'Vous pourrez affiner et comparer sur la page suivante.');};
 form.hidden=false;form.addEventListener('change',update);form.addEventListener('reset',()=>requestAnimationFrame(update));update();
}
</script>
<style>
.home-shopping{padding-block:48px 56px;scroll-margin-top:24px}.shopping-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:end}.shopping-heading h2{font-size:clamp(34px,4vw,52px);margin-top:10px}.shopping-heading p{max-width:52ch;font-size:16px}.home-shopping form{margin:26px 0 12px;padding:24px;background:var(--sand);display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) 1.15fr;gap:12px 18px;align-items:end}.home-shopping form[hidden]{display:none}.home-shopping label{display:grid;gap:7px;font-size:13px;font-weight:600}.home-shopping select{min-width:0;width:100%;min-height:50px;padding:10px;color:var(--wine);background:var(--paper);border:1px solid var(--muted)}.home-shopping button{font:inherit}.home-shopping button[type=submit]{font-size:14px;justify-content:center;white-space:normal;line-height:1.4}.home-shopping button:disabled{opacity:.6;cursor:not-allowed}.quick-status{grid-column:1/4;font-size:12px;line-height:1.6}.quick-reset{background:none;border:0;color:var(--wine);text-decoration:underline;min-height:44px;font-size:12px!important}.shopping-note{font-size:12px;line-height:1.7;color:var(--muted)}.shopping-subhead{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin:38px 0 12px}.shopping-subhead h3{font:500 30px/1.2 var(--display)}.shopping-subhead a{font-size:13px}
.home-shopping :global(.guide-examples){grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin:24px 0}.home-shopping :global(.guide-example){display:flex;flex-direction:column}.home-shopping :global(.guide-example>div){display:flex;flex-direction:column;flex:1;padding:18px}.home-shopping :global(.guide-example h3){font:500 28px/1.15 var(--display)}.home-shopping :global(.guide-example p){font-size:14px;line-height:1.7;margin:12px 0}.home-shopping :global(.guide-example .example-price){margin-top:auto;padding-top:12px}.home-shopping :global(.guide-example .example-ref){font-size:11px}.home-shopping :global(.example-status){min-height:34px}.home-shopping :global(.guide-example img){height:220px}
@media(max-width:900px){.shopping-heading{gap:24px}.home-shopping form{grid-template-columns:repeat(2,minmax(0,1fr))}.quick-status{grid-column:1/-1}.home-shopping :global(.guide-examples){grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.home-shopping{padding-block:32px}.shopping-heading{display:block}.shopping-heading p{font-size:14px;margin-top:16px}.home-shopping form{padding:18px;gap:12px}.home-shopping label:first-of-type{grid-column:1/-1}.home-shopping button[type=submit]{grid-column:1/-1}.quick-reset{justify-self:start}.shopping-subhead{display:block;margin-top:28px}.shopping-subhead h3{font-size:28px}.home-shopping :global(.guide-examples){gap:20px 12px}.home-shopping :global(.guide-example>a){margin:0}.home-shopping :global(.guide-example img){height:180px}.home-shopping :global(.guide-example>div){padding:12px}.home-shopping :global(.guide-example h3){font-size:23px}.home-shopping :global(.guide-example p){font-size:12px}.home-shopping :global(.merchant-button){padding:12px 7px;font-size:12px;gap:6px}}
</style>
