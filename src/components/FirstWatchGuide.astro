---
import SourceLink from './SourceLink.astro';
import CatalogueDiscovery from './CatalogueDiscovery.astro';
import GuideOpening from './GuideOpening.astro';
import GuideTakeaways from './GuideTakeaways.astro';
import {getCollection,render} from 'astro:content';
import Cadrin from '../layouts/Cadrin.astro';
import Comparison from './MovementComparison.astro';
import {catalogue,dateLabel} from '../lib/editorial';
const {selections}=await catalogue();
import type {CollectionEntry} from 'astro:content';
interface Props {entry: CollectionEntry<'guides'>}
const {entry}=Astro.props;
const {Content}=await render(entry);
const chapters=await Promise.all((await getCollection('guide')).sort((a,b)=>a.data.order-b.data.order).map(async e=>({...e,...await render(e)})));
---
<Cadrin title={entry.data.title} description={entry.data.description} article verifiedAt={entry.data.verifiedAt} crumbs={[{name:'Guides',url:'/guides/'},{name:'Première montre',url:'/guides/choisir-premiere-montre/'}]}>
<div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span>Première montre</span></nav><GuideOpening id={entry.id}><header class="reading-heading"><span class="eyebrow">Le guide / 01</span><h1>Choisir sa première montre, simplement.</h1><Content/><div class="reading-meta"><span>Synthèse documentaire · Sans essai produit</span><span>Faits revus le {dateLabel(entry.data.verifiedAt!)}</span></div></header></GuideOpening>
<div class="guide-layout"><nav class="toc" aria-label="Sommaire du guide"><span class="eyebrow">Dans ce guide</span>{chapters.map(e=><a href={`#${e.id}`}><span>0{e.data.order}</span>{e.data.short}</a>)}<a href="#comparatif">Les mouvements, en regard</a><a href="#sources">Sources & limites</a></nav>
<article class="reading"><GuideTakeaways id={entry.id}/>
{chapters.map(({id,data,Content:Chapter})=><section id={id}><span class="eyebrow">0{data.order} / {data.short}</span><h2>{data.title}</h2><Chapter/>{['taille','mouvement'].includes(id)&&<p class="chapter-source">Dimensions et réserve annoncées : <a href="https://www.seikowatches.com/fr-fr/products/5sports/srpe55">Seiko SRPE55</a> et <a href="https://www.seikowatches.com/fr-fr/products/5sports/srpg35">SRPG35</a>. Repère solaire : <a href="https://de.citizenwatch.eu/de/p/aw1231-58e/">Citizen Eco-Drive AW1231-58E</a>. Les conseils de choix sont une synthèse éditoriale.</p>}</section>)}
<section id="comparatif"><span class="eyebrow">En un regard</span><h2>Trois mouvements, trois habitudes.</h2><Comparison/></section><section id="sources"><h2>Sources et limites de ce guide</h2><p>Les caractéristiques citées viennent des fabricants. Aucun essai au poignet ni mesure de performance n’a été réalisé par Cadrin. Les repères de budget sont des pistes de recherche, jamais des prix attribués aux références.</p><ul class="source-list">{entry.data.sources.map(s=><li><SourceLink url={s.url}>{s.label} ↗</SourceLink></li>)}</ul><p><a href="/notre-methode/">Lire notre méthode et le fonctionnement de l’affiliation.</a></p></section><CatalogueDiscovery compact/><div class="guide-end"><a class="button" href={selections[0]?`/selections/${selections[0].id}/`:'/selections/'}>Explorer la sélection <span aria-hidden="true">→</span></a><a class="text-link" href="/guides/">Tous les guides</a></div></article></div></div>
</Cadrin>
