---
// Vitrine de l'accueil : trois références exactes vendues par Tempus, photos du vendeur non retouchées,
// prix relevés. Elle remplace la photo d'ambiance « hors sélection » : ce que l'on voit d'abord est achetable.
import data from '../data/tempus-catalogue.json';
import groups from '../data/guide-examples.json';
import {displayTitle,type CatalogueProduct} from '../lib/tempus-catalogue';
import {ficheHref} from '../lib/fiches';
const money=(n:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(n);
const products=(groups as unknown as Record<string,string[][]>).home.map(([ref])=>(data.products as CatalogueProduct[]).find(p=>p.reference===ref)).filter((p):p is CatalogueProduct=>!!p&&p.orderable&&!!ficheHref(p));
// Centre: the second-highest price (an everyday reference rather than the dearest); the last two others flank it.
const sorted=products.slice().sort((a,b)=>b.price-a.price);
const centre=sorted[1]??sorted[0],sides=products.filter(p=>p!==centre).slice(-2);
const items=sides.length===2?[sides[0],centre,sides[1]]:[centre,...sides].filter(Boolean);
const checked=((data as any).offersCheckedAt||data.checkedAt).split('-').reverse().join('/');
---
{items.length>0&&<figure class="hero-vitrine">
 <ul>{items.map(p=><li class:list={{'is-centre':p===centre}}><a href={ficheHref(p)!}><img src={p.image} width={p.width} height={p.height} alt="" loading="eager" decoding="async" fetchpriority={p===centre?'high':undefined}/><span class="vitrine-name">{displayTitle(p).replace(/\s*-\s*\d{6}$/,'')}</span><span class="vitrine-price">{money(p.price)}</span></a></li>)}</ul>
 <figcaption>Références exactes, photos Tempus non retouchées · prix France relevés le {checked}, hors livraison.</figcaption>
</figure>}
<style>
.hero-vitrine{margin:0;background:#fff;display:flex;flex-direction:column;justify-content:center;padding:clamp(28px,4vw,64px) clamp(20px,3vw,48px) 0;min-width:0}
.hero-vitrine ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:clamp(12px,2vw,32px);align-items:end}
.hero-vitrine a{display:flex;flex-direction:column;align-items:center;text-align:center;text-decoration:none;color:var(--ink)}
.hero-vitrine img{width:100%;height:clamp(200px,24vw,330px);object-fit:contain;transition:transform 500ms cubic-bezier(.16,1,.3,1)}
.hero-vitrine .is-centre img{height:clamp(250px,31vw,430px)}
.hero-vitrine a:hover img,.hero-vitrine a:focus-visible img{transform:translateY(-6px)}
.vitrine-name{margin-top:14px;font:500 clamp(17px,1.4vw,22px)/1.1 var(--display);text-transform:uppercase;color:var(--wine);text-wrap:balance}
.vitrine-price{margin-top:6px;font:500 clamp(22px,1.8vw,28px)/1 var(--display);font-variant-numeric:tabular-nums}
.hero-vitrine a:hover .vitrine-name{text-decoration:underline;text-underline-offset:4px}
.hero-vitrine figcaption{margin-top:clamp(20px,3vw,40px);padding:10px 0 14px;border-top:1px solid var(--line);font-size:12px;line-height:1.5;color:var(--muted);text-align:center}
.hero-vitrine :focus-visible{outline-color:var(--accent)}
@media(max-width:700px){
 .hero-vitrine{padding:20px var(--gutter) 0}
 .hero-vitrine ul{gap:10px}
 .hero-vitrine img{height:128px}.hero-vitrine .is-centre img{height:150px}
 .vitrine-name{margin-top:8px;font-size:14px}.vitrine-price{font-size:18px}
 .hero-vitrine figcaption{margin-top:16px;text-align:left}
}
@media(prefers-reduced-motion:reduce){.hero-vitrine img{transition:none}}
</style>
