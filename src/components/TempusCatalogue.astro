---
import {filterCatalogue,emptyFilters,dialColours} from '../lib/tempus-catalogue';
import TempusOffer from './TempusOffer.astro';
import MerchantAvailabilityNote from './MerchantAvailabilityNote.astro';
import Cadrin from '../layouts/Cadrin.astro';
import CatalogueCard from './CatalogueCard.astro';
import GuidedChoice from './GuidedChoice.astro';
import {catalogue as editorialCatalogue} from '../lib/editorial';
import data from '../data/tempus-catalogue.json';
import {localeOf,textFor,localPath,term} from '../lib/i18n';
import {dateLabel} from '../lib/editorial';
import '../styles/catalogue.css';
import '../styles/growth.css';
const {page=1,finder=false}=Astro.props as {page?:number;finder?:boolean};
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const root=localPath(finder?'/trouver-ma-montre/':'/catalogue/',locale),pages=Math.ceil(data.products.length/data.pageSize);
const pageUrl=(p:number)=>localPath('/catalogue/',locale)+(p>1?`${p}/`:'');
const products=filterCatalogue(data.products,emptyFilters).slice((page-1)*data.pageSize,page*data.pageSize);
const {finder:analysed}=await editorialCatalogue();
const legacyCompare=Object.fromEntries(analysed.map(w=>[w.id,data.products.find(p=>p.reference===w.data.reference)?.id]).filter(([,id])=>id));
const brands=[...new Set(data.products.map(p=>p.brand))].sort();
---
<Cadrin noindex={page>1} title={`${t(finder?'Trouver ma montre':'Explorer les montres chez Tempus',finder?'Find my watch':'Explore watches at Tempus')}${page>1?` · ${page}`:''}`} description={finder?t('Trouvez votre montre en quelques filtres : budget, taille, mouvement, bracelet. Prix datés, fiches détaillées et liens directs.','Find your watch with a few filters: budget, size, movement and strap. Dated prices, detailed listings and direct links.'):(page>1?t(`Page ${page} du catalogue. `,`Catalogue page ${page}. `):'')+t('Cherchez une référence précise ou explorez les montres Tempus par marque, budget et mouvement. Photos réelles, relevés datés et liens directs vers les produits.','Find a reference or browse Tempus watches by brand, budget and movement. Real product images, dated observations and direct product links.')} crumbs={[{name:t('Catalogue Tempus','Tempus catalogue'),url:root}]}>
 <div class="container catalogue" data-catalogue data-page={page} data-root={root} data-legacy={JSON.stringify(legacyCompare)}>
 <nav class="breadcrumb" aria-label={t('Fil d’Ariane','Breadcrumb')}><a href={localPath('/',locale)}>{t('Accueil','Home')}</a><span>/</span><span>{t('Catalogue Tempus','Tempus catalogue')}</span></nav>
 <header class="catalogue-heading"><div><span class="eyebrow">{t('Le choix, en plus grand','A wider field of choice')}</span><h1>{t('Trouvez celle qui vous ressemble.','Find the one that feels like you.')}</h1></div><div><p>{t('Un cadran bleu, un bracelet acier, une G-Shock ou un best-seller Tempus : partez de ce qui vous plaît, puis comparez vos trois favorites.','A blue dial, a steel bracelet, a G-Shock or a Tempus bestseller: start with what you like, then compare your three favourites.')}</p><a class="text-link catalogue-browse" href="#catalogue-count">{t('Voir les montres ↓','Browse watches ↓')}</a> <a class="text-link" href={localPath('/analyses/',locale)}>{t('Les modèles analysés par Cadrin →','Watches analysed by Cadrin →')}</a></div></header>
 <a class="saved-quick-link" href={localPath('/mes-favoris/',locale)}>{t('♡ Mes favoris et ma liste cadeau','♡ Saved watches and gift list')} (<span data-saved-count>0</span>) →</a>
 {finder&&<GuidedChoice/>}
 <div class="catalogue-context"><p><strong>{data.products.length.toLocaleString(en?'en-GB':'fr-FR')} {t('fiches marchandes','retailer listings')}</strong> · {brands.length} {t('marques','brands')} · {t('Prix et commande vérifiés le','Price and ordering checked on')} {dateLabel((data.offersCheckedAt||data.checkedAt),locale)}.</p><p>{t('Prix France hors livraison · Liens affiliés : vos achats peuvent rémunérer Cadrin.','France prices exclude delivery · Affiliate links: purchases may earn Cadrin a commission.')}</p><details><summary>{t('Ce que les filtres peuvent — et ne peuvent pas — vous dire','What these filters can and cannot tell you')}</summary><p>{t('Prix France en euros, hors livraison, susceptibles de changer. Les références, photos et critères viennent du catalogue Tempus ; toutes ces montres n’ont pas fait l’objet d’une analyse Cadrin. Nos liens sont affiliés : un achat peut nous rapporter une commission.','France prices in euros exclude delivery and may change. References, photographs and filters come from the Tempus catalogue; these watches have not all been analysed by Cadrin. Our links are affiliate links: a purchase may earn us a commission.')}</p><p>{t('Précommande et sur commande reprennent les indications du marchand. L’absence de ces mentions ne garantit pas un stock physique. Les catégories homme, femme et enfant sont celles explicitement renseignées : une catégorie manquante n’est pas déduite de la taille ou du style. Les filtres de commande excluent les liens d’achat suspendus. Les mouvements non renseignés restent inconnus. Confirmez la référence livrée, le délai et le prix final auprès de Tempus.','Preorder and to-order labels follow the retailer’s data. Their absence does not guarantee physical stock. Men’s, women’s and children’s categories are only used when explicitly supplied; missing categories are not inferred from size or style. Ordering filters exclude paused purchase links. Unspecified movements stay unknown. Confirm the supplied reference, lead time and final price with Tempus.')}</p></details></div>
 <nav class="catalogue-shortcuts" aria-label={t('Pour commencer','Starting points')}><a href={root+'?collection=best#catalogue-count'}>{t('Best-sellers Tempus','Tempus bestsellers')}</a><a href={root+'?dial=Bleu#catalogue-count'}>{t('Cadrans bleus','Blue dials')}</a><a href={root+'?budget=150#catalogue-count'}>{t('Moins de 150 €','Up to €150')}</a><a href={root+'?budget=500&movement=Automatique#catalogue-count'}>{t('Automatiques jusqu’à 500 €','Automatics up to €500')}</a><a href={root+'?movement=Solaire#catalogue-count'}>{t('Recharge solaire','Solar powered')}</a><a href={root+'?category=Femme#catalogue-count'}>{t('Catégorie femme','Women’s category')}</a><a href={localPath('/guides/offrir-une-montre/',locale)}>{t('Pour un cadeau : le guide','Buying a gift: the guide')} →</a></nav>
 <form id="catalogue-filters" aria-disabled="true" aria-label={t('Filtrer le catalogue','Filter the catalogue')}>
 <label class="catalogue-search">{t('Marque, nom ou référence','Brand, name or reference')}<input disabled name="q" type="search" maxlength="100" placeholder="Seiko, Tsuyosa, H70455533…"/></label>
 <label>{t('Marque','Brand')}<select disabled name="brand"><option value="">{t('Toutes les marques','All brands')}</option>{brands.map(b=><option value={b}>{b}</option>)}</select></label>
 <label>{t('Pour qui','Who for')}<select disabled name="category"><option value="">{t('Homme, femme et mixte','Men, women and unisex')}</option>{['Femme','Homme','Enfant'].filter(c=>data.products.some(p=>p.category===c)).map(c=><option value={c}>{c==='Enfant'?t('Enfant','Children'):term(c,locale)} · {data.products.filter(p=>p.category===c).length}</option>)}</select></label>
 <label>{t('Budget maximum','Maximum budget')}<select disabled name="budget"><option value="">{t('Sans plafond','No maximum')}</option>{[50,100,150,300,350,400,500,1000,2000,5000].map(n=><option value={n}>{n} €</option>)}</select></label>
 <label>{t('Couleur du cadran','Dial colour')}<select disabled name="dial"><option value="">{t('Toutes les couleurs','All colours')}</option>{dialColours.map(c=><option value={c}>{term(c,locale)} · {data.products.filter(p=>p.dialColors?.includes(c)).length}</option>)}</select></label>
 <label>{t('Bracelet','Strap / bracelet')}<select disabled name="strap"><option value="">{t('Toutes les matières','All materials')}</option>{['Acier','Cuir','Titane','Résine / caoutchouc','Textile'].map(c=><option value={c}>{term(c,locale)}</option>)}</select></label>
 <details class="catalogue-advanced"><summary>{t('Plus de critères : dimensions, étanchéité, fonctions','More filters: size, water resistance, functions')}</summary><div>
 <label>{t('Mouvement indiqué','Listed movement')}<select disabled name="movement"><option value="">{t('Tous / non renseigné','All / unspecified')}</option>{['Automatique','Quartz','Solaire','Manuel','Connectée'].map(m=><option value={m}>{m==='Manuel'?t('Remontage manuel','Hand-wound'):term(m,locale)}</option>)}</select></label>
 <label>{t('Dimension maximale','Maximum case size')}<select disabled name="size"><option value="">{t('Toutes les dimensions','All sizes')}</option>{[30,36,38,40,42,45].map(n=><option value={n}>{n} mm</option>)}</select></label>
 <label>{t('Marquage minimal','Minimum marking')}<select disabled name="water" aria-describedby="water-filter-help"><option value="">{t('Sans préférence','Any')}</option>{[5,10,20].map(n=><option value={n}>≥ {n} bar / ATM</option>)}</select></label>
 <label>{t('Sélection Tempus','Tempus collection')}<select disabled name="collection"><option value="">{t('Tout le catalogue','Whole catalogue')}</option><option value="best">{t('Best-sellers Tempus','Tempus bestsellers')}</option></select></label>
 <label>{t('Fonction recherchée','Function')}<select disabled name="feature"><option value="">{t('Sans préférence','Any')}</option>{['Chronographe','Date','GMT','GPS','Bluetooth','Alarme'].map(f=><option value={f}>{term(f,locale)}</option>)}</select></label>
 <label>{t('Commande','Ordering')}<select disabled name="order"><option value="">{t('Toutes les fiches','All listings')}</option><option value="open">{t('Commande ouverte, délai à vérifier','Ordering open; check lead time')}</option><option value="preorder">{t('Précommande indiquée','Listed as preorder')}</option><option value="order">{t('Sur commande indiqué','Listed as to order')}</option><option value="unflagged">{t('Sans ces mentions, commande ouverte','No such flags, ordering open')}</option></select></label>
</div><p id="water-filter-help" class="catalogue-filter-help">{t('Marquage explicite uniquement ; ce filtre ne garantit pas un usage aquatique.','Explicit markings only; this filter does not guarantee suitability for water activities.')} <a href={localPath('/guides/etancheite-montre-3-5-10-20-atm/',locale)}>{t('Comprendre les niveaux →','Understand the levels →')}</a></p></details><p class="catalogue-filter-help">{t('Couleurs et caractéristiques indiquées par Tempus. Les modèles sans information sont exclus du filtre concerné : Tempus ne précise pas homme ou femme pour la plupart des montres, souvent mixtes. Pour un petit poignet, filtrez aussi par dimension.','Colours and specifications listed by Tempus. Models with missing data are excluded by that filter: Tempus does not say men or women for most watches, many of which are unisex. For a small wrist, also filter by case size.')}</p><button disabled type="submit" class="button catalogue-show-results">{t('Afficher les résultats','Show results')} ↓</button><button disabled type="reset">{t('Tout effacer','Clear all')}</button></form>
 <noscript><style is:inline>#catalogue-filters{display:none!important}</style><p class="catalogue-notice">{t('Sans JavaScript, utilisez les pages ci-dessous pour parcourir tout le catalogue. Les filtres des liens rapides ne s’appliquent pas, mais les photos et les liens marchands restent accessibles.','Without JavaScript, browse the complete catalogue using the pages below. Shortcut filters do not apply, but photographs and retailer links remain available.')}</p></noscript>
 <details class="catalogue-provenance"><summary>{t('À propos des best-sellers et des dimensions','About bestsellers and dimensions')}</summary><p>{t('Les best-sellers reprennent la collection de notre partenaire, relevée le ','Bestsellers follow our partner’s collection, checked on ')}{dateLabel(data.bestSellers.checkedAt,locale)}. {t('Il ne s’agit pas d’un classement de ventes chiffré. La dimension est celle de la fiche Tempus ; les formats rectangulaires à plusieurs mesures restent hors du filtre numérique. Les couleurs sont regroupées par famille : bleu nuit et bleu clair sont tous deux dans « Bleu ». Sans tableau technique, seule une couleur explicitement attachée au cadran est retenue. Une fonction mentionnée dans une comparaison ou dans l’histoire d’un modèle ne suffit pas à activer un filtre.','This is not a ranking based on disclosed sales figures. Case size comes from the Tempus listing; rectangular formats with several dimensions are excluded from the numerical filter. Colours are grouped into families: navy and light blue both appear under Blue. Without a technical table, only a colour explicitly describing the dial is retained. A function mentioned in a comparison or in a model’s history does not qualify for a filter.')} <a href={data.bestSellers.source}>{t('La collection Tempus ↗','Tempus collection ↗')}</a></p></details>
 <div id="catalogue-active" class="catalogue-active" aria-label={t('Critères actifs','Active filters')}></div>
 <p id="catalogue-error" hidden role="status"></p>
 <div class="catalogue-results"><p id="catalogue-count" role="status">{data.products.length} {t('fiches · page','listings · page')} {page}/{pages}</p><button type="button" id="catalogue-share" hidden>{t('Copier ma recherche','Copy this search')}</button><span id="catalogue-share-status" role="status"></span><a href="#catalogue-comparison" id="catalogue-compare-jump" hidden>{t('Voir ma comparaison','View my comparison')}</a>
 <div class="catalogue-tools" data-catalogue-tools hidden><a class="catalogue-edit-filters" href="#catalogue-filters">{t('Modifier mes critères','Edit my filters')} ↑</a> <label class="catalogue-sort">{t('Trier par','Sort by')}<select disabled name="sort" form="catalogue-filters"><option value="">{t('Best-sellers Tempus d’abord','Tempus bestsellers first')}</option><option value="brand">{t('Marque et modèle','Brand and model')}</option><option value="size">{t('Dimension croissante','Case size: small to large')}</option><option value="price">{t('Prix croissant','Price: low to high')}</option><option value="price-desc">{t('Prix décroissant','Price: high to low')}</option></select></label></div></div>
 <nav id="catalogue-pagination-top" class="catalogue-pagination-top" aria-label={t('Changer de page, avant les résultats','Change page, above results')}>
 {page>1&&<a href={pageUrl(page-1)}>{t('← Précédente','← Previous')}</a>}<span>{t('Page','Page')} {page} / {pages}</span>{page<pages&&<a href={pageUrl(page+1)}>{t('Suivante →','Next →')}</a>}
 </nav>
 <div id="catalogue-cards" class="catalogue-grid">{products.map(p=><CatalogueCard product={p}/>)}</div>
 <section id="catalogue-empty" hidden aria-labelledby="catalogue-empty-title"><h2 id="catalogue-empty-title">{t('Aucune montre avec ces critères.','No watches match these filters.')}</h2><p>{t('Aucun modèle ne correspond. Retirez un critère ou effacez les filtres pour élargir votre recherche.','No matching models. Remove a criterion or clear filters to broaden your search.')}</p><div id="catalogue-recovery"></div></section>
 <nav id="catalogue-pagination" class="catalogue-pagination" aria-label={t('Pages du catalogue','Catalogue pages')}>{page>1&&<a href={pageUrl(page-1)}>{t('← Précédente','← Previous')}</a>}{Array.from({length:pages},(_,i)=>i+1).filter(n=>n===1||n===pages||Math.abs(n-page)<=2).map(n=><a href={pageUrl(n)} aria-current={n===page?'page':undefined}>{n}</a>)}{page<pages&&<a href={pageUrl(page+1)}>{t('Suivante →','Next →')}</a>}</nav>
 <section id="catalogue-comparison" hidden tabindex="-1"><span id="comparaison" aria-hidden="true"></span><h2>{t('Vos montres, côte à côte.','Your watches, side by side.')}</h2><p>{t('Jusqu’à trois modèles. Les comparaisons restent affichées lorsque vous changez les filtres.','Up to three models. Your comparison stays in place when you change filters.')}</p><p id="comparison-summary" role="status"></p><div class="comparison-tools"><label id="comparison-differences-control" hidden><input id="comparison-differences" type="checkbox"/>{t('Afficher seulement les différences','Show differences only')}</label><button type="button" id="comparison-share">{t('Partager ces montres','Share these watches')}</button><button type="button" id="comparison-clear">{t('Vider la comparaison','Clear comparison')}</button></div><p id="comparison-share-status" role="status"></p><div id="comparison-share-fallback" hidden><label for="comparison-share-url">{t('Copier ce lien de comparaison','Copy this comparison link')}</label><input id="comparison-share-url" readonly type="url"/></div>
 <section id="comparison-insights" hidden aria-labelledby="comparison-insights-title"><div class="comparison-insights-heading"><h3 id="comparison-insights-title">{t('Pour trancher','What could decide it')}</h3><a href="#comparison-details-title">{t('Voir toutes les caractéristiques','See all specifications')} ↓</a></div><div id="comparison-insights-cards"></div></section>
 <h3 id="comparison-details-title" tabindex="-1">{t('Toutes les caractéristiques','All specifications')}</h3><p class="small-note">{t('Sur mobile, faites défiler le tableau horizontalement. Photos non représentées à la même échelle.','On mobile, scroll the table horizontally. Photos are not shown to the same scale.')}</p><div class="table-scroll" role="region" tabindex="0" aria-label={t('Comparaison des fiches Tempus','Compare Tempus listings')}><table id="catalogue-comparison-table"></table></div></section>
 <MerchantAvailabilityNote/><TempusOffer/><section class="catalogue-next"><h2>{t('La liste se précise. Le choix aussi.','A shorter list. A clearer choice.')}</h2><p>{t('Avant de trancher, vérifiez le format, les habitudes de remontage et les possibilités de retour. Un bon choix reste celui que vous aurez plaisir à porter.','Before deciding, check size, winding routines and return conditions. The right choice is still the watch you will enjoy wearing.')}</p><a class="button" href={localPath('/guides/choisir-premiere-montre/',locale)}>{t('Choisir sa première montre →','Choose your first watch →')}</a></section>
 </div>
</Cadrin>
<script src="../scripts/catalogue.ts"></script>
