---
import TempusOffer from './TempusOffer.astro';
import Cadrin from '../layouts/Cadrin.astro';
import CatalogueCard from './CatalogueCard.astro';
import data from '../data/tempus-catalogue.json';
import {localeOf,textFor,localPath,term} from '../lib/i18n';
import {dateLabel} from '../lib/editorial';
import '../styles/catalogue.css';
const {page=1}=Astro.props as {page?:number};
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const root=localPath('/catalogue/',locale),pages=Math.ceil(data.products.length/data.pageSize);
const pageUrl=(p:number)=>root+(p>1?`${p}/`:'');
const products=data.products.slice((page-1)*data.pageSize,page*data.pageSize);
const brands=[...new Set(data.products.map(p=>p.brand))].sort();
---
<Cadrin title={`${t('Explorer les montres chez Tempus','Explore watches at Tempus')}${page>1?` · ${page}`:''}`} description={t('Cherchez une référence précise ou explorez les montres Tempus par marque, budget et mouvement. Photos réelles, relevés datés et liens directs vers les produits.','Find a reference or browse Tempus watches by brand, budget and movement. Real product images, dated observations and direct product links.')} crumbs={[{name:t('Catalogue Tempus','Tempus catalogue'),url:root}]}>
 <div class="container catalogue" data-catalogue data-page={page} data-root={root}>
 <nav class="breadcrumb" aria-label={t('Fil d’Ariane','Breadcrumb')}><a href={localPath('/',locale)}>{t('Accueil','Home')}</a><span>/</span><span>{t('Catalogue Tempus','Tempus catalogue')}</span></nav>
 <header class="catalogue-heading"><div><span class="eyebrow">{t('Le choix, en plus grand','A wider field of choice')}</span><h1>{t('La vôtre est peut-être ici.','Yours might be here.')}</h1></div><div><p>{t('Partez d’une marque ou d’un budget. Trouvez votre référence chez Tempus et comparez vos trois favorites.','Start with a brand or a budget. Find your reference at Tempus and compare your three favourites.')}</p><a class="text-link" href={localPath('/trouver-ma-montre/',locale)}>{t('Les modèles analysés par Cadrin →','Watches analysed by Cadrin →')}</a></div></header>
 <div class="catalogue-context"><p><strong>{data.products.length.toLocaleString(en?'en-GB':'fr-FR')} {t('fiches marchandes','retailer listings')}</strong> · {brands.length} {t('marques','brands')} · {t('Relevé du','Checked on')} {dateLabel(data.checkedAt,locale)}.</p><p>{t('Prix en euros, hors livraison, susceptibles de changer. Les références, photos et critères viennent du catalogue Tempus ; toutes ces montres n’ont pas fait l’objet d’une analyse Cadrin. Nos liens sont affiliés : un achat peut nous rapporter une commission.','Euro prices exclude delivery and may change. References, photographs and filters come from the Tempus catalogue; these watches have not all been analysed by Cadrin. Our links are affiliate links: a purchase may earn us a commission.')}</p><details><summary>{t('Ce que les filtres peuvent — et ne peuvent pas — vous dire','What these filters can and cannot tell you')}</summary><p>{t('Précommande et sur commande reprennent les indications du marchand. L’absence de ces mentions ne garantit pas un stock physique. Les catégories homme, femme et enfant sont celles explicitement renseignées : une catégorie manquante n’est pas déduite de la taille ou du style. Les mouvements non renseignés restent inconnus. Confirmez la référence livrée, le délai et le prix final auprès de Tempus.','Preorder and to-order labels follow the retailer’s data. Their absence does not guarantee physical stock. Men’s, women’s and children’s categories are only used when explicitly supplied; missing categories are not inferred from size or style. Unspecified movements stay unknown. Confirm the supplied reference, lead time and final price with Tempus.')}</p></details></div>
 <nav class="catalogue-shortcuts" aria-label={t('Pour commencer','Starting points')}><a href={root+'?budget=150'}>{t('Moins de 150 €','Up to €150')}</a><a href={root+'?budget=500&movement=Automatique'}>{t('Automatiques jusqu’à 500 €','Automatics up to €500')}</a><a href={root+'?movement=Solaire'}>{t('Recharge solaire','Solar powered')}</a><a href={root+'?category=Femme'}>{t('Catégorie femme','Women’s category')}</a><a href={localPath('/guides/offrir-une-montre/',locale)}>{t('Pour un cadeau : le guide','Buying a gift: the guide')} →</a></nav>
 <form id="catalogue-filters" aria-disabled="true" aria-label={t('Filtrer le catalogue','Filter the catalogue')}>
 <label class="catalogue-search">{t('Marque, nom ou référence','Brand, name or reference')}<input disabled name="q" type="search" maxlength="100" placeholder="Seiko, Tsuyosa, H70455533…"/></label>
 <label>{t('Marque','Brand')}<select disabled name="brand"><option value="">{t('Toutes les marques','All brands')}</option>{brands.map(b=><option value={b}>{b}</option>)}</select></label>
 <label>{t('Budget maximum','Maximum budget')}<select disabled name="budget"><option value="">{t('Sans plafond','No maximum')}</option>{[50,100,150,300,500,1000,2000,5000].map(n=><option value={n}>{n} €</option>)}</select></label>
 <details class="catalogue-advanced"><summary>{t('Affiner : mouvement, catégorie et commande','Refine: movement, category and ordering')}</summary><div>
 <label>{t('Mouvement indiqué','Listed movement')}<select disabled name="movement"><option value="">{t('Tous / non renseigné','All / unspecified')}</option>{['Automatique','Quartz','Solaire','Manuel'].map(m=><option value={m}>{m==='Manuel'?t('Remontage manuel','Hand-wound'):term(m,locale)}</option>)}</select></label>
 <label>{t('Catégorie renseignée','Listed category')}<select disabled name="category"><option value="">{t('Toutes / non renseignée','All / unspecified')}</option>{['Femme','Homme','Enfant'].map(c=><option value={c}>{c==='Enfant'?t('Enfant','Children'):term(c,locale)}</option>)}</select></label>
 <label>{t('Commande','Ordering')}<select disabled name="order"><option value="">{t('Toutes les fiches','All listings')}</option><option value="preorder">{t('Précommande indiquée','Listed as preorder')}</option><option value="order">{t('Sur commande indiqué','Listed as to order')}</option><option value="unflagged">{t('Sans ces mentions, commande ouverte','No such flags, ordering open')}</option></select></label>
 <label>{t('Trier par','Sort by')}<select disabled name="sort"><option value="">{t('Marque et modèle','Brand and model')}</option><option value="price">{t('Prix croissant','Price: low to high')}</option><option value="price-desc">{t('Prix décroissant','Price: high to low')}</option></select></label></div></details><button disabled type="reset">{t('Tout effacer','Clear all')}</button></form>
 <noscript><style is:inline>#catalogue-filters{display:none!important}</style><p class="catalogue-notice">{t('Sans JavaScript, utilisez les pages ci-dessous pour parcourir tout le catalogue. Les filtres des liens rapides ne s’appliquent pas, mais les photos et les liens marchands restent accessibles.','Without JavaScript, browse the complete catalogue using the pages below. Shortcut filters do not apply, but photographs and retailer links remain available.')}</p></noscript>
 <p id="catalogue-error" hidden role="status"></p>
 <div class="catalogue-results"><p id="catalogue-count" role="status">{data.products.length} {t('fiches · page','listings · page')} {page}/{pages}</p><a href="#catalogue-comparison" id="catalogue-compare-jump" hidden>{t('Voir ma comparaison','View my comparison')}</a></div>
 <div id="catalogue-cards" class="catalogue-grid">{products.map(p=><CatalogueCard product={p}/>)}</div>
 <p id="catalogue-empty" hidden>{t('Aucun modèle ne correspond. Retirez un critère ou effacez les filtres pour élargir votre recherche.','No matching models. Remove a criterion or clear filters to broaden your search.')}</p>
 <nav id="catalogue-pagination" class="catalogue-pagination" aria-label={t('Pages du catalogue','Catalogue pages')}>{page>1&&<a href={pageUrl(page-1)}>{t('← Précédente','← Previous')}</a>}{Array.from({length:pages},(_,i)=>i+1).filter(n=>n===1||n===pages||Math.abs(n-page)<=2).map(n=><a href={pageUrl(n)} aria-current={n===page?'page':undefined}>{n}</a>)}{page<pages&&<a href={pageUrl(page+1)}>{t('Suivante →','Next →')}</a>}</nav>
 <section id="catalogue-comparison" hidden tabindex="-1"><h2>{t('Vos montres, côte à côte.','Your watches, side by side.')}</h2><p>{t('Jusqu’à trois modèles. Les comparaisons restent affichées lorsque vous changez les filtres.','Up to three models. Your comparison stays in place when you change filters.')}</p><div class="table-scroll" role="region" tabindex="0" aria-label={t('Comparaison des fiches Tempus','Compare Tempus listings')}><table id="catalogue-comparison-table"></table></div></section>
 <TempusOffer/><section class="catalogue-next"><h2>{t('La liste se précise. Le choix aussi.','A shorter list. A clearer choice.')}</h2><p>{t('Avant de trancher, vérifiez le format, les habitudes de remontage et les possibilités de retour. Un bon choix reste celui que vous aurez plaisir à porter.','Before deciding, check size, winding routines and return conditions. The right choice is still the watch you will enjoy wearing.')}</p><a class="button" href={localPath('/guides/choisir-premiere-montre/',locale)}>{t('Choisir sa première montre →','Choose your first watch →')}</a></section>
 </div>
</Cadrin>
<script src="../scripts/catalogue.ts"></script>
