---
import {localeOf,localPath,routePairs} from '../lib/i18n';
const locale=localeOf(Astro.url.pathname);
const paired=Object.entries(routePairs).some(([fr,en])=>[fr,en].includes(Astro.url.pathname));
const fr=paired?localPath(Astro.url.pathname,'fr'):'/';
const en=paired?localPath(Astro.url.pathname,'en'):'/en/';
---
<div class="language-switch" role="group" aria-label={locale==='en'?'Language':'Langue'}>
 <a data-language="fr" href={fr} lang="fr" hreflang="fr" aria-label="FR — Français" aria-current={locale==='fr'?'true':undefined}>FR</a>
 <span aria-hidden="true">/</span>
 <a data-language="en" href={en} lang="en" hreflang="en" aria-label="EN — English" aria-current={locale==='en'?'true':undefined}>EN</a>
</div>
<aside class="language-suggestion" hidden aria-label="Language suggestion" lang="en">
 <p>Prefer English?</p><a href={en} data-language="en">Read this page in English →</a><button type="button" aria-label="Dismiss language suggestion">×</button>
</aside>
<script>
 const links=document.querySelectorAll<HTMLAnchorElement>('[data-language]');
 const current=document.documentElement.lang;
 const key='cadrin-language';
 let saved:string|null=null;
 try{saved=localStorage.getItem(key)}catch{/* Language links work without storage. */}
 const refreshLanguageLinks=()=>links.forEach(link=>{
   const target=new URL(link.href);
   if(/^\/(?:en\/)?catalogue\//.test(location.pathname))target.pathname=location.pathname.replace(/^\/(?:en\/)?catalogue\//,link.dataset.language==='en'?'/en/catalogue/':'/catalogue/');
   target.search=location.search;
   target.hash=['#catalogue-comparison','#comparaison','#affiliation','#budget','#taille','#mouvement','#usage'].includes(location.hash)?location.hash:'';
   link.href=target.href;
 });
 refreshLanguageLinks();
 document.addEventListener('cadrin:urlchange',refreshLanguageLinks);
 window.addEventListener('popstate',refreshLanguageLinks);
 links.forEach(link=>link.addEventListener('click',()=>{refreshLanguageLinks();try{localStorage.setItem(key,link.dataset.language!)}catch{}}));
 const suggestion=document.querySelector<HTMLElement>('.language-suggestion')!;
 const preferred=(navigator.languages?.[0] || navigator.language || 'fr').split('-')[0];
 // Offer English without overriding an explicit URL, moving focus or changing the cache by visitor.
 if(current==='fr'&&(saved==='en'||(!saved&&preferred!=='fr')))suggestion.hidden=false;
 suggestion.querySelector('button')!.addEventListener('click',()=>{suggestion.hidden=true;try{localStorage.setItem(key,'fr')}catch{}});
</script>
<style>
 .language-switch{display:flex;align-items:center;gap:4px;margin-left:20px;font-size:12px;flex-shrink:0}
 .language-switch a{display:inline-flex;align-items:center;justify-content:center;min-width:34px;min-height:44px;text-decoration:none}
 .language-switch a[aria-current]{text-decoration:underline;text-underline-offset:5px;font-weight:700}
 .language-suggestion{position:fixed;bottom:16px;right:16px;max-width:calc(100vw - 32px);padding:16px 54px 16px 20px;background:var(--paper);color:var(--wine);border:1px solid var(--line);box-shadow:0 3px 20px #0002;z-index:50;font-size:14px}
 .language-suggestion p{font-weight:600}.language-suggestion a{display:inline-flex;align-items:center;min-height:44px}
 .language-suggestion button{position:absolute;right:4px;top:4px;min-width:44px;min-height:44px;font-size:24px;background:none;border:0;color:inherit;cursor:pointer}
 @media(max-width:1100px){.language-switch{margin-left:8px}}
 @media(max-width:700px){.language-switch{order:0;margin-left:auto;margin-right:12px}.language-switch a{min-width:32px}.language-suggestion{bottom:10px;right:10px;max-width:calc(100vw - 20px)}:global(.menu-toggle){order:1}:global(#primary-navigation){order:2}}
</style>
