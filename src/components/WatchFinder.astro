---
import catalogueData from '../data/tempus-catalogue.json';
import {dialColours} from '../lib/tempus-catalogue';
import Cadrin from '../layouts/Cadrin.astro';
import {dateLabel} from '../lib/editorial';
import type {CollectionEntry} from 'astro:content';
import {localeOf,localPath,term,textFor} from '../lib/i18n';
import {englishWatches} from '../data/english-watches';
import InternationalNotice from './InternationalNotice.astro';
import WatchPhoto from './WatchPhoto.astro';
interface Props {models:CollectionEntry<'watches'>[]}
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const {models} = Astro.props;
const money = (n:number) => new Intl.NumberFormat(locale==='en'?'en-GB':'fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:Number.isInteger(n)?0:2}).format(n);
const dialFor=(reference:string)=>catalogueData.products.find(p=>p.reference===reference)?.dialColors?.[0]||'';
const fields = [
  {key:'couleur',label:t('Couleur du cadran','Dial colour'),options:dialColours.filter(c=>models.some(w=>dialFor(w.data.reference)===c)).map(c=>[c,term(c,locale)])},
  {key:'budget',label:t('Budget plafond','Maximum budget'),options:[['50','50 €'],['150','150 €'],['300','300 €'],['350','350 €'],['400','400 €'],['500','500 €']]},
  {key:'mouvement',label:t('Mouvement','Movement'),options:['Automatique','Solaire','Quartz'].map(x=>[x,term(x,locale)])},
  {key:'bracelet',label:t('Bracelet','Strap / bracelet'),options:['Acier','Cuir','Résine'].map(x=>[x,term(x,locale)])},
  {key:'categorie',label:t('Catégorie catalogue','Catalogue category'),options:['Femme','Homme'].map(x=>[x,term(x,locale)])},
  {key:'largeur',label:t('Largeur du boîtier','Case width'),options:[['30',t('Jusqu’à 30 mm','Up to 30 mm')],['39',t('Jusqu’à 39 mm','Up to 39 mm')],['40',t('Jusqu’à 40 mm','Up to 40 mm')]]},
];
const rows = [
  [t('Prix relevé','Recorded price'), (w:typeof models[number])=>w.data.price!=null?money(w.data.price):t('Non renseigné','Not recorded')],
  [t('Date du relevé','Date checked'), (w:typeof models[number])=>w.data.priceCheckedAt?dateLabel(w.data.priceCheckedAt,locale):'—'],
  [t('Mouvement','Movement'),(w:typeof models[number])=>term(w.data.movement,locale)],
  [t('Boîtier','Case'),(w:typeof models[number])=>term(w.data.sizeLabel,locale)],
  [t('Bracelet','Strap / bracelet'),(w:typeof models[number])=>term(w.data.finder!.bracelet,locale)],
  [t('Affichage','Display'),(w:typeof models[number])=>term(w.data.finder!.display,locale)],
  [t('À vérifier','Check before buying'),(w:typeof models[number])=>locale==='en'?englishWatches[w.id].limit:w.data.limit],
] as const;
---
<Cadrin title={t('Trouver ma montre','Find my watch')} description={t('Filtrez les montres documentées par budget, mouvement ou bracelet et comparez vos favorites côte à côte.','Filter documented watches by budget, movement or bracelet, then compare your favourites side by side.')} crumbs={[{name:t('Trouver ma montre','Watch finder'),url:localPath('/trouver-ma-montre/',locale)}]}>
  <div class="container finder">
    <div class="breadcrumb"><a href={localPath('/',locale)}>{t('Accueil','Home')}</a>{t(' / Sélecteur',' / Watch finder')}</div>
    <header class="intro"><div><span class="eyebrow">{t('Le sélecteur Cadrin','The Cadrin watch finder')}</span><h1>{t('Trouver ma montre.','Find my watch.')}</h1></div>
      <p>{t('Partez d’un budget ou d’un bracelet que vous aimez. Gardez jusqu’à trois montres côte à côte pour voir ce qui les distingue.','Start with a budget or a strap you like. Keep up to three watches side by side to see what sets them apart.')}</p>
    </header>
    <InternationalNotice/>
    <nav class="finder-discovery" aria-label={t('Élargir votre recherche','Broaden your search')}><a href={localPath('/catalogue/?collection=best',locale)}>{t('Best-sellers Tempus','Tempus bestsellers')} →</a><a href={localPath('/catalogue/?dial=Bleu',locale)}>{t('Par couleur de cadran','By dial colour')} →</a><a href={localPath('/catalogue/?brand=G-Shock',locale)}>G-Shock →</a><a href={localPath('/catalogue/',locale)}>{t('Tout le catalogue','Full catalogue')} →</a></nav><p class="catalogue-link"><a class="text-link" href={localPath('/catalogue/',locale)}>{t('Vous cherchez une autre référence ? Explorer le catalogue Tempus →','Looking for another reference? Explore the Tempus catalogue →')}</a></p>
    <div class="workspace">
      <aside><form id="criteria" hidden><h2>{t('Vos critères','Your criteria')}</h2>
        <button id="filter-toggle" type="button" aria-controls="filter-options" aria-expanded="false" hidden>{t('Filtrer les montres','Filter watches')}</button>
        <div id="filter-options"><label>{t('Marque ou référence','Brand or reference')}<input name="recherche" type="search" maxlength="80" placeholder={t('Ex. Citizen, SRPE55…','e.g. Citizen, SRPE55…')}/></label>
        {fields.map(f=><label>{f.label}<select name={f.key}><option value="">{t('Sans préférence','Any')}</option>{f.options.map(([v,l])=><option value={v}>{l}</option>)}</select></label>)}
        <button type="reset">{t('Effacer les critères','Clear filters')}</button></div>
      </form></aside>
      <section aria-labelledby="list-title"><noscript><p>{t('Les filtres interactifs nécessitent JavaScript. Toutes les fiches et leur tableau comparatif sont disponibles ci-dessous.','Interactive filters need JavaScript. All watch pages and the full comparison table remain available below.')}</p></noscript><div class="list-head"><h2 id="list-title">{t('Nos six analyses détaillées','Our six detailed analyses')}</h2><output id="matches" aria-live="polite">{models.length}{t(' références',' references')}</output></div>
        <p class="fine">{t('Prix affichés par Tempus Shop à la date indiquée, hors livraison. Les catégories reprennent les libellés documentés des catalogues.','Prices displayed by Tempus Shop on the dates shown, excluding delivery. Categories follow the documented catalogue labels.')}</p>
        <div class="finder-tools" hidden><label for="sort-order">{t('Afficher par','Sort by')} <select id="sort-order"><option value="">{t('Marque','Brand')}</option><option value="prix">{t('Prix croissant','Price: low to high')}</option><option value="largeur">{t('Largeur croissante','Case width: small to large')}</option></select></label><button type="button" id="share-finder">{t('Copier cette recherche','Copy this search')}</button><span id="share-status" role="status"></span><label id="share-fallback" hidden>{t('Lien à copier','Link to copy')}<input type="text" readonly aria-label={t('Adresse de la recherche','Search URL')}/></label></div>
        <div id="models">{models.map(w=><article class="model" data-couleur={dialFor(w.data.reference)} data-id={w.id} data-search={[w.data.brand,w.data.name,w.data.reference].join(' ')} data-budget={w.data.price} data-mouvement={w.data.movement} data-bracelet={w.data.finder!.bracelet} data-categorie={w.data.finder!.category} data-largeur={w.data.size}>
          <div class="model-photo"><WatchPhoto src={w.data.image} reference={w.data.reference} approved={w.data.rights==='approved'}/></div><div class="model-copy">
          <div class="model-line"><div><span class="eyebrow">{w.data.brand}</span><h3><a href={localPath('/montres/'+w.id+'/',locale)}>{w.data.name}</a></h3><small>{w.data.reference}</small></div>
          <div class="quote">{w.data.price!=null && <><strong>{money(w.data.price)}</strong><small>{t('Relevé du ','Recorded on ')}{w.data.priceCheckedAt && dateLabel(w.data.priceCheckedAt,locale)}</small></>}</div></div>
          <p class="spec">{term(w.data.movement,locale)} · {term(w.data.finder!.bracelet,locale)} · {w.data.size===null?t('Largeur à confirmer','Width to be confirmed'):term(w.data.sizeLabel,locale)}</p><p>{locale==='en'?englishWatches[w.id].note:w.data.note}</p>
          <div class="actions"><a class="text-link" href={localPath('/montres/'+w.id+'/',locale)}>{t('Consulter la fiche →','View watch details →')}</a><label class="pick" hidden><input type="checkbox" value={w.id} aria-label={t('Comparer ','Compare ')+w.data.brand+' '+w.data.reference}/>{t(' Comparer',' Compare')}</label></div>
        </div></article>)}</div>
        <div id="no-matches" hidden><h3>{t('Aucun modèle pour ces critères','No watches match these filters')}</h3><p>{t('Vous pouvez retirer un critère ou repartir de toute la sélection.','Remove a filter or start again with the full selection.')}</p><button type="button">{t('Afficher toutes les montres','Show all watches')}</button></div>
        <a class="text-link" id="to-compare" href="#comparaison" hidden>{t('Voir ma comparaison ↓','View my comparison ↓')}</a>
      </section>
    </div>
    <section id="comparaison" tabindex="-1"><h2>{t('Comparer les montres','Compare watches')}</h2><p id="compare-info" role="status">{t('Les caractéristiques des ','Specifications for all ')}{models.length}{t(' modèles, côte à côte.',' models, side by side.')}</p><p class="fine">{t('Une largeur inconnue est exclue des filtres de largeur et placée en fin de tri. Les montres cochées restent dans votre comparaison même si vous changez les filtres.','Unknown widths are excluded by width filters and placed last when sorting. Selected watches stay in your comparison when you change filters.')}</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label={t('Caractéristiques comparées','Specifications comparison')}><table><caption>{t('Les repères de choix','The useful differences')}</caption><thead><tr><th scope="col">{t('Repère','Specification')}</th>{models.map(w=><th scope="col" data-col={w.id}><a href={localPath('/montres/'+w.id+'/',locale)}>{w.data.brand} {w.data.name}<br/>{w.data.reference}</a><button hidden type="button" class="remove" data-remove={w.id} aria-label={t('Retirer ','Remove ')+w.data.reference}>{t('Retirer','Remove')}</button></th>)}</tr></thead>
      <tbody>{rows.map(([label,read])=><tr><th scope="row">{label}</th>{models.map(w=><td data-col={w.id}>{read(w)}</td>)}</tr>)}</tbody></table></div>
    </section>
  </div>
</Cadrin>
<script src="../scripts/finder.ts"></script>
<style>
@media(max-width:500px){.model .model-copy{display:contents}.model .model-photo{grid-column:1;grid-row:1}.model .model-line{grid-column:2;grid-row:1}.model .model-copy>p,.model .model-copy>.actions{grid-column:1/-1}.model .model-copy>.spec{margin:0}.model .model-copy>.actions{margin-top:0}}
.finder-discovery{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.finder-discovery a{border:1px solid var(--line);padding:12px;font-size:13px;min-height:44px;text-decoration:none}.catalogue-link{margin-top:18px}.model{display:grid;grid-template-columns:minmax(120px,180px) minmax(0,1fr);gap:24px}.model-copy{min-width:0}.model-photo :global(figcaption){font-size:10px;margin-top:5px}.model-photo :global(.photo-frame){aspect-ratio:4/5}@media(max-width:500px){.model{grid-template-columns:92px minmax(0,1fr);gap:14px}.model-line{flex-wrap:wrap}.model .quote{text-align:left}.model .quote small{max-width:none}.model h3{font-size:30px}.model .model-photo :global(figcaption){overflow-wrap:anywhere}}
.finder-tools{display:flex;flex-wrap:wrap;gap:12px 18px;align-items:center;margin:18px 0}.finder-tools label{font-size:.85rem;display:flex;align-items:center;gap:10px}.finder-tools select{width:auto;max-width:100%}.finder-tools button{background:none;border:1px solid var(--line);padding:10px 14px;min-height:44px}.finder-tools #share-status{font-size:.85rem}.finder-tools #share-fallback{width:100%;display:grid}.finder-tools input{min-width:0;width:100%;padding:10px;font:inherit}.finder-tools:has(#share-status:not(:empty)){align-items:start}@media(max-width:400px){.finder-tools label{flex-wrap:wrap}.finder-tools select{width:100%}}
.finder{padding-bottom:70px}.intro{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:end;padding:20px 0 38px;border-bottom:2px solid var(--wine)}.intro h1{font:500 clamp(54px,6vw,86px)/1 var(--display);margin-top:10px}.intro p{max-width:49ch;font-size:18px}.workspace{display:grid;grid-template-columns:minmax(215px,.8fr) minmax(0,2.5fr);gap:clamp(24px,5vw,78px);margin:32px 0 48px}form{background:var(--sand);padding:22px}form h2,.list-head h2,#comparaison h2{font:500 36px/1.1 var(--display)}form label{display:grid;gap:6px;margin-top:14px;font-weight:600;font-size:.88rem}select,input[type=search]{width:100%;min-height:43px;padding:8px;background:var(--ivory);color:var(--wine);border:1px solid var(--muted);font:inherit}button{cursor:pointer;font:inherit;color:var(--wine)}form button,.remove{border:0;text-decoration:underline;background:none;margin-top:12px;padding:8px 0}.list-head,.model-line,.actions{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.fine,small,#compare-info{color:var(--muted);font-size:.88rem}.fine,#compare-info{margin:10px 0 18px}.model{padding:20px 0;border-top:1px solid var(--line)}.model h3{font:500 clamp(32px,4vw,42px)/1.1 var(--display)}.model h3 a{text-decoration:none}.model small{display:block}.quote{text-align:right}.quote strong{font:500 30px/1 var(--display)}.model p{max-width:64ch}.spec{color:var(--wine);font-weight:600;margin:12px 0 5px}.actions{margin-top:12px;align-items:center;flex-wrap:wrap}.pick{min-height:44px;display:inline-flex;align-items:center;gap:7px;cursor:pointer}.pick input{accent-color:var(--wine);width:18px;height:18px}#comparaison{border-top:2px solid var(--wine);padding-top:22px;scroll-margin-top:16px}table{width:100%;border-collapse:collapse}th,td{min-width:145px;padding:12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}thead{background:var(--sand)}caption{text-align:left;padding:8px}.remove{display:block;font-size:.8rem}.finder [hidden]{display:none!important}#no-matches{padding:22px 0}#no-matches button{padding:8px;margin-top:12px}#to-compare{margin:10px 0}
@media(max-width:740px){.intro,.workspace{grid-template-columns:1fr;gap:16px}.intro{padding:10px 0 24px}.intro p{font-size:16px}.workspace{margin-top:20px}form{padding:12px 15px}form h2{display:none}#filter-toggle{font-weight:600;display:block;width:100%;text-align:left;margin:0;padding:8px 0;text-decoration:none}#filter-toggle::after{content:"+";float:right}#filter-toggle[aria-expanded=true]::after{content:"−"}#filter-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;padding-top:12px}form label:first-of-type{grid-column:1/-1}form label{margin-top:4px}form button{align-self:end;text-align:left}th,td{min-width:125px}.quote small{max-width:14ch}}
</style>
