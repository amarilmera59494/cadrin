---
import {dateLabel} from '../lib/editorial';
import data from '../data/tempus-catalogue.json';
import {localeOf,localPath,textFor,term} from '../lib/i18n';
import '../styles/growth.css';
const {id}=Astro.props as {id:string};
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const supported=['montres-par-budget','offrir-une-montre','g-shock-montre-jeune'].includes(id);
const references=id==='montres-par-budget'?['A158WEA-1EF','AW0102-13AE','NJ0200-50Z']:id==='offrir-une-montre'?['NJ0200-50Z','NJ0200-50L','NJ0150-81E']:['GA-2100-1A1ER','GBD-200-2ER','F-91W-1YEG'];
const models=references.map(r=>data.products.find(p=>p.reference===r)!);
const compare=localPath('/catalogue/?compare='+models.map(p=>p.id).join(',')+'#catalogue-comparison',locale);
---
{supported&&<section id="pour-trancher" class="guide-decision"><h2>{t('Pour trancher sans regret','Making the final choice')}</h2>
 {id==='montres-par-budget'&&<><p>{t('Fixez une somme que vous pouvez dépenser confortablement, livraison comprise. Puis demandez-vous ce que vous voulez vraiment changer : l’affichage, le bracelet, la couleur ou le mouvement. Monter en prix sans répondre à cette question rend le choix plus compliqué.','Set an amount you are comfortable spending, including delivery. Then ask what you actually want to change: display, bracelet, colour or movement. Spending more without answering that question makes choosing harder.')}</p><ul><li>{t('Vous aimez les chiffres et le métal ? Commencez par l’A158. Un budget de 300 € ne vous oblige pas à acheter une automatique.','Like digits and metal? Start with the A158. A €300 budget does not mean you need an automatic.')}</li><li>{t('Vous voulez des aiguilles, du cuir et éviter le remontage ? Regardez l’AW0102 solaire avant de monter en gamme.','Want hands, leather and no winding routine? Look at the solar AW0102 before moving up in price.')}</li><li>{t('Vous cherchez surtout une couleur et le plaisir de la mécanique ? Les Tsuyosa de 37 et 40 mm méritent d’être comparées.','Want colour and the appeal of mechanics? Compare the 37 and 40 mm Tsuyosa models.')}</li></ul></>}
 {id==='offrir-une-montre'&&<><p>{t('Vous hésitez encore entre les couleurs de Tsuyosa ? Comparez les trois références ci-dessous, puis gardez une liste courte en favoris pour y revenir. Pour un autre style, les groupes de montres plus haut ont leur propre lien de comparaison.','Still deciding between Tsuyosa colours? Compare the three references below, then save a shortlist to return to. For another style, the groups above each have their own comparison link.')}</p><p>{t('Le meilleur indice reste une préférence de la personne : une couleur qu’elle choisit souvent, un bracelet qu’elle aime, ou un format qu’elle porte déjà. Si vous n’avez aucun de ces repères, gardez une possibilité d’échange plutôt que de chercher une certitude dans une fiche technique.','The best clue is still one of their preferences: a colour they often choose, a bracelet they enjoy, or a size they already wear. If you have none of those clues, preserve the option to exchange rather than seeking certainty in a specification sheet.')}</p></>}
 {id==='g-shock-montre-jeune'&&<><p>{t('Choisissez la GA-2100 pour sa silhouette octogonale et son affichage mixte. Choisissez une numérique parce que vous aimez lire des chiffres, pas parce qu’elle aurait forcément plus de fonctions utiles. La F-91W propose une direction beaucoup moins coûteuse et plus discrète ; elle n’appartient pas à la gamme G-Shock.','Choose the GA-2100 for its octagonal shape and combined display. Choose digital because you like reading digits, rather than assuming more functions will be useful. The F-91W is a much less expensive, more discreet direction; it is not part of the G-Shock range.')}</p><p>{t('Sur la GA-2100 noire, observez le contraste entre le cadran et les aiguilles. Sur la GBD-200, vérifiez l’intérêt réel des fonctions liées au téléphone. Au relevé, la commande de la GBD-200-2ER est fermée chez Tempus : nous la gardons comme point de comparaison, pas comme promesse de disponibilité.','On the black GA-2100, look at the contrast between the dial and hands. On the GBD-200, consider whether you need the phone-linked functions. At our check, ordering for the GBD-200-2ER was closed at Tempus: it remains a comparison, not a promise of availability.')}</p></>}
 <div class="table-scroll decision-table" role="region" tabindex="0" aria-label={t('Comparer les repères essentiels','Compare the essentials')}><table><caption>{t('Repères Tempus · prix vérifiés le ','Tempus details · prices checked on ')}{dateLabel(data.offersCheckedAt||data.checkedAt,locale)}</caption><thead><tr><th scope="col">{t('Référence','Reference')}</th><th scope="col">{t('Dimension annoncée','Listed size')}</th><th scope="col">{t('Mouvement indiqué','Listed movement')}</th><th scope="col">{t('Prix hors livraison','Price excluding delivery')}</th></tr></thead><tbody>{models.map(p=><tr><th scope="row">{p.reference}</th><td>{p.caseSize||t('Non renseignée','Not listed')}</td><td>{p.movement?term(p.movement,locale):t('Non renseigné','Not listed')}</td><td>{new Intl.NumberFormat(en?'en-GB':'fr-FR',{style:'currency',currency:'EUR'}).format(p.price)}</td></tr>)}</tbody></table></div><a class="text-link" href={compare}>{t('Ouvrir cette comparaison complète','Open this full comparison')} →</a><p><a href={localPath('/trouver-ma-montre/#aide-au-choix',locale)}>{t('J’hésite encore : aidez-moi à choisir','Still unsure? Help me choose')} →</a></p>
</section>}
