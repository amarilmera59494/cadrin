---
// « Notre choix » : la montre que Cadrin recommande en tête d'une sélection ou d'un guide, avec pour qui,
// pourquoi et sa limite. Les règles de choix sont décrites dans src/data/verdicts.ts et sur /notre-methode/.
import data from '../data/tempus-catalogue.json';
import {verdictNotes,verdictPlacements} from '../data/verdicts';
import {reviewFor} from '../data/review-syntheses';
import {affiliateUrl} from '../data/affiliation';
import {dateLabel} from '../lib/editorial';
import {ficheDocumented,ficheHref} from '../lib/fiches';
import {readyToOrder,purchaseLabel,orderLabel,displayTitle,type CatalogueProduct} from '../lib/tempus-catalogue';
interface Props {placement:string;match?:(p:CatalogueProduct)=>boolean;heading?:string}
const {placement,match,heading='Si vous hésitez : nos choix'}=Astro.props;
const products=data.products as CatalogueProduct[];
const wanted=verdictPlacements[placement]??[];
// First candidate that exists, is documented, can be ordered now and meets the page's criteria.
const slots=wanted.map(slot=>{for(const ref of slot.refs){const p=products.find(x=>x.reference===ref);const note=verdictNotes[ref];if(p&&note&&ficheDocumented(p)&&readyToOrder(p)&&(!match||match(p)))return {label:slot.label,p,note,review:reviewFor(ref)};}return null;}).filter((s):s is NonNullable<typeof s>=>!!s);
if(wanted.length&&slots.length<wanted.length)console.warn(`[notre choix] ${placement} : ${wanted.length-slots.length} emplacement(s) sans montre commandable`);
const checkedAt=(data as any).offersCheckedAt||data.checkedAt;
const money=(n:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(n);
const single=slots.length===1&&!slots[0].label;
---
{slots.length>0&&<section class:list={['verdict',{'is-double':slots.length>1}]} aria-labelledby="notre-choix">
 {single?<h2 id="notre-choix"><span>Notre choix&nbsp;:</span> {displayTitle(slots[0].p)}</h2>:<h2 id="notre-choix">{heading}</h2>}
 <div class="verdict-grid">{slots.map(({label,p,note,review})=>{const fiche=ficheHref(p)!,plain=p.order==='check'&&p.orderable;return <article class="verdict-pick" data-reference={p.reference}>
  <a class="verdict-photo" href={fiche} tabindex="-1" aria-hidden="true"><img src={p.image} width={p.width} height={p.height} alt="" loading="eager" decoding="async"/></a>
  <div class="verdict-body">
   {!single&&<h3><span>{label}&nbsp;:</span> {displayTitle(p)}</h3>}
   <p class="verdict-price"><strong>{money(p.price)}</strong><span>Prix France relevé le {dateLabel(checkedAt)}, hors livraison</span></p>
   {!plain&&<p class="verdict-status">{orderLabel(p,false)}</p>}
   <dl>
    <div><dt>Pour qui</dt><dd>{note.for}</dd></div>
    <div><dt>Pourquoi</dt><dd>{note.why}</dd></div>
    <div><dt>Sa limite</dt><dd>{note.limit}</dd></div>
   </dl>
   {review&&<p class="verdict-sources">Tests publiés&nbsp;: {review.sources.map((s,i)=><>{i>0&&' · '}<a href={s.url} rel="nofollow noopener" target="_blank">{s.label} ↗</a></>)}</p>}
   <div class="verdict-actions"><a class="button merchant-button" data-placement="recommendation" data-reference={p.reference} href={affiliateUrl(p.source)} rel="sponsored"><span>{purchaseLabel(p,false)}</span><span aria-hidden="true">↗</span></a><a class="text-link" href={fiche}>Taille, verre et points à vérifier →</a></div>
   <small>Lien affilié : Cadrin peut toucher une commission, sans surcoût pour vous ; elle n’entre pas dans ce choix. Nous n’avons pas porté cette montre. <a href="/notre-methode/#notre-choix">Comment nous choisissons</a></small>
  </div>
 </article>;})}</div>
</section>}
<style>
.verdict{margin:var(--space-4) 0;padding:clamp(20px,3vw,40px);background:#fff;border-top:3px solid var(--wine)}
.verdict h2{font:500 clamp(28px,3.2vw,46px)/1.02 var(--display);text-transform:uppercase;color:var(--wine);margin:0 0 var(--space-3);text-wrap:balance}
.verdict h2 span,.verdict h3 span{color:var(--accent)}
.verdict-grid{display:grid;gap:var(--space-5)}
.is-double .verdict-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}
.verdict-pick{display:grid;grid-template-columns:minmax(0,240px) minmax(0,1fr);gap:var(--space-3) var(--space-4);align-items:start}
.is-double .verdict-pick{grid-template-columns:minmax(0,150px) minmax(0,1fr)}
.verdict-photo{display:block}.verdict-photo img{width:100%;height:clamp(200px,22vw,300px);object-fit:contain;transition:transform 400ms cubic-bezier(.16,1,.3,1)}
.is-double .verdict-photo img{height:200px}
.is-double .verdict dl>div{grid-template-columns:1fr;gap:2px}
.verdict-photo:hover img{transform:translateY(-4px)}
.verdict h3{font:500 24px/1.05 var(--display);text-transform:uppercase;color:var(--wine);margin:0 0 var(--space-1)}
.verdict-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;margin:0}
.verdict-price strong{font:500 34px/1 var(--display);color:var(--ink);font-variant-numeric:tabular-nums}
.verdict-price span{font-size:12px;color:var(--muted)}
.verdict-status{margin:6px 0 0;font-size:13px;font-weight:600;color:var(--accent)}
.verdict dl{margin:var(--space-2) 0 0;display:grid;gap:10px}
.verdict dl>div{display:grid;grid-template-columns:7.5em minmax(0,1fr);gap:12px;padding-top:10px;border-top:1px solid var(--line)}
.verdict dt{font-size:13px;font-weight:650;color:var(--accent)}
.verdict dd{margin:0;font-size:15px;line-height:1.6;max-width:62ch}
.verdict-sources{margin:var(--space-2) 0 0;font-size:13px;line-height:1.6;color:var(--muted);max-width:none}
.verdict-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;margin-top:var(--space-3)}
.verdict-actions .merchant-button{width:auto;min-width:240px}
.verdict small{display:block;margin-top:10px;font-size:12px;line-height:1.55;color:var(--muted);max-width:70ch}
@media(max-width:1000px){.is-double .verdict-grid{grid-template-columns:1fr}}
@media(max-width:700px){
 .verdict{margin-inline:calc(var(--gutter)*-1);padding:20px var(--gutter)}
 .verdict-pick,.is-double .verdict-pick{grid-template-columns:1fr;gap:var(--space-2)}
 .verdict-photo img,.is-double .verdict-photo img{height:200px}
 .verdict dl>div{grid-template-columns:1fr;gap:2px}
 .verdict-actions .merchant-button{width:100%;min-width:0}
}
@media(prefers-reduced-motion:reduce){.verdict-photo img{transition:none}}
</style>
