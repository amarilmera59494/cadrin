---
import MeasurementChoice from './MeasurementChoice.astro';
import {localeOf,localPath,textFor} from '../lib/i18n';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
import Wordmark from './Wordmark.astro';
import {launch} from '../data/launch';
import { production } from '../lib/editorial';
---
<footer class="c-footer"><div class="container"><div class="footer-main"><div><Wordmark footer/></div><nav aria-label={t('Navigation de pied de page','Footer navigation')}><a href={localPath('/mes-favoris/',locale)}>{t('Mes favoris','Saved watches')} (<span data-saved-count>0</span>)</a><a href={localPath('/marques/',locale)}>{t('Les marques','Watch brands')}</a>{locale==='fr'&&<a href='/baisses-de-prix/'>Les baisses de prix</a>}<a href={localPath('/comparatifs/',locale)}>{t('Les comparatifs','Comparisons')}</a><a href={localPath('/vues-sur-nos-reseaux/',locale)}>{t('Vues sur nos réseaux','Seen on our socials')}</a><a href={localPath('/analyses/',locale)}>{t('Nos analyses','Our analyses')}</a><a href={localPath('/catalogue/',locale)}>{t('Catalogue Tempus','Tempus catalogue')}</a><a href={localPath('/selections/',locale)}>{t('Explorer les sélections','Explore the selections')}</a><a href={localPath('/guides/',locale)}>{t('Les guides','Guides')}</a><a href={localPath('/notre-methode/',locale)}>{t('Notre méthode','Our method')}</a><a href={localPath('/notre-methode/#affiliation',locale)}>{t('Affiliation & transparence','Affiliate disclosure')}</a><a href={localPath('/contact/',locale)}>{t('Nous écrire','Contact us')}</a>{(!production||launch.legalPagesApproved)&&<><a href={localPath('/mentions-legales/',locale)}>{t('Mentions légales','Legal notice')}</a><a href={localPath('/confidentialite/',locale)}>{t('Confidentialité','Privacy')}</a></>}</nav><p class="footer-statement">{t('Média horloger en français et en anglais.','Watch guides in French and English.')}</p></div><p id="saved-announcement" class="saved-notice" role="status" aria-live="polite"></p><MeasurementChoice/><div class="footer-bottom"><span>{t('CADRIN · Le sens du porté.','CADRIN · Made for your wrist.')}</span><span>{!production && t('Prévisualisation','Preview')}</span></div></div></footer>

<style>.footer-main nav{display:grid;grid-template-columns:1fr 1fr;column-gap:28px;align-items:center}.footer-main nav a{line-height:1.5;padding-block:8px;min-height:44px}@media(min-width:1001px){.footer-main{grid-template-columns:.8fr 1.6fr .7fr}}@media(max-width:1000px) and (min-width:701px){.footer-main{grid-template-columns:.7fr 1.5fr}}@media(max-width:700px){.footer-main nav{gap:6px 18px}}</style>
