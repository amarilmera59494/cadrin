---
import {localeOf,localPath,textFor} from '../lib/i18n';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
import Wordmark from './Wordmark.astro';
import {launch} from '../data/launch';
import { production } from '../lib/editorial';
---
<footer class="c-footer"><div class="container"><div class="footer-main"><div><Wordmark footer/></div><nav aria-label={t('Navigation de pied de page','Footer navigation')}><a href={localPath('/selections/',locale)}>{t('Explorer les sélections','Explore the selections')}</a><a href={localPath('/guides/',locale)}>{t('Les guides','Guides')}</a><a href={localPath('/notre-methode/',locale)}>{t('Notre méthode','Our method')}</a><a href={localPath('/notre-methode/#affiliation',locale)}>{t('Affiliation & transparence','Affiliate disclosure')}</a><a href={localPath('/contact/',locale)}>{t('Nous écrire','Contact us')}</a>{(!production||launch.legalPagesApproved)&&<><a href={localPath('/mentions-legales/',locale)}>{t('Mentions légales','Legal notice')}</a><a href={localPath('/confidentialite/',locale)}>{t('Confidentialité','Privacy')}</a></>}</nav><p class="footer-statement">{t('Média horloger en français et en anglais.','Watch guides in French and English.')}</p></div><div class="footer-bottom"><span>{t('CADRIN · Le sens du porté.','CADRIN · Made for your wrist.')}</span><span>{!production && t('Prévisualisation','Preview')}</span></div></div></footer>
