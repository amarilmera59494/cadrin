---
// Accueil : temps forts de saison (affichés selon la date du build, reconstruit chaque matin) et portes d'entrée vers
// les sélections, comparatifs, marques et baisses de prix relevées.
import data from '../data/tempus-catalogue.json';
import history from '../data/price-history.json';
import {hubs,brandHubs} from '../data/selection-hubs';
import {autoComparisons} from '../data/auto-comparisons';
import {ficheDocumented} from '../lib/fiches';
import type {CatalogueProduct} from '../lib/tempus-catalogue';
const {part}=Astro.props as {part:'season'|'discover'};
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Paris'}).format(new Date());
const season=[
 today<='2026-11-30'&&{href:'/black-friday/',kicker:'Black Friday · jusqu’au 30 novembre',title:'Remises annoncées, prix relevés',text:'Les remises affichées par Tempus, avec notre propre relevé daté pour repérer celles qui baissent vraiment.'},
 today<='2026-12-24'&&{href:'/noel/',kicker:'Noël',title:'Idées cadeaux montres',text:'Pour lui, pour elle, par budget : des idées avec leurs points à vérifier avant d’offrir.'},
].filter(Boolean) as {href:string;kicker:string;title:string;text:string}[];
const all=(data.products as CatalogueProduct[]).filter(ficheDocumented);
const pick=['montres-automatiques-moins-de-300-euros','idees-cadeaux-homme-moins-de-200-euros','montres-femme','montres-verre-saphir-moins-de-300-euros'];
const cards=pick.map(s=>hubs.find(h=>h.slug===s)!).map(h=>{const m=all.filter(h.match).sort((a,b)=>Number(!!b.bestseller)-Number(!!a.bestseller)||a.price-b.price);return {...h,count:m.length,lead:m[0]};});
const items=(history as any).items as Record<string,[string,number,number][]>;
const drops=Object.values(items).filter(r=>r.length>1&&r.at(-1)![1]<r.at(-2)![1]).length;
---
{part==='season'&&season.length>0&&<section class="container hh-season" aria-label="En ce moment">{season.map(s=><a href={s.href}><span class="eyebrow">{s.kicker}</span><strong>{s.title}</strong><span>{s.text}</span><i aria-hidden="true">→</i></a>)}</section>}
{part==='discover'&&<section class="container section hh" aria-labelledby="hh-title">
 <div class="hh-head"><h2 id="hh-title">Nos sélections</h2><a class="text-link" href="/selections/">Les 12 sélections →</a></div>
 <ul class="hh-cards">{cards.map(c=><li><a href={`/selections/${c.slug}/`}><span class="hh-img">{c.lead&&<img src={c.lead.image} width={c.lead.width} height={c.lead.height} loading="lazy" decoding="async" alt=""/>}</span><span class="eyebrow">{c.kicker}</span><strong>{c.title}</strong><span class="hh-meta">{c.count} montres, prix datés</span></a></li>)}</ul>
 <div class="hh-row">
  <div><h3>Les vraies baisses</h3><p>Chaque matin, nous relevons le prix de {data.products.length.toLocaleString('fr-FR')} montres. {drops>0?`${drops} baisse${drops>1?'s':''} relevée${drops>1?'s':''} au dernier relevé.`:'Seules les baisses mesurées par notre propre relevé y figurent.'}</p><a class="text-link" href="/baisses-de-prix/">Voir les baisses de prix →</a></div>
  <div><h3>A ou B ?</h3><ul>{autoComparisons.slice(0,4).map(c=><li><a href={`/comparatifs/${c.slug}/`}>{c.title}</a></li>)}</ul><a class="text-link" href="/comparatifs/">Tous les comparatifs →</a></div>
  <div><h3>Par marque</h3><ul class="hh-brands">{['citizen','seiko','orient','casio-g-shock'].map(s=><li><a href={`/marques/${s}/`}>{s==='casio-g-shock'?'Casio G-Shock':s.charAt(0).toUpperCase()+s.slice(1)}</a></li>)}{brandHubs.slice(0,2).map(b=><li><a href={`/marques/${b.slug}/`}>{b.kicker}</a></li>)}</ul><a class="text-link" href="/marques/">Toutes les marques →</a></div>
 </div>
</section>}
<style>
.hh-season{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--space-2);padding-top:var(--space-4)}
.hh-season a{position:relative;display:flex;flex-direction:column;gap:6px;padding:var(--space-3) calc(var(--space-3) + 32px) var(--space-3) var(--space-3);background:var(--wine);color:var(--paper);text-decoration:none}
.hh-season a:nth-child(2){background:var(--accent)}
.hh-season .eyebrow{color:var(--sand)}
.hh-season strong{font:500 clamp(26px,2.6vw,34px)/1.05 var(--display);text-transform:uppercase}
.hh-season span:not(.eyebrow){font-size:15px;line-height:1.5;opacity:.92}
.hh-season i{position:absolute;right:var(--space-3);top:50%;transform:translateY(-50%);font:500 30px/1 var(--display);font-style:normal;transition:transform var(--motion)}
.hh-season a:hover i,.hh-season a:focus-visible i{transform:translate(4px,-50%)}
.hh-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-3);flex-wrap:wrap;margin-bottom:var(--space-3)}
.hh-head h2{font:500 clamp(36px,4.4vw,60px)/1 var(--display);text-transform:uppercase;margin:var(--space-1) 0 0}
.hh-cards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3)}
.hh-cards a{display:flex;flex-direction:column;gap:6px;height:100%;color:inherit;text-decoration:none}
.hh-img{display:block;background:#fff;padding:var(--space-2);margin-bottom:var(--space-1)}.hh-img img{width:100%;height:190px;object-fit:contain;transition:transform var(--motion)}
.hh-cards a:hover img,.hh-cards a:focus-visible img{transform:scale(1.03)}
.hh-cards strong{font:500 24px/1.05 var(--display);text-transform:uppercase}.hh-cards a:hover strong,.hh-cards a:focus-visible strong{text-decoration:underline;text-underline-offset:4px}
.hh-meta{font-size:14px;color:var(--muted)}
.hh-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);margin-top:var(--section);padding-top:var(--space-4);border-top:2px solid var(--wine)}
.hh-row h3{font:500 28px/1.05 var(--display);text-transform:uppercase;margin:0 0 var(--space-2)}
.hh-row p{line-height:1.6;margin:0 0 var(--space-2)}
.hh-row ul{list-style:none;padding:0;margin:0 0 var(--space-2);display:grid;gap:4px}.hh-row li a{display:inline-flex;min-height:36px;align-items:center}
.hh-brands{grid-template-columns:repeat(2,minmax(0,1fr))}
@media(max-width:1000px){.hh-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.hh-row{grid-template-columns:1fr}}
@media(max-width:520px){.hh-img img{height:140px}.hh-cards strong{font-size:20px}}
@media(prefers-reduced-motion:reduce){.hh-img img,.hh-season i{transition:none}}
</style>
