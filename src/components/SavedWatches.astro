---
import Cadrin from '../layouts/Cadrin.astro';
import {localeOf,localPath,textFor} from '../lib/i18n';
import data from '../data/tempus-catalogue.json';
import {dateLabel} from '../lib/editorial';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
---
<Cadrin title={t('Mes favoris et ma liste cadeau','Saved watches and gift list')} description={t('Gardez vos montres préférées, comparez-les et partagez votre liste cadeau, sans créer de compte.','Save watches, compare them and share a gift list without an account.')}>
 <div class="container saved-page" data-saved-page><header class="page-heading"><span class="eyebrow">{t('Le temps de choisir','Time to choose')}</span><h1>{t('Celles qui vous plaisent.','The ones you like.')}</h1><p>{t('Gardez jusqu’à 12 montres, comparez-en trois et partagez votre liste. Aucun compte à créer.','Save up to 12 watches, compare three and share your list. No account needed.')}</p><p class="small-note">{t('Vos favoris restent dans ce navigateur. Le lien partagé contient uniquement les références sélectionnées : toute personne qui le reçoit peut voir la liste.','Saved watches stay in this browser. A shared link contains only the selected references: anyone who receives it can view the list.')}</p></header>
 <noscript><p>{t('Les favoris nécessitent JavaScript pour être enregistrés sur votre appareil. Vous pouvez toujours explorer le catalogue et les guides.','Saving watches on your device needs JavaScript. You can still browse the catalogue and guides.')}</p></noscript>
 <p id="saved-status" role="status">{t('Vos favoris apparaîtront ici.','Your saved watches will appear here.')}</p><div id="saved-controls" class="saved-controls" hidden><button type="button" id="saved-share" class="button">{t('Partager cette liste','Share this list')} ↗</button><button type="button" id="saved-import" hidden>{t('Ajouter la liste à mes favoris','Add this list to my saved watches')}</button><a id="saved-compare" class="text-link" hidden></a><p class="small-note">{t('Cochez deux ou trois montres pour comparer leurs caractéristiques.','Select two or three watches to compare their specifications.')}</p></div><button type="button" id="saved-local" hidden>{t('Retrouver mes favoris personnels','Show my own saved watches')}</button>
 <div id="saved-share-fallback" hidden><label for="saved-link">{t('Le lien à envoyer','Link to share')}</label><input id="saved-link" type="text" readonly/><p class="small-note">{t('Ce lien garde la composition actuelle de la liste. Partagez un nouveau lien après vos modifications.','This link keeps the current list. Share a new link after making changes.')}</p></div>
 <div id="saved-empty" class="saved-empty"><h2>{t('Une envie de bleu ? Une montre à offrir ?','A blue dial? A watch to give?')}</h2><p>{t('Commencez par une montre qui vous attire. Le bouton « Garder en favoris » vous permet de la retrouver ici.','Start with a watch you like. Use “Save watch” to find it here later.')}</p><a class="button" href={localPath('/trouver-ma-montre/',locale)}>{t('Trouver ma montre','Find my watch')} →</a></div><div id="saved-grid" class="saved-grid"></div><p class="small-note">{t('Prix France hors livraison, vérifiés le ','France prices exclude delivery, checked on ')}{dateLabel(data.offersCheckedAt||data.checkedAt,locale)}. {t('Liens affiliés. Vérifiez le prix et le délai chez Tempus avant de commander.','Affiliate links. Check price and delivery at Tempus before ordering.')}</p></div>
</Cadrin>
