---
import Cadrin from '../layouts/Cadrin.astro';
import data from '../data/tempus-catalogue.json';
import {socialPicks} from '../data/social-picks';
import {affiliateUrl} from '../data/affiliation';
import {localeOf,textFor,localPath} from '../lib/i18n';
import {dateLabel} from '../lib/editorial';
import {detailRows,orderLabel} from '../lib/tempus-catalogue';
import '../styles/growth.css';
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
const picks=socialPicks.map(p=>({...p,product:data.products.find(w=>w.reference===p.reference)!}));
if(picks.some(p=>!p.product))throw Error('Social reference missing from catalogue');
const money=(p:number)=>new Intl.NumberFormat(en?'en-GB':'fr-FR',{style:'currency',currency:'EUR'}).format(p);
---
<Cadrin title={t('Les montres vues sur nos réseaux','The watches from our social posts')} description={t('Retrouvez les références de nos vidéos : photos exactes, prix datés, alternatives et liens directs chez notre partenaire Tempus.','Find the exact watches from our videos, with dated prices, alternatives and direct links to our partner Tempus.')}>
 <div class="container social-page"><header class="page-heading"><span class="eyebrow">CADRIN · TikTok & Pinterest</span><h1>{t('Vue en vidéo.<br>Retrouvée ici.','Seen in a video.<br>Found here.').split('<br>').map((s,i)=><>{i>0&&<br/>}{s}</>)}</h1><p>{t('La montre vous a plu ? Retrouvez sa référence exacte, ce qui la distingue et le lien pour l’acheter chez Tempus.','Liked the watch? Find its exact reference, what makes it different and the link to buy it at Tempus.')}</p><p class="small-note">{t('Liens affiliés : vos achats peuvent rémunérer CADRIN. Prix France hors livraison, relevés le ','Affiliate links: your purchase may earn CADRIN a commission. France prices exclude delivery, checked on ')}{dateLabel((data.offersCheckedAt||data.checkedAt),locale)}.</p></header>
 <nav class="social-jumps" aria-label={t('Retrouver une vidéo','Find a video')}>{picks.map(p=><a href={'#'+p.slug}>{p.product.brand} · {p.reference}</a>)}</nav>
 {picks.map(p=><article class="social-pick" id={p.slug} data-reference={p.reference}><div class="social-product"><img src={p.product.image} width={p.product.width} height={p.product.height} loading="lazy" alt={p.product.title}/><small>{t('Photo Tempus · Référence exacte','Tempus photo · Exact reference')}</small></div><div class="social-copy"><span class="eyebrow">{p.product.brand}</span><h2>{en?p.titleEn:p.title}</h2><p class="social-reference">{p.product.title}<br/>{p.reference}</p><p>{en?p.textEn:p.text}</p><p class="social-price">{money(p.product.price)} <small>{t('hors livraison · prix daté ci-dessus','excluding delivery · dated above')}</small></p><p class="small-note">{orderLabel(p.product,en)}</p><a class="button merchant-button" data-placement="social" href={affiliateUrl(p.product.source)} rel="sponsored">{t('Acheter chez Tempus','Buy at Tempus')} ↗</a><small class="affiliate-note">{t('Lien affilié','Affiliate link')}</small><details><summary>{t('Les détails et le point à vérifier','Details and a point to check')}</summary><dl class="facts">{detailRows(p.product,en).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p>{en?p.limitEn:p.limit}</p><p class="small-note">{t('Données Tempus ; aucun essai au poignet réalisé par CADRIN.','Tempus specifications; no hands-on test by CADRIN.')}</p></details><div class="social-actions"><a href={localPath(p.guide,locale)}>{t('Le guide pour comparer','Read the buying guide')} →</a><a href={localPath('/catalogue/?q='+encodeURIComponent(p.reference),locale)}>{t('Comparer avec le catalogue','Compare with the catalogue')} →</a></div><details class="social-video"><summary>{t('Revoir notre vidéo','Watch our video')}</summary><video controls playsinline preload="none" poster={p.poster} width="1080" height="1920" src={p.clip}><track kind="captions" src={p.clip.replace('.mp4','.vtt')} srclang="fr" label="Français"/></video><p><a href={p.video}>{t('Voir la publication TikTok','View the TikTok post')} ↗</a></p>{en&&<p class="small-note">Video and voiceover in French.</p>}</details></div></article>)}
 <section class="social-next"><h2>{t('La même envie, un autre choix ?','A similar feeling, a different choice?')}</h2><p>{t('Un budget plus court, une autre couleur ou un format différent : quelques critères suffisent pour repartir dans la bonne direction.','A smaller budget, another colour or a different size: a few choices help narrow the field.')}</p><a class="button" href={localPath('/trouver-ma-montre/',locale)}>{t('Aidez-moi à choisir','Help me choose')} →</a></section></div>
</Cadrin>
