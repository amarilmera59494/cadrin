---
import type {CollectionEntry} from 'astro:content';
const {watches}=Astro.props as {watches:CollectionEntry<'watches'>[]};
---
<details class="watch-comparison"><summary>Comparer les repères des trois montres <span aria-hidden="true">+</span></summary><p class="small-note">Ce tableau conserve les trois références, quels que soient les filtres. Sur petit écran, faites défiler le tableau horizontalement.</p><div class="table-scroll" tabindex="0" role="region" aria-label="Comparaison des trois références, défilement horizontal"><table><caption>Les différences utiles, sans note ni classement</caption><thead><tr><th scope="col">Repère</th>{watches.map(w=><th scope="col"><a href={`/montres/${w.id}/`}>{w.data.brand}<br/>{w.data.reference}</a></th>)}</tr></thead><tbody><tr><th scope="row">Mouvement</th>{watches.map(w=><td>{w.data.movement}</td>)}</tr><tr><th scope="row">Boîtier</th>{watches.map(w=><td>{w.data.sizeLabel}</td>)}</tr><tr><th scope="row">À envisager pour</th>{watches.map(w=><td>{w.data.note}</td>)}</tr><tr><th scope="row">À vérifier</th>{watches.map(w=><td>{w.data.limit}</td>)}</tr></tbody></table></div></details>
<style>.watch-comparison{margin-top:36px;border-block:1px solid var(--line);padding:10px 0}.watch-comparison summary{cursor:pointer;display:flex;justify-content:space-between;gap:24px;align-items:center;min-height:48px;font-size:15px;font-weight:600;list-style:none}.watch-comparison summary::-webkit-details-marker{display:none}.watch-comparison[open] summary span{transform:rotate(45deg)}.watch-comparison table{min-width:750px;table-layout:fixed}.watch-comparison th:first-child{width:120px}.watch-comparison .table-scroll{margin-bottom:20px}</style>
