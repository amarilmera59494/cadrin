---
import data from '../data/tempus-catalogue.json';
import {recommendationNotes} from '../data/recommendations';
import {localeOf,textFor} from '../lib/i18n';
import '../styles/growth.css';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const products=recommendationNotes.map(n=>{const p=data.products.find(p=>p.reference===n.reference);if(!p)throw Error('Missing recommendation '+n.reference);return {...p,...n};});
---
<section class="guided-choice" id="aide-au-choix" aria-labelledby="guided-title" data-guided-choice data-products={JSON.stringify(products)} data-date={data.checkedAt}>
 <span class="eyebrow">{t('Quelques envies. Trois pistes.','A few preferences. Three directions.')}</span><h2 id="guided-title">{t('Vous hésitez ? Partons de vous.','Not sure? Let’s start with you.')}</h2><p>{t('Choisissez ce qui compte ; laissez le reste ouvert. Nous cherchons parmi dix références commentées, puis vous pouvez élargir à tout le catalogue.','Choose what matters and leave the rest open. We look through ten editorially selected references; you can then explore the full catalogue.')}</p>
 <form id="guided-form" hidden><fieldset class="guided-fields"><legend class="sr-only">{t('Vos préférences','Your preferences')}</legend>
 <label>{t('Votre budget maximum','Your maximum budget')}<select name="budget"><option value="">{t('Je reste ouvert','I am keeping it open')}</option>{[30,50,100,150,300,350,500].map(n=><option value={n}>{n} €</option>)}</select></label>
 <label>{t('L’allure que vous aimez','The look you like')}<select name="style"><option value="">{t('Sans préférence','No preference')}</option><option value="everyday">{t('Pour tous les jours','Everyday')}</option><option value="dress">{t('Habillée','Dressy')}</option><option value="sport">{t('Sportive / G-Shock','Sporty / G-Shock')}</option><option value="retro">{t('Numérique rétro','Retro digital')}</option><option value="jewellery">{t('Montre bijou','Jewellery watch')}</option></select></label>
 <label>{t('Votre rapport au mouvement','Your movement preference')}<select name="habit"><option value="">{t('Pas encore décidé','Not decided yet')}</option><option value="simple">{t('Quartz ou solaire, sans remontage','Quartz or solar, no winding')}</option><option value="mechanical">{t('Le plaisir d’une automatique','An automatic movement')}</option></select></label>
 <label>{t('Dimension maximale souhaitée','Preferred maximum case size')}<select name="size"><option value="">{t('Je ne sais pas encore','I do not know yet')}</option>{[30,38,40,45].map(n=><option value={n}>{n} mm</option>)}</select></label>
 <label>{t('Couleur du cadran','Dial colour')}<select name="dial"><option value="">{t('Toutes les couleurs','Any colour')}</option>{[['Noir','Black'],['Bleu','Blue'],['Rose','Pink'],['Beige','Beige'],['Argenté','Silver']].map(([fr,en])=><option value={fr}>{t(fr,en)}</option>)}</select></label>
 </fieldset><p class="guided-footnote">{t('Le budget n’inclut pas la livraison. Une dimension inconnue ou rectangulaire ne passe pas le filtre numérique. Le confort ne se déduit pas d’un diamètre.','Budget excludes delivery. Unknown or rectangular dimensions do not pass the numeric size filter. Diameter does not determine comfort.')}</p><div class="guided-actions"><button type="submit" class="button">{t('Voir mes pistes','Show my choices')} →</button><button type="reset">{t('Recommencer','Start again')}</button></div></form>
 <noscript><p>{t('Cette aide interactive nécessite JavaScript. Le catalogue, ses pages et les liens vers Tempus restent accessibles ci-dessous. Pour une sélection courte, consultez nos guides budget et cadeau.','This interactive helper needs JavaScript. The catalogue, its pages and Tempus links remain accessible below. For a shortlist, read our budget and gift guides.')}</p></noscript>
 <div id="guided-result" class="guided-result" tabindex="-1" hidden><h3 id="guided-status" class="guided-status" aria-live="polite"></h3><div class="recommendation-grid"></div><div class="guided-cheaper" hidden></div><p class="guided-footnote">{t('Prix France et données Tempus au ','France prices and Tempus data checked on ')}{data.checkedAt.split('-').reverse().join('/')} · {t('Liens affiliés. Pas d’essai au poignet ni de classement par commission.','Affiliate links. No hands-on testing or commission-based ranking.')}</p><a class="text-link" id="guided-explore" href={locale==='en'?'/en/catalogue/':'/catalogue/'}>{t('Élargir au catalogue avec mes critères','Explore the catalogue with my criteria')} →</a><p id="guided-explore-note" class="small-note"></p></div>
</section>
<script>import '../scripts/guided-choice';</script>
