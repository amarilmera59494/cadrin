---
import type {CatalogueProduct} from '../lib/tempus-catalogue';
import {orderLabel} from '../lib/tempus-catalogue';
import {affiliateUrl} from '../data/affiliation';
import {localeOf,term,textFor} from '../lib/i18n';
const {product:p}=Astro.props as {product:CatalogueProduct};
const locale=localeOf(Astro.url.pathname),en=locale==='en',t=textFor(locale);
---
<article class="catalogue-card" data-id={p.id}>
 <a class="catalogue-image" href={affiliateUrl(p.source)} rel="sponsored" aria-label={`${p.title} — ${t('voir chez Tempus, lien affilié','view at Tempus, affiliate link')}`}><img src={p.image} width={p.width} height={p.height} loading="lazy" decoding="async" alt={`${p.title} — ${t('visuel Tempus','Tempus listing image')}`}/></a>
 <div class="catalogue-copy"><p class="eyebrow">{p.brand}</p><h2>{p.title}</h2><p class="catalogue-reference">{t('Réf. marchand : ' ,'Retailer ref: ')}{p.reference}</p><p class="catalogue-spec">{p.movement?term(p.movement,locale):t('Mouvement non renseigné','Movement not specified')}</p>
 <p class="catalogue-price">{new Intl.NumberFormat(en?'en-GB':'fr-FR',{style:'currency',currency:'EUR'}).format(p.price)}</p><p class="catalogue-status">{orderLabel(p,en)}</p>
 <a class="text-link catalogue-cta" href={affiliateUrl(p.source)} rel="sponsored">{t('Voir chez Tempus ↗','View at Tempus ↗')}</a><small>{t('Lien affilié · photo Tempus','Affiliate link · photo: Tempus')}</small>
 <label class="catalogue-pick" hidden><input type="checkbox" value={p.id}/>{t('Comparer','Compare')}</label></div>
</article>
