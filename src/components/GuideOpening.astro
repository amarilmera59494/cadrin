---
import WatchPhoto from './WatchPhoto.astro';
import {productPhotos} from '../data/product-photos';
import {readingFor} from '../data/guide-reading';
import {localeOf,localPath} from '../lib/i18n';
const {id}=Astro.props as {id:string};
const locale=localeOf(Astro.url.pathname);
const copy=readingFor(id,locale);
const model=({'choisir-premiere-montre':'citizen-tsuyosa-nj0150-81e','automatique-quartz-solaire':'citizen-aw0102-13ae','choisir-taille-montre':'orient-bambino-ra-ac0m04y','montres-par-budget':'casio-f91w','offrir-une-montre':'citizen-rainell-em1201-52l','bambino-tsuyosa-seiko-5':'orient-bambino-ra-ac0m04y','citizen-eco-drive-ou-tsuyosa':'citizen-aw0102-13ae','acheter-montre-en-ligne':'citizen-tsuyosa-nj0150-81e'} as Record<string,string>)[id];
const photo=productPhotos[`/images/products/${model}.webp`];
---
<div class="guide-opening">
 <div class="guide-heading"><slot/></div>
 {copy&&photo&&<aside class="guide-image"><WatchPhoto src={photo.src} reference={photo.reference} approved detail/><p>{copy.caption}</p><a class="text-link" href={localPath(`/montres/${model}/`,locale)}>{locale==='en'?'The watch shown':'La montre présentée'} · {photo.reference} →</a></aside>}
</div>
<style>
 .guide-opening{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.85fr);gap:clamp(32px,5vw,80px);align-items:center;margin-bottom:48px}
 .guide-heading{min-width:0}.guide-heading :global(.reading-heading){padding-bottom:0}.guide-heading :global(h1){text-wrap:balance}
 .guide-image{min-width:0}.guide-image :global(picture){aspect-ratio:4/3}.guide-image :global(img){display:block;object-position:50% 57%}
 .guide-image p{font-size:14px;line-height:1.65;margin:14px 0 0;max-width:48ch}.guide-image :global(figcaption){font-size:11px}
 .guide-image :global(.photo-frame){max-height:400px}.guide-image .text-link{font-size:13px;margin-top:10px}
 @media(max-width:800px){.guide-opening{grid-template-columns:1fr;gap:24px;margin-bottom:32px}.guide-image :global(picture){aspect-ratio:16/9}.guide-image p{font-size:13px;max-width:65ch}}
</style>
