---
import {localeOf,term,textFor} from '../lib/i18n';
import {sizeLabel} from '../lib/tempus-catalogue';
const {facts}=Astro.props as {facts:{label:string;value:string}[]};
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const definitions=[{title:t('Le format','Size and shape'),keys:['Diamètre','Dimensions (L × l × H)','Épaisseur','Poids','Dimensions','Longueur du boîtier','Corne à corne']},{title:t('Le mouvement et les fonctions','Movement and functions'),keys:['Mouvement','Calibre','Fonctions','Affichage','Réserve annoncée']},{title:t('Les matières et les détails','Materials and details'),keys:[]}];
const used=definitions.flatMap(d=>d.keys);
---
<div class="spec-groups">{definitions.map(group=>{const rows=facts.filter(f=>group.keys.length?group.keys.includes(f.label):!used.includes(f.label));return rows.length>0&&<section><h3>{group.title}</h3><dl>{rows.map(f=><div><dt>{term(f.label,locale)}</dt><dd>{term(['Diamètre','Épaisseur'].includes(f.label)?sizeLabel(f.value,locale==='en'):f.value,locale)}</dd></div>)}</dl></section>})}</div>
<style>.spec-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:24px 0}.spec-groups>section{margin:0!important;padding:22px!important;background:var(--sand);border:0!important}.spec-groups>section:last-child{grid-column:1/-1}.spec-groups h3{font-size:18px;margin:0 0 16px}.spec-groups dl>div{display:grid;grid-template-columns:1fr 1.2fr;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:14px}.spec-groups dt{color:var(--muted)}.spec-groups dd{margin:0;font-weight:500;overflow-wrap:anywhere}@media(max-width:600px){.spec-groups{grid-template-columns:1fr;gap:14px}.spec-groups>section{padding:18px!important}.spec-groups dl>div{font-size:13px}}</style>
