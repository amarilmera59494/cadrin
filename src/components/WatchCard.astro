---
import type { CollectionEntry } from 'astro:content';
import {localeOf,localPath,term,textFor} from '../lib/i18n';
import {englishWatches} from '../data/english-watches';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
import WatchPhoto from './WatchPhoto.astro';
interface Props { watch: CollectionEntry<'watches'> }
const {watch} = Astro.props;
const p = {...watch.data,...(locale==='en'?englishWatches[watch.id]:{})};
---
<article class="watch-card" data-product-row data-movement={p.movement} data-size={p.size} data-use={p.use}>
  <p class="eyebrow">{p.brand}</p>
  <h3><a href={localPath(`/montres/${watch.id}/`,locale)}>{p.name}</a></h3>
  <WatchPhoto src={p.image} reference={p.reference} approved={p.rights==='approved'}/>
  {p.image && <p class="reference">{p.reference}</p>}
  <p class="watch-note">{p.note}</p>
  <dl class="watch-specs">
    <div><dt>{t('Boîtier','Case')}</dt><dd>{term(p.sizeLabel,locale)}</dd></div>
    <div><dt>{t('Mouvement','Movement')}</dt><dd>{term(p.movement,locale)}</dd></div>
  </dl>
  <a class="text-link" href={localPath(`/montres/${watch.id}/`,locale)} aria-label={`${t('Découvrir la fiche','View watch details for')} ${p.brand} ${p.reference}`}>
    {t('Découvrir la fiche','View watch details')} <span aria-hidden="true">→</span>
  </a>
</article>
<style>
  .watch-card h3 { margin: 6px 0 16px; line-height: 1.12 }
  .watch-note { font-size: 1rem; line-height: 1.6 }
</style>
