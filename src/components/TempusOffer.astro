---
import {localeOf,textFor} from '../lib/i18n';
const t=textFor(localeOf(Astro.url.pathname));
const {compact=false}=Astro.props as {compact?:boolean};
---
<aside class:list={['tempus-offer',{compact}]} aria-label={t('Offre de première commande Tempus','Tempus first-order offer')}>
 <div class="offer-copy"><p><strong>{t('Votre première commande chez Tempus ?','Your first order at Tempus?')}</strong> {t('Obtenez 10 % de réduction avec','Get 10% off with')} <code>WELCOME10</code>.</p>
 <p class="offer-terms">{t('Hors nouveautés et articles déjà remisés. Non cumulable. Vérifiez l’éligibilité et la réduction avant de payer.','Excludes new arrivals and discounted items. Cannot be combined with other offers. Confirm eligibility and the discount before paying.')} <a href="https://tempusshop.com/pages/code-promo">{t('Conditions Tempus ↗','Tempus terms ↗')}</a></p>
 <small>{t('Code public, non exclusif à Cadrin · Annonce vérifiée le 13 novembre 2026.','Public code, not exclusive to Cadrin · Announcement checked on 13 November 2026.')}</small></div>
 <div class="offer-action"><button type="button" data-copy-offer="WELCOME10" data-success={t('Code copié','Code copied')} data-failure={t('Copiez le code WELCOME10 affiché ci-dessus.','Copy WELCOME10 from the text above.')} hidden>{t('Copier le code','Copy the code')}</button><span role="status" aria-live="polite"></span></div>
</aside>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-copy-offer]').forEach(button=>{
 button.hidden=false;
 button.addEventListener('click',async()=>{const status=button.nextElementSibling!;
  try{await navigator.clipboard.writeText(button.dataset.copyOffer!);status.textContent=button.dataset.success!;}catch{status.textContent=button.dataset.failure!;}
 });
});
</script>
<style>
.tempus-offer{display:flex;align-items:center;justify-content:space-between;gap:28px;border:1px solid var(--line);background:var(--paper);padding:22px 26px;margin:24px 0;color:var(--wine)}.offer-copy{min-width:0}.offer-copy>p:first-child{font-size:16px;line-height:1.7}.offer-copy strong{font-weight:600}code{font-family:var(--mono);font-weight:600;letter-spacing:.04em;white-space:nowrap}.offer-terms{font-size:12px;line-height:1.7;margin-top:6px;max-width:100ch}.offer-copy small{display:block;font-size:11px;color:var(--muted);margin-top:6px;line-height:1.7}.offer-action{flex-shrink:0;max-width:200px}.offer-action button{min-height:44px;background:var(--wine);color:var(--paper);border:0;padding:10px 16px;font:inherit;font-size:13px;cursor:pointer}.offer-action span{display:block;font-size:12px;line-height:1.6;max-width:24ch}.offer-action span:not(:empty){margin-top:8px}.offer-action button:focus-visible{outline-color:var(--accent)}.compact{display:block;padding:16px;margin:20px 0}.compact .offer-copy>p:first-child{font-size:14px}.compact .offer-action{margin-top:10px}.compact .offer-terms{font-size:12px}@media(max-width:700px){.tempus-offer{display:block;padding:18px}.offer-copy>p:first-child{font-size:14px}.offer-action{margin-top:12px}.offer-terms{font-size:12px}.offer-copy small{font-size:11px}}
</style>
