---
import {catalogue} from '../lib/editorial';
import {localeOf,localPath,textFor} from '../lib/i18n';
import {englishGuides} from '../data/english-guides';
import Photo from './Photo.astro';
const locale=localeOf(Astro.url.pathname),t=textFor(locale);
const {guides}=await catalogue();
const shortcuts=[['choisir-premiere-montre',t('Commencer','Start here')],['montres-par-budget',t('Mon budget','My budget')],['automatique-quartz-solaire',t('Le mouvement','The movement')],['choisir-taille-montre',t('Les proportions','Size and fit')],['offrir-une-montre',t('Offrir','A gift')]];
---
<header class="page-heading"><h1>{t('Les guides Cadrin.','The Cadrin guides.')}</h1><p>{t('Un premier achat, un cadeau ou deux modèles entre lesquels vous hésitez. Partez de votre question : le guide vous aide à faire le tri, puis vous renvoie aux références documentées.','A first purchase, a gift or two watches you cannot decide between. Start with your question: each guide helps narrow the choice and leads to the documented references.')}</p></header>
{guides.length>0&&<nav class="guide-shortcuts" aria-label={t('Choisir un guide','Choose a guide')}>{shortcuts.filter(([id])=>guides.some(g=>g.id===id)).map(([id,label])=><a href={localPath(`/guides/${id}/`,locale)}>{label} <span aria-hidden="true">↗</span></a>)}</nav>}
{guides.map(g=>{const copy=locale==='en'?englishGuides[g.id]:g.data;return <section class="guide-index-item"><div>{g.data.image&&<Photo name={g.data.image} sizes="(max-width:700px) 100vw, 36vw"/>}</div><div><h2><a href={localPath(`/guides/${g.id}/`,locale)}>{copy.title}</a></h2><p>{copy.description}</p><a class="text-link" href={localPath(`/guides/${g.id}/`,locale)}>{t('Lire le guide','Read the guide')} →</a></div></section>})}
{!guides.length&&<p class="section">{t('Nos guides sont en cours de préparation.','Our guides are being prepared.')} <a href={localPath('/notre-methode/',locale)}>{t('Découvrez notre méthode.','Read our method.')}</a></p>}
<style>
.guide-shortcuts{display:flex;flex-wrap:wrap;gap:10px 24px;padding-block:20px}.guide-shortcuts a{display:flex;gap:22px;align-items:center;min-height:44px;font-size:.9rem;text-decoration:none;border-bottom:1px solid var(--line)}.guide-index-item{display:grid;grid-template-columns:minmax(0,1fr) 1.6fr;gap:clamp(24px,5vw,72px);align-items:center;border-top:1px solid var(--line);padding:clamp(28px,4vw,54px) 0}.guide-index-item:not(:has(figure)){display:block}.guide-index-item p{max-width:62ch;margin:14px 0}.guide-index-item h2{font-size:clamp(30px,4vw,48px);max-width:28ch}.guide-index-item h2 a{text-decoration:none}.guide-index-item :global(img){max-height:270px;object-fit:cover}@media(max-width:700px){.guide-index-item{display:block}.guide-index-item :global(figure){margin-bottom:20px}.guide-shortcuts{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px}.guide-shortcuts a{justify-content:space-between}}
</style>
