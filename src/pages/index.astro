---
import SocialEntry from '../components/SocialEntry.astro';
import TempusOffer from '../components/TempusOffer.astro';
import CatalogueDiscovery from '../components/CatalogueDiscovery.astro';
import {hasAffiliation} from '../data/destinations';
import Cadrin from '../layouts/Cadrin.astro';
import Photo from '../components/Photo.astro';
import HomeShopping from '../components/HomeShopping.astro';
import HomeHighlights from '../components/HomeHighlights.astro';
import {catalogue} from '../lib/editorial';
const {guides,selections,finder}=await catalogue();
const gift=guides.find(g=>g.id==='offrir-une-montre');
const budget=guides.find(g=>g.id==='montres-par-budget');
const guide=guides.find(g=>g.id==='choisir-premiere-montre');const selection=selections[0];

---
<Cadrin title="Une montre. Votre allure." description="Des sélections et des guides pour choisir une montre selon votre budget, votre style et votre poignet.">
 <section class="home-hero"><div class="hero-copy"><span class="eyebrow">Le sens du porté</span><h1>Une montre.<br/><span>Votre allure.</span></h1><p>Des sélections et des guides pour choisir une montre selon votre budget, votre style et votre poignet.</p><div class="hero-actions"><a class="button" href="#choisir">Trouver ma montre <span aria-hidden="true">↗</span></a>{guide&&<a class="hero-secondary" href={`/guides/${guide.id}/`}>Choisir ma première montre <span aria-hidden="true">→</span></a>}</div></div><Photo name="sleeve" eager sizes="(max-width: 700px) 100vw, 54vw"/></section>
 <HomeHighlights part="season"/>
 <SocialEntry/>
 <HomeShopping/>
 <HomeHighlights part="discover"/>
 {guide&&<nav class="intent-nav container" aria-label="Choisir selon votre besoin"><span class="eyebrow">Par où commencer ?</span><a href={`/guides/${guide.id}/`}>Ma première montre <span>↗</span></a><a href={budget?`/guides/${budget.id}/`:`/guides/${guide.id}/#taille`}>{budget?"Par budget":"Les proportions"} <span>↗</span></a>{selection&&<a href={`/selections/${selection.id}/`}>Au quotidien <span>↗</span></a>}<a href={gift?`/guides/${gift.id}/`:`/guides/${guide.id}/#usage`}>Offrir une montre <span>↗</span></a></nav>}
 <div class="container"><TempusOffer/></div>

 {selection&&<section class="choice-band"><div class="container choice-inner"><div><h2>Trouver ma montre</h2><p>Choisissez un mouvement ou un bracelet, puis comparez les modèles qui vous plaisent.</p>{finder.length>0 && <a class="text-link" href="/trouver-ma-montre/">Ouvrir le sélecteur →</a>}</div><div class="choice-links"><a href={`/selections/${selection.id}/?movement=Quartz#choisir`}>La simplicité du quartz <span>↗</span></a><a href={`/selections/${selection.id}/?movement=Solaire#choisir`}>L’énergie de la lumière <span>↗</span></a><a href={`/selections/${selection.id}/?movement=Automatique#choisir`}>Le rituel mécanique <span>↗</span></a></div></div></section>}
 {guide&&<section class="container section guide-feature"><Photo name="wrist" sizes="(max-width:700px) 100vw, 44vw"/><div><span class="eyebrow">Le guide pour commencer</span><span class="feature-number" aria-hidden="true">01</span><h2>La première.<br/>Surtout la vôtre.</h2><p>Un budget confortable. Des proportions qui vous plaisent. Un mouvement adapté à vos habitudes. Le bon choix commence par quelques questions simples.</p><a class="text-link" href={`/guides/${guide.id}/`}>Choisir ma première montre <span aria-hidden="true">↗</span></a></div></section>}
 <section class="container section"><CatalogueDiscovery/></section>
 <section class="method-band"><div class="container method-inner"><span class="eyebrow">Notre regard</span><h2>Les chiffres aident.<br/>Le porté décide.</h2><div><p>Nous séparons les faits des impressions. Nous citons les fabricants et les marchands pour les caractéristiques. Nos conseils de choix reposent sur ces documents.</p><p>{hasAffiliation?"Certains liens peuvent rémunérer Cadrin si vous achetez chez le marchand. Cette relation commerciale est signalée à proximité des liens.":"Le modèle économique envisagé est l’affiliation. Aucun lien rémunéré n’est activé aujourd’hui."}</p><a class="text-link" href="/notre-methode/">Lire notre méthode <span aria-hidden="true">↗</span></a></div></div></section>
</Cadrin>
