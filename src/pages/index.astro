---
// Accueil en huit temps : la promesse, le moment (Black Friday, Noël), quatre références datées et achetables,
// le code de première commande, les portes d'entrée (sélections, duels, marques), le guide, puis la méthode.
import SocialEntry from '../components/SocialEntry.astro';
import TempusOffer from '../components/TempusOffer.astro';
import {hasAffiliation} from '../data/destinations';
import Cadrin from '../layouts/Cadrin.astro';
import Photo from '../components/Photo.astro';
import HeroVitrine from '../components/HeroVitrine.astro';
import HomeShopping from '../components/HomeShopping.astro';
import HomeHighlights from '../components/HomeHighlights.astro';
import {catalogue} from '../lib/editorial';
const {guides}=await catalogue();
const guide=guides.find(g=>g.id==='choisir-premiere-montre');
---
<Cadrin title="Choisir une montre : comparatifs, guides et idées cadeaux" description="Comparatifs, guides et idées cadeaux pour choisir une montre selon votre budget, votre style et votre poignet. Prix relevés chaque jour.">
 <section class="home-hero"><div class="hero-copy"><h1>Une montre.<br/><span>Votre allure.</span></h1><p>Des références exactes, des prix relevés chaque matin et les points à vérifier avant d’acheter. Pour choisir selon votre budget, votre style et votre poignet.</p><div class="hero-actions"><a class="button" href="/trouver-ma-montre/">Trouver ma montre <span aria-hidden="true">→</span></a>{guide&&<a class="hero-secondary" href={`/guides/${guide.id}/`}>Choisir ma première montre <span aria-hidden="true">→</span></a>}</div></div><HeroVitrine/></section>
 <HomeHighlights part="season"/>
 <SocialEntry/>
 <HomeShopping/>
 <div class="container"><TempusOffer/></div>
 <HomeHighlights part="discover"/>
 {guide&&<section class="container section guide-feature"><Photo name="wrist" sizes="(max-width:700px) 100vw, 44vw"/><div><h2>La première.<br/>Surtout la vôtre.</h2><p>Un budget confortable. Des proportions qui vous plaisent. Un mouvement adapté à vos habitudes. Le bon choix commence par quelques questions simples.</p><a class="text-link" href={`/guides/${guide.id}/`}>Lire le guide de la première montre <span aria-hidden="true">→</span></a></div></section>}
 <section class="method-band"><div class="container method-inner"><h2>Les chiffres aident.<br/>Le porté décide.</h2><div><p>Nous séparons les faits des impressions. Nous citons les fabricants et les marchands pour les caractéristiques. Nos conseils de choix reposent sur ces documents.</p><p>{hasAffiliation?"Certains liens peuvent rémunérer Cadrin si vous achetez chez le marchand. Cette relation commerciale est signalée à proximité des liens.":"Le modèle économique envisagé est l’affiliation. Aucun lien rémunéré n’est activé aujourd’hui."}</p><a class="text-link" href="/notre-methode/">Lire notre méthode <span aria-hidden="true">→</span></a></div></div></section>
</Cadrin>
