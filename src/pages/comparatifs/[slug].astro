---
import FeaturePage from '../../components/FeaturePage.astro';
import AutoComparison from '../../components/AutoComparison.astro';
import {features} from '../../data/features';
import {autoComparisons} from '../../data/auto-comparisons';
export function getStaticPaths(){return [...features.filter(f=>f.kind==='comparison').map(feature=>({params:{slug:feature.slug},props:{feature,cmp:null}})),...autoComparisons.map(cmp=>({params:{slug:cmp.slug},props:{feature:null,cmp}}))];}
const {feature,cmp}=Astro.props as any;
---
{cmp?<AutoComparison cmp={cmp}/>:<FeaturePage feature={feature}/>}
