---
import AffiliateNotice from '../../components/AffiliateNotice.astro';
import WatchComparison from '../../components/WatchComparison.astro';
import {render} from 'astro:content';import Cadrin from '../../layouts/Cadrin.astro';import WatchCard from '../../components/WatchCard.astro';import Filters from '../../components/Filters.astro';import {catalogue,dateLabel} from '../../lib/editorial';
export async function getStaticPaths(){const {selections}=await catalogue();return selections.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const {watches,guides}=await catalogue();const selected=entry.data.watches.map(id=>watches.find(w=>w.id===id)!);const {Content}=await render(entry);
---
<Cadrin title={entry.data.title} description={entry.data.description} crumbs={[{name:'Sélections',url:'/selections/'},{name:entry.data.title,url:`/selections/${entry.id}/`}]}><div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><a href="/selections/">Sélections</a><span>/</span><span>Au quotidien</span></nav><header class="page-heading"><span class="eyebrow">La sélection / 01</span><h1>Trois montres.<br/>Trois quotidiens.</h1><p>{entry.data.description}</p><p class="small-note">Caractéristiques revues le {dateLabel(entry.data.verifiedAt!)} · Aucun essai physique.</p></header><section class="section"><div class="selection-intro"><Content/><aside><strong>Ce que nous comparons</strong><p>Le mouvement, les dimensions et une proposition d’usage. Ni note globale, ni ordre de mérite. Le confort se juge au poignet.</p></aside></div><div id="choisir"><h2 class="filter-heading">Affiner votre recherche</h2><AffiliateNotice/><Filters/><div class="filter-meta"><output id="result-count" aria-live="polite" aria-atomic="true">{selected.length} références à explorer</output><p>Les dimensions inconnues restent à confirmer. Le diamètre seul ne prédit pas le confort.</p></div><div class="watch-grid">{selected.map(watch=><WatchCard watch={watch}/>)}</div><div class="empty-state" id="empty" hidden><h3>Aucune référence pour ces critères.</h3><p>Cette sélection est volontairement courte. Essayez un autre mouvement ou élargissez les dimensions.</p><button class="button" id="empty-reset" type="button">Réinitialiser les filtres</button></div></div><WatchComparison watches={selected}/><div class="selection-bottom"><div><h2>La fiche avant le clic.</h2><p>Consultez les dimensions et les limites de chaque référence. La fiche indique les points à confirmer auprès du vendeur.</p></div><div><h2>Encore une hésitation ?</h2><p>Revenez aux quatre questions utiles : budget, taille, mouvement et usage.</p>{guides[0]&&<a class="text-link" href={`/guides/${guides[0].id}/`}>Lire le guide de la première montre <span aria-hidden="true">↗</span></a>}</div></div></section></div></Cadrin>
<style>.filter-heading{font-family:var(--text);font-size:24px;margin-bottom:16px}.empty-state .button{margin-top:22px}</style>
