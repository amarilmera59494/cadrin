---
import Cadrin from '../../layouts/Cadrin.astro';import Photo from '../../components/Photo.astro';import {catalogue} from '../../lib/editorial';
const {selections,finder}=await catalogue();
---
<Cadrin title="Les sélections de montres" description="Des sélections courtes et documentées, pensées pour les usages et les proportions, sans classement ni prix supposé." crumbs={[{name:'Sélections',url:'/selections/'}]}><div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><span>Sélections</span></nav><header class="page-heading"><span class="eyebrow">Réduire le champ</span><h1>Moins de modèles.<br/>Plus de repères.</h1><p>Des pistes à explorer, pas un palmarès. Chaque référence est accompagnée de ses faits, de ses sources et de ses limites.</p>{finder.length>0 && <a class="text-link" href="/trouver-ma-montre/">Filtrer toutes les montres par budget et par style →</a>}</header>{selections.map(s=><section class="editorial-index section"><Photo name="wrist" eager sizes="(max-width:700px) 100vw, 45vw"/><div><span class="eyebrow">La sélection / 01 · {s.data.watches.length} références</span><h2>{s.data.title}</h2><p>{s.data.description}</p><p class="small-note">Photographie d’ambiance, hors sélection. Aucun essai physique revendiqué.</p><a class="text-link" href={`/selections/${s.id}/`}>Explorer les trois montres <span aria-hidden="true">↗</span></a></div></section>)}{!selections.length&&<p class="section">Retrouvez ici nos prochaines sélections. <a href="/notre-methode/">Découvrez nos critères.</a></p>}</div></Cadrin>
