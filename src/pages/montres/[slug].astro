---
import WatchSpecifications from '../../components/WatchSpecifications.astro';
import SourceLink from '../../components/SourceLink.astro';
import WatchPhoto from '../../components/WatchPhoto.astro';
import WatchAlternatives from '../../components/WatchAlternatives.astro';
import WatchReading from '../../components/WatchReading.astro';
import WatchPurchase from '../../components/WatchPurchase.astro';
import StickyBuy from '../../components/StickyBuy.astro';
import catalogueData from '../../data/tempus-catalogue.json';
import {affiliateUrl} from '../../data/affiliation';
import {merchantLinkAvailable,purchaseLabel,type CatalogueProduct} from '../../lib/tempus-catalogue';
import {render} from 'astro:content';import Cadrin from '../../layouts/Cadrin.astro';import {catalogue,dateLabel} from '../../lib/editorial';
export async function getStaticPaths(){const {watches}=await catalogue();return watches.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const p=entry.data;const {Content}=await render(entry);const {selections,guides,finder}=await catalogue();
const relatedGuides=guides.filter(g=>g.data.related.includes(entry.id));
const selection=selections.find(s=>s.data.watches.includes(entry.id));
const offer=(catalogueData.products as CatalogueProduct[]).find(x=>x.reference===p.reference);
const buyable=!!offer&&offer.orderable&&merchantLinkAvailable(offer);
const checkedAt=(catalogueData as any).offersCheckedAt||catalogueData.checkedAt;
const productSchema=offer?[{'@type':'Product',name:`${p.brand} ${p.name} ${p.reference}`,brand:{'@type':'Brand',name:p.brand},mpn:p.reference,sku:p.reference,image:new URL(p.image??offer.image,'https://cadrin.fr').href,description:p.description,offers:{'@type':'Offer',price:offer.price.toFixed(2),priceCurrency:'EUR',seller:{'@type':'Organization',name:'Tempus'}}}]:[];

---
<Cadrin title={p.title} description={p.description} schema={productSchema} crumbs={[{name:'Analyses',url:'/analyses/'},{name:`${p.brand} ${p.reference}`,url:`/montres/${entry.id}/`}]}><div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><a href="/analyses/">Analyses</a><span>/</span><span>{p.reference}</span></nav><header class="watch-heading purchase-heading"><div><h1>{p.brand} {p.name}</h1><p class="reference">Réf. {p.reference}</p><p class="lead">{p.note}</p><div class="reading-meta"><span>Caractéristiques revues le {dateLabel(p.verifiedAt!)}</span></div></div><WatchPhoto src={p.image} reference={p.reference} approved={p.rights==="approved"} detail/><WatchPurchase watch={entry}/></header><div class="watch-detail-layout purchase-at-top"><article class="reading"><section><h2>La montre en détail</h2><WatchSpecifications facts={p.facts}/><p class="chapter-source">Source : <SourceLink url={p.sources[0].url}>{p.sources[0].label} ↗</SourceLink>. Données annoncées par la source citée, non mesurées par Cadrin.</p></section><section><Content/></section><WatchReading reference={p.reference} brand={p.brand}/><WatchAlternatives id={entry.id}/><section><h2>Sources et limites</h2><ul class="source-list">{p.sources.map(s=><li><SourceLink url={s.url}>{s.label} ↗</SourceLink></li>)}</ul><p>Les usages suggérés sont une analyse éditoriale.</p><a class="text-link" href="/notre-methode/">Comprendre notre méthode <span aria-hidden="true">→</span></a></section>{relatedGuides.length>0 && <section><h2>Pour départager les modèles</h2><ul class="source-list">{relatedGuides.map(g=><li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}</ul></section>}{finder.some(w=>w.id===entry.id)&&<p><a class="text-link" href={`/trouver-ma-montre/?comparer=${entry.id}`}>Comparer cette montre →</a></p>}{selection&&<a class="text-link" href={`/selections/${selection.id}/`}>← Revenir à la sélection « {selection.data.title} »</a>}</article></div></div>{buyable&&offer&&<StickyBuy price={offer.price} label={purchaseLabel(offer,false)} href={affiliateUrl(offer.source)} checkedAt={checkedAt} reference={offer.reference} watch=".purchase-panel .merchant-button"/>}</Cadrin>
