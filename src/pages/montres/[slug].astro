---
import SourceLink from '../../components/SourceLink.astro';
import WatchPhoto from '../../components/WatchPhoto.astro';
import {destinations,validDestination} from '../../data/destinations';
import {render} from 'astro:content';import Cadrin from '../../layouts/Cadrin.astro';import CadrinMerchantLink from '../../components/CadrinMerchantLink.astro';import {catalogue,dateLabel} from '../../lib/editorial';
export async function getStaticPaths(){const {watches}=await catalogue();return watches.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const p=entry.data;const {Content}=await render(entry);const {selections,guides,finder}=await catalogue();
const relatedGuides=guides.filter(g=>g.data.related.includes(entry.id));
const selection=selections.find(s=>s.data.watches.includes(entry.id));
const merchant=validDestination(destinations[entry.id]);
---
<Cadrin title={p.title} description={p.description} crumbs={[{name:'Sélections',url:'/selections/'},{name:`${p.brand} ${p.reference}`,url:`/montres/${entry.id}/`}]}><div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><a href="/selections/">Sélections</a><span>/</span><span>{p.reference}</span></nav><header class="watch-heading"><div><span class="eyebrow">Fiche documentaire / {p.brand}</span><h1>{p.name}</h1><p class="reference">{p.brand} · {p.reference}</p><p class="lead">{p.note}</p><div class="reading-meta"><span>Caractéristiques revues le {dateLabel(p.verifiedAt!)}</span><span>Sans essai au poignet</span></div></div><WatchPhoto src={p.image} reference={p.reference} approved={p.rights==="approved"} detail/></header><div class="watch-detail-layout"><article class="reading"><section><h2>Les repères vérifiés</h2><dl class="facts">{p.facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl><p class="chapter-source">Source : <SourceLink url={p.sources[0].url}>{p.sources[0].label} ↗</SourceLink>. Données annoncées par la source citée, non mesurées par Cadrin.</p></section><section><Content/></section><section><h2>Sources et limites</h2><ul class="source-list">{p.sources.map(s=><li><SourceLink url={s.url}>{s.label} ↗</SourceLink></li>)}</ul><p>Les usages suggérés sont une analyse éditoriale. Il n’existe ici ni note, ni avis client, ni test de résistance ou de précision.</p><a class="text-link" href="/notre-methode/">Comprendre notre méthode <span aria-hidden="true">↗</span></a></section>{relatedGuides.length>0 && <section><h2>Pour départager les modèles</h2><ul class="source-list">{relatedGuides.map(g=><li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}</ul></section>}{finder.some(w=>w.id===entry.id)&&<p><a class="text-link" href={`/trouver-ma-montre/?comparer=${entry.id}`}>Comparer cette montre →</a></p>}{selection&&<a class="text-link" href={`/selections/${selection.id}/`}>← Revenir aux trois montres</a>}</article><aside class="merchant-panel">
  {merchant ? <>
    <h2>Chez {destinations[entry.id].merchant}</h2>
    <p>{entry.id==='seiko-srpe55k1' || entry.id==='casio-f91w' ? p.limit : 'Retrouvez cette référence chez le vendeur pour consulter le prix et les conditions de livraison.'}</p>
    {p.price != null && p.priceCheckedAt && <p class="observed-price"><strong>{new Intl.NumberFormat("fr-FR",{style:"currency",currency:"EUR"}).format(p.price)}</strong><br/><small>Prix relevé le {dateLabel(p.priceCheckedAt)} hors livraison. Vérifiez le montant actuel chez le vendeur.</small></p>}
    <CadrinMerchantLink id={entry.id}/>
    <p class="small-note"><a href="/notre-methode/#affiliation">Affiliation et transparence</a></p>
  </> : <>
    <h2>La fiche du fabricant</h2>
    <p>Aucune destination marchande confirmée pour cette référence.</p>
    <SourceLink url={p.sources[0].url}>{p.sources[0].label} ↗</SourceLink>
  </>}
</aside></div></div></Cadrin>
