---
// Fiche modèle générée depuis le catalogue : caractéristiques, points à vérifier, prix daté, alternatives.
import Cadrin from '../../layouts/Cadrin.astro';
import data from '../../data/tempus-catalogue.json';
import bf from '../../data/black-friday.json';
import history from '../../data/price-history.json';
import {reviewFor} from '../../data/review-syntheses';
import {editorialLinks} from '../../data/editorial-links';
import {hubs,brandHubs} from '../../data/selection-hubs';
import {affiliateUrl} from '../../data/affiliation';
import StickyBuy from '../../components/StickyBuy.astro';
import {dateLabel} from '../../lib/editorial';
import {detailRows,orderLabel,purchaseLabel,type CatalogueProduct} from '../../lib/tempus-catalogue';
import {ficheEligible,ficheSlug,ficheHref,ficheSummary,ficheChecks,ficheAlternatives,ficheTitle} from '../../lib/fiches';
export function getStaticPaths(){
 const all=data.products as CatalogueProduct[],seen=new Set<string>();
 return all.filter(ficheEligible).sort((a,b)=>a.price-b.price).filter(p=>{const s=ficheSlug(p);if(seen.has(s))return false;seen.add(s);return true;}).map(p=>({params:{slug:ficheSlug(p)},props:{p}}));
}
const {p}=Astro.props as {p:CatalogueProduct};
const all=data.products as CatalogueProduct[];
const checkedAt=(data as any).offersCheckedAt||data.checkedAt;
const money=(n:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(n);
const name=ficheTitle(p),checks=ficheChecks(p),{similar,cheaper}=ficheAlternatives(p,all);
const analysis=editorialLinks[p.reference];
const record=bf.items.find(i=>p.source.endsWith('/products/'+i.handle));
const rows=((history as any).items[p.id]||[]) as [string,number,number][];const lowest=rows.length?rows.reduce((m,r)=>r[1]<m[1]?r:m):null;const since=(history as any).since as string;
const review=reviewFor(p.reference);
const brandPage=({Citizen:'citizen',Orient:'orient',Seiko:'seiko',Longines:'longines','G-Shock':'casio-g-shock'} as Record<string,string>)[p.brand];const brandHub=brandHubs.find(h=>h.match(p));const brandHref=brandPage?`/marques/${brandPage}/`:brandHub?`/marques/${brandHub.slug}/`:null;
// Sélections où figure ce modèle : un lien interne par critère vérifiable sur la fiche.
const inHubs=hubs.filter(h=>h.match(p));
// Searches for a reference are mostly price searches (« 862129 euros ») : the dated price goes in the title.
const short=(n:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',minimumFractionDigits:n%1?2:0}).format(n),tName=name.replace(/\s+-\s+/g,' '),tPrice=short(p.price);
const title=[`${tName} : prix ${tPrice}, taille, étanchéité`,`${tName} : prix ${tPrice} et fiche`,`${tName} : ${tPrice}`,`${p.brand} ${p.reference} : prix ${tPrice} et fiche`,`${p.brand} ${p.reference} : ${tPrice}`].find(x=>x.length<=61)??`${p.brand} ${p.reference}`;
const descBase=`${p.brand} ${p.reference} : ${money(p.price)} au ${dateLabel(checkedAt)}. ${ficheSummary(p)}`;const description=[descBase+' Points à vérifier et alternatives.',descBase,`${p.brand} ${p.reference} : ${money(p.price)} au ${dateLabel(checkedAt)}. Caractéristiques, points à vérifier et alternatives.`].find(x=>x.length<=160)??descBase.slice(0,157)+'…';
const missingSpecs=[!p.caseSize&&'Dimension du boîtier',!p.glass&&'Verre',!p.water&&'Étanchéité'].filter(Boolean) as string[];
const guideLinks=[...new Map(checks.filter(c=>c.guide).map(c=>[c.guide!.url,c.guide!])).values()];
// Données Product/Offer : le prix relevé affiché sur la page, sans note, sans avis, sans disponibilité affirmée.
const productSchema=[{'@type':'Product',name:name,brand:{'@type':'Brand',name:p.brand},mpn:p.reference,sku:p.reference,image:new URL(p.image,'https://cadrin.fr').href,description:ficheSummary(p),offers:{'@type':'Offer',price:p.price.toFixed(2),priceCurrency:'EUR',seller:{'@type':'Organization',name:'Tempus'}}}];
---
<Cadrin title={title} description={description} schema={productSchema} canonicalPath={analysis?`/montres/${analysis}/`:undefined} crumbs={[{name:'Catalogue',url:'/catalogue/'},{name:`${p.brand} ${p.reference}`,url:`/montre/${ficheSlug(p)}/`}]}>
 <div class="container fiche">
  <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><a href="/catalogue/">Catalogue</a><span>/</span><a href={'/catalogue/?brand='+encodeURIComponent(p.brand)}>{p.brand}</a><span>/</span><span>{p.reference}</span></nav>
  <header class="fiche-head">
   <div class="fiche-photo"><img src={p.image} width={p.width} height={p.height} alt={`${p.title}, photo du vendeur`} fetchpriority="high"/><small>Photo du vendeur, non retouchée</small></div>
   <div class="fiche-intro">
    <span class="eyebrow">{p.brand}{p.category?` · ${p.category}`:''}</span>
    <h1>{name}</h1>
    <p class="fiche-lead">{ficheSummary(p)}</p>
    <div class="fiche-buy">
     <p class="fiche-price"><strong>{money(p.price)}</strong><small>Prix France relevé le {dateLabel(checkedAt)}, hors livraison.</small></p>
     <p class="fiche-status">{orderLabel(p,false)}</p>
     <a class="button merchant-button" data-buy-anchor data-placement="product" href={affiliateUrl(p.source)} rel="sponsored"><span>{purchaseLabel(p,false)}</span><span aria-hidden="true">↗</span></a>
     <button class="save-watch" type="button" data-save-id={p.id} data-save-label={p.reference} hidden>Garder en favoris</button>
     <small class="affiliate-note">Lien affilié : Cadrin peut toucher une commission, sans surcoût pour vous. Vérifiez le prix et le délai chez le vendeur avant de commander.</small>
    </div>
   </div>
  </header>

  <div class="fiche-body">
   {checks.length>0&&<section class="fiche-checks" aria-labelledby="verifier">
    <h2 id="verifier">À vérifier avant d’acheter</h2>
    <ol>{checks.map(c=><li><h3>{c.title}</h3><p>{c.text}</p></li>)}</ol>
    {guideLinks.length>0&&<p class="fiche-guides">Pour aller plus loin : {guideLinks.map((g,i)=><>{i>0&&' · '}<a href={g.url}>{g.label}</a></>)}</p>}
   </section>}

   <section aria-labelledby="fiche-tech">
    <h2 id="fiche-tech">La fiche technique</h2>
    <dl class="fiche-specs"><div><dt>Marque</dt><dd>{p.brand}</dd></div><div><dt>Référence</dt><dd>{p.reference}</dd></div><div><dt>Mouvement</dt><dd>{p.movement||'Non indiqué'}</dd></div>{detailRows(p,false).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}{missingSpecs.map(label=><div><dt>{label}</dt><dd class="fiche-na">{label==="Verre"?"Non communiqué":"Non communiquée"} par le vendeur</dd></div>)}</dl>
    <p class="small-note">Caractéristiques annoncées par la fiche du vendeur{p.specCheckedAt?`, relevées le ${dateLabel(p.specCheckedAt)}`:''}.</p>
    {analysis&&<p><a class="text-link" href={`/montres/${analysis}/`}>Lire notre analyse détaillée de ce modèle →</a></p>}
   </section>

   {review&&<section class="reviews" aria-labelledby="tests"><h2 id="tests">Ce qu’en disent les tests publiés</h2><p class="reviews-intro">Synthèse de tests et d’avis publics sur la {review.family}, consultés le 14 novembre 2026.</p><div class="reviews-cols"><div><h3>Ce qui est apprécié</h3><ul class="plus">{review.plus.map(x=><li>{x}</li>)}</ul></div><div><h3>Ce qui fait hésiter</h3><ul class="minus">{review.minus.map(x=><li>{x}</li>)}</ul></div></div>{review.note&&<p class="small-note">{review.note}</p>}<p class="reviews-src">Sources : {review.sources.map((s,i)=><>{i>0&&' · '}<a href={s.url} rel="nofollow noopener" target="_blank">{s.label} ↗</a></>)}</p></section>}
   <section aria-labelledby="releve"><h2 id="releve">Notre suivi du prix</h2>
    {rows.length>1?<><table class="fiche-history"><thead><tr><th scope="col">Date du relevé</th><th scope="col">Prix</th><th scope="col">Variation</th></tr></thead><tbody>{rows.slice().reverse().map((r,i,a)=>{const prev=a[i+1];const d=prev?r[1]-prev[1]:0;return <tr><td>{dateLabel(r[0])}</td><td>{money(r[1])}{!r[2]&&' (non commandable)'}</td><td>{prev?(d<0?'Baisse de '+money(-d):d>0?'Hausse de '+money(d):'—'):'Premier relevé'}</td></tr>;})}</tbody></table>
    <p class="fiche-lowest">Plus bas relevé depuis le {dateLabel(since)} : <strong>{money(lowest![1])}</strong>, le {dateLabel(lowest![0])}.</p></>
    :<p>Cadrin relève ce prix chaque jour depuis le {dateLabel(since)}. Aucune variation pour l’instant : {money(p.price)}.</p>}
    {record&&<p class="small-note">{record.was?<>Prix barré annoncé par le vendeur : {money(record.was)}. </>:null}Seul un relevé daté permet de vérifier une baisse. <a href="/black-friday/">Les remises suivies pour le Black Friday →</a></p>}
    <p class="small-note">Relevés automatiques, prix France hors livraison. <a href="/baisses-de-prix/">Toutes les baisses de prix relevées →</a></p>
   </section>

   {(similar.length>0||cheaper)&&<section aria-labelledby="alternatives"><h2 id="alternatives">Dans le même esprit</h2><p class="fiche-sub">{p.movement}, à un prix proche{similar.some(x=>x.brand!==p.brand)?', chez d’autres marques':''}.</p>
    <ul class="fiche-alts">{[...similar,...(cheaper?[cheaper]:[])].map(x=><li><a href={ficheHref(x)!}><img src={x.image} width={x.width} height={x.height} loading="lazy" alt=""/><span class="eyebrow">{x===cheaper?'Moins chère':x.brand}</span><strong>{ficheTitle(x)}</strong><span>{money(x.price)} · {ficheSummary(x)}</span></a></li>)}</ul></section>}

   <section class="fiche-more" aria-labelledby="comparer"><h2 id="comparer">Comparer avant de choisir</h2><ul>
    <li><a href={'/catalogue/?brand='+encodeURIComponent(p.brand)+'&compare='+p.id+'#catalogue-count'}>Comparer avec d’autres {p.brand} du catalogue →</a></li>
    {brandHref&&<li><a href={brandHref}>Notre dossier sur la marque {p.brand} →</a></li>}
    {inHubs.map(h=><li><a href={`/selections/${h.slug}/`}>Sélection : {h.title.toLowerCase().replace(/^montres?/,'les montres').replace(/^chronographes/,'les chronographes').replace(/^idées/,'idées')} →</a></li>)}
    <li><a href="/trouver-ma-montre/">Trouver une montre selon vos critères →</a></li>
    <li><a href="/notre-methode/">Comment nous sélectionnons et vérifions →</a></li>
   </ul></section>
  </div>
 </div>
 <StickyBuy price={p.price} label={purchaseLabel(p,false)} href={affiliateUrl(p.source)} checkedAt={checkedAt} reference={p.reference}/>
</Cadrin>
<style>
.fiche{padding-bottom:var(--section)}
.fiche-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:var(--space-5);align-items:start;padding-block:var(--space-2) var(--space-5);border-bottom:1px solid var(--line)}
.fiche-photo{background:#fff;padding:var(--space-4);text-align:center}.fiche-photo img{width:100%;max-width:420px;height:auto;aspect-ratio:4/5;object-fit:contain}.fiche-photo small{display:block;margin-top:var(--space-1);font-size:12px;color:var(--muted)}
.fiche-intro h1{font:500 clamp(40px,5vw,68px)/1 var(--display);text-transform:uppercase;margin:var(--space-2) 0;text-wrap:balance}
.fiche-lead{font-size:19px;line-height:1.5;max-width:34em}
.fiche-buy{margin-top:var(--space-4);padding:var(--space-3);background:var(--sand)}
.fiche-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-2);margin:0 0 var(--space-1)}.fiche-price strong{font:500 46px/1 var(--display);white-space:nowrap}.fiche-price small{font-size:12px;color:var(--muted)}
.fiche-status{font-size:14px;margin:0 0 var(--space-2)}
.fiche-buy .merchant-button{width:100%;min-height:52px;justify-content:center}
.fiche-buy .affiliate-note{display:block;margin-top:var(--space-2);font-size:12px;line-height:1.5;color:var(--muted)}
.fiche-body{display:grid;gap:var(--section);padding-top:var(--section);max-width:960px}
.fiche-body h2{font:500 clamp(30px,3.4vw,44px)/1.05 var(--display);text-transform:uppercase;margin:0 0 var(--space-3)}
.fiche-checks ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-3);counter-reset:c}
.fiche-checks li{counter-increment:c;border-top:3px solid var(--accent);padding-top:var(--space-2)}
.fiche-checks li::before{content:counter(c,decimal-leading-zero);font:500 28px/1 var(--display);color:var(--accent)}
.fiche-checks h3{font-size:18px;line-height:1.3;margin:var(--space-1) 0}.fiche-checks p{margin:0;line-height:1.55}
.fiche-guides{margin-top:var(--space-4)!important;padding-top:var(--space-2);border-top:1px solid var(--line);font-size:15px;max-width:none!important}
.fiche-specs{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:0 var(--space-4);margin:0}
.fiche-specs div{display:grid;grid-template-columns:11em 1fr;gap:var(--space-2);padding:12px 0;border-bottom:1px solid var(--line)}.fiche-specs dt{color:var(--muted);font-size:14px}.fiche-specs dd{margin:0;font-weight:600;font-size:15px}
.fiche-history{border-collapse:collapse;min-width:min(100%,420px)}.fiche-history th,.fiche-history td{text-align:left;padding:10px 16px 10px 0;border-bottom:1px solid var(--line)}
.fiche-lowest{margin-top:var(--space-2)}
.reviews h2{font:500 clamp(30px,3.4vw,44px)/1.05 var(--display);text-transform:uppercase;margin:0 0 var(--space-2)}
.reviews-intro{color:var(--muted);margin:0 0 var(--space-3)}
.reviews-cols{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}
.reviews h3{font-size:18px;margin:0 0 var(--space-1)}
.reviews ul{list-style:none;padding:0;margin:0;display:grid;gap:10px}
.reviews li{position:relative;padding-left:30px;line-height:1.5}
.reviews li::before{position:absolute;left:0;top:1px;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:15px}
.reviews .plus li::before{content:'+';background:#dcefe0;color:#1f5e3a}
.reviews .minus li::before{content:'−';background:#f6dcd8;color:#7a2a20}
.reviews-src{margin-top:var(--space-3)!important;font-size:14px;max-width:none!important}
@media(max-width:700px){.reviews-cols{grid-template-columns:1fr;gap:var(--space-3)}}
.fiche-specs .fiche-na{font-weight:400;color:var(--muted)}
.fiche-sub{margin:-8px 0 var(--space-3);color:var(--muted)}
.fiche-alts{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:var(--space-3)}
.fiche-alts a{display:flex;flex-direction:column;gap:6px;height:100%;padding:var(--space-2);background:#f9f6f0;border-top:3px solid var(--wine);text-decoration:none;color:inherit}
.fiche-alts a:hover strong,.fiche-alts a:focus-visible strong{text-decoration:underline}
.fiche-alts img{width:100%;height:190px;object-fit:contain;background:#fff;margin-bottom:var(--space-1)}
.fiche-alts strong{font-size:16px;line-height:1.3}.fiche-alts span:last-child{font-size:14px;line-height:1.45;color:var(--muted)}
.fiche-more ul{list-style:none;padding:0;margin:0;display:grid;gap:var(--space-1)}.fiche-more a{display:inline-flex;min-height:44px;align-items:center;font-weight:600}
@media(max-width:800px){.fiche-head{grid-template-columns:1fr;gap:var(--space-2)}.fiche-photo{padding:var(--space-2)}.fiche-photo img{max-width:none;width:auto;height:min(46vw,240px);margin-inline:auto}.fiche-intro h1{font-size:clamp(30px,8.4vw,44px);line-height:1.02;margin-block:var(--space-1)}.fiche-lead{font-size:16px}.fiche-buy{margin-top:var(--space-2);padding:var(--space-2)}.fiche-price strong{font-size:38px}.fiche-specs div{grid-template-columns:9em 1fr}}
</style>
