---
import Cadrin from '../../layouts/Cadrin.astro';
import data from '../../data/tempus-catalogue.json';
import {tiktokNoel} from '../../data/tiktok-noel';
import {affiliateUrl} from '../../data/affiliation';
import {dateLabel} from '../../lib/editorial';
import {purchaseLabel,orderLabel} from '../../lib/tempus-catalogue';
import '../../styles/growth.css';
const sets=tiktokNoel.map(c=>({...c,items:c.items.map(it=>{const product=data.products.find(p=>p.source.endsWith('/products/'+it.handle));if(!product)throw Error('Référence TikTok Noël absente du catalogue : '+it.handle);return {...it,product};})}));
const money=(p:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(p);
const titleCase=(s:string)=>s.charAt(0)+s.slice(1).toLowerCase();
---
<Cadrin title="Les montres de nos carrousels de Noël" description="Les références exactes de nos carrousels TikTok de Noël : photos Tempus, prix datés et liens directs pour offrir la bonne montre.">
 <div class="container social-page noel-page"><header class="page-heading"><span class="eyebrow">CADRIN · TikTok · Noël</span><h1>Vue sur TikTok.<br/>Prête à offrir.</h1><p>Retrouvez chaque montre dans l’ordre du carrousel : même numéro, même référence, lien direct chez Tempus.</p><p class="small-note">Liens affiliés : vos achats peuvent rémunérer CADRIN. Prix France hors livraison, relevés le {dateLabel((data.offersCheckedAt||data.checkedAt),'fr')}. Stock et délai de livraison à vérifier chez Tempus avant de commander.</p></header>
 <p class="noel-bf"><a href="/black-friday/">Black Friday : voir les montres déjà remisées, avec notre relevé de prix daté →</a></p>
 <nav class="social-jumps" aria-label="Choisir un carrousel">{sets.map(c=><a href={'#'+c.id}>{titleCase(c.kicker)}</a>)}</nav>
 {sets.map(c=><section class="noel-set" id={c.id}><span class="eyebrow">{c.kicker}</span><h2>{titleCase(c.title)}</h2><ol class="noel-grid">{c.items.map((it,i)=><li class="noel-card" data-reference={it.product.reference}><span class="noel-num" aria-hidden="true">{i+1}</span><img src={it.product.image} width={it.product.width} height={it.product.height} loading="lazy" alt={it.product.title}/><p class="noel-profile">{it.profile}</p><h3>{it.name}</h3><p class="social-reference">Réf. {it.product.reference}</p><p class="social-price">{money(it.product.price)}</p><p class="small-note">{orderLabel(it.product,false)}</p><a class="button merchant-button" data-placement="tiktok-noel" href={affiliateUrl(it.product.source)} rel="sponsored">{purchaseLabel(it.product,false)} ↗</a><small class="affiliate-note">Lien affilié · Photo Tempus</small></li>)}</ol></section>)}
 <section class="social-banner"><p><strong>Première commande chez Tempus ?</strong> Le code public WELCOME10 donne −10 %, hors nouveautés et articles déjà remisés, non cumulable. Vérifiez la réduction avant de payer.</p><a href="/trouver-ma-montre/">Chercher une autre montre →</a></section></div>
</Cadrin>
<style>
.noel-set{padding:3rem 0;border-bottom:1px solid #cdbfb4;scroll-margin-top:7rem}.noel-set h2{font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.1;margin:.4rem 0 1.5rem}
.noel-grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.2rem}
.noel-card{position:relative;background:#f9f6f0;border-top:3px solid #792a40;padding:1.2rem;display:flex;flex-direction:column;min-width:0}
.noel-card img{width:100%;height:240px;object-fit:contain;background:#fff}
.noel-num{position:absolute;top:.8rem;left:.8rem;width:2.4rem;height:2.4rem;border-radius:50%;background:#4a1725;color:#f5f0e6;display:grid;place-items:center;font-weight:700;font-size:1.2rem}
.noel-profile{font-size:.95rem;color:#674d56;margin:.9rem 0 .2rem}.noel-card h3{font-size:1.2rem;line-height:1.3;margin:0 0 .3rem}
.noel-card .social-price{font-size:1.6rem;margin:.4rem 0}.noel-card .button{margin-top:auto;width:100%;min-height:48px}
@media(max-width:740px){.noel-grid{grid-template-columns:1fr 1fr;gap:.8rem}.noel-card{padding:.8rem}.noel-card img{height:160px}.noel-card .button{font-size:.9rem;padding:.7rem .4rem}}
.noel-bf{margin:0 0 1.5rem}.noel-bf a{font-weight:650;color:var(--wine)}</style>
