---
// Les variations de prix relevées par Cadrin : uniquement nos propres relevés datés, jamais un prix barré.
import Cadrin from '../../layouts/Cadrin.astro';
import data from '../../data/tempus-catalogue.json';
import history from '../../data/price-history.json';
import {affiliateUrl} from '../../data/affiliation';
import {dateLabel} from '../../lib/editorial';
import {purchaseLabel,type CatalogueProduct} from '../../lib/tempus-catalogue';
import {ficheEligible,ficheHref,ficheTitle} from '../../lib/fiches';
type Row=[string,number,number];
const items=(history as any).items as Record<string,Row[]>,since=(history as any).since as string,updatedAt=(history as any).updatedAt as string;
const money=(n:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(n);
const products=(data.products as CatalogueProduct[]).filter(p=>p.orderable);
const moves=products.map(p=>{const r=items[p.id]||[];if(r.length<2)return null;const last=r.at(-1)!,prev=r.at(-2)!;if(last[1]===prev[1])return null;const low=Math.min(...r.map(x=>x[1]));return {p,last,prev,diff:last[1]-prev[1],pct:Math.round(100*(prev[1]-last[1])/prev[1]),lowest:last[1]<=low};}).filter(Boolean) as {p:CatalogueProduct,last:Row,prev:Row,diff:number,pct:number,lowest:boolean}[];
const drops=moves.filter(m=>m.diff<0).sort((a,b)=>b.pct-a.pct||b.last[0].localeCompare(a.last[0])).slice(0,60);
const rises=moves.filter(m=>m.diff>0).sort((a,b)=>b.last[0].localeCompare(a.last[0])||b.diff-a.diff).slice(0,12);
const link=(p:CatalogueProduct)=>ficheEligible(p)?ficheHref(p):null;
---
<Cadrin title="Les vraies baisses de prix des montres" description="Les baisses de prix relevées chaque jour par Cadrin sur le catalogue : prix d’avant, prix du jour, date. Uniquement nos relevés datés, jamais un prix barré." crumbs={[{name:'Baisses de prix',url:'/baisses-de-prix/'}]}>
 <div class="container drops">
  <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><span>Baisses de prix</span></nav>
  <header class="page-heading"><h1>Les baisses de prix, relevées chaque jour.</h1>
   <p>Chaque matin, Cadrin relève le prix des {data.products.length.toLocaleString('fr-FR')} montres du catalogue. Une montre n’apparaît ici que si <strong>notre propre relevé</strong> montre une baisse par rapport au relevé précédent : jamais sur la foi d’un prix barré.</p>
   <p class="small-note">Suivi depuis le {dateLabel(since)} · dernier relevé le {dateLabel(updatedAt)} · prix France hors livraison · liens affiliés : Cadrin peut toucher une commission.</p></header>
  {drops.length>0?<ol class="drops-list">{drops.map(m=><li>
    <img src={m.p.image} width={m.p.width} height={m.p.height} loading="lazy" decoding="async" alt=""/>
    <div><span class="eyebrow">{m.p.brand}</span><h2>{link(m.p)?<a href={link(m.p)!}>{ficheTitle(m.p)}</a>:ficheTitle(m.p)}</h2>
     <p class="drops-price"><strong>{money(m.last[1])}</strong> <s>{money(m.prev[1])}</s> <span class="drops-pct">−{m.pct} %</span></p>
     <p class="small-note">Relevé du {dateLabel(m.last[0])}, contre {money(m.prev[1])} le {dateLabel(m.prev[0])}.{m.lowest&&' Plus bas prix relevé par Cadrin.'}</p></div>
    <a class="button merchant-button" data-placement="deal" href={affiliateUrl(m.p.source)} rel="sponsored"><span>{purchaseLabel(m.p,false)}</span><span aria-hidden="true">↗</span></a></li>)}</ol>
  :<section class="drops-empty"><h2>Aucune baisse relevée pour l’instant</h2><p>Le suivi a commencé le {dateLabel(since)}. Dès qu’un prix baisse d’un jour à l’autre, la montre apparaît ici, avec la date et le prix d’avant. En attendant, retrouvez <a href="/black-friday/">les remises en cours et notre relevé du Black Friday</a>.</p></section>}
  {rises.length>0&&<section class="drops-rises" aria-labelledby="hausses"><h2 id="hausses">Les dernières hausses</h2><p>Parce qu’une promotion peut aussi se terminer : les prix qui ont augmenté au dernier relevé.</p><ul>{rises.map(m=><li>{link(m.p)?<a href={link(m.p)!}>{ficheTitle(m.p)}</a>:ficheTitle(m.p)} : {money(m.prev[1])} → <strong>{money(m.last[1])}</strong> <span class="small-note">(le {dateLabel(m.last[0])})</span></li>)}</ul></section>}
  <section class="drops-method"><h2>Comment nous relevons</h2><p>Nous lisons chaque matin le catalogue public du vendeur, en euros, pour la France. Chaque variation est enregistrée avec sa date. Une baisse se compare toujours à notre relevé précédent ; le prix barré affiché par le vendeur ne compte pas. Les frais de livraison ne sont pas inclus, et le prix peut changer après notre relevé : vérifiez-le avant de commander.</p><p><a class="text-link" href="/notre-methode/">Notre méthode →</a></p></section>
 </div>
</Cadrin>
<style>
.drops{padding-bottom:var(--section)}
.drops-list{list-style:none;padding:0;margin:var(--space-4) 0 0;display:grid;gap:var(--space-2)}
.drops-list li{display:grid;grid-template-columns:120px 1fr auto;gap:var(--space-3);align-items:center;padding:var(--space-2) 0;border-bottom:1px solid var(--line)}
.drops-list img{width:120px;height:130px;object-fit:contain;background:#fff}
.drops-list h2{font-size:18px;line-height:1.3;margin:4px 0}.drops-list h2 a{color:inherit}
.drops-price{margin:4px 0}.drops-price strong{font:500 30px/1 var(--display)}.drops-price s{color:var(--muted);margin-left:8px}
.drops-pct{display:inline-block;margin-left:8px;padding:2px 8px;background:#dcefe0;color:#1f5e3a;font-weight:700;font-size:14px}
.drops-list .merchant-button{min-height:48px;white-space:nowrap}
.drops-empty,.drops-rises,.drops-method{margin-top:var(--section)}
.drops-empty h2,.drops-rises h2,.drops-method h2{font:500 clamp(28px,3vw,40px)/1.05 var(--display);text-transform:uppercase;margin:0 0 var(--space-2)}
.drops-rises ul{padding-left:1.1em;line-height:1.8}
@media(max-width:700px){.drops-list li{grid-template-columns:84px 1fr;gap:var(--space-2)}.drops-list img{width:84px;height:96px}.drops-list .merchant-button{grid-column:1/-1}}
</style>
