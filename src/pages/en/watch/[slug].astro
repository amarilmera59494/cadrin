---
// English watch page generated from the catalogue: specifications, checks before buying, dated price, alternatives.
import Cadrin from '../../../layouts/Cadrin.astro';
import InternationalNotice from '../../../components/InternationalNotice.astro';
import data from '../../../data/tempus-catalogue.json';
import bf from '../../../data/black-friday.json';
import history from '../../../data/price-history.json';
import {editorialLinks} from '../../../data/editorial-links';
import {affiliateUrl} from '../../../data/affiliation';
import {dateLabel} from '../../../lib/editorial';
import {localPath} from '../../../lib/i18n';
import {orderLabel,purchaseLabel,type CatalogueProduct} from '../../../lib/tempus-catalogue';
import {ficheEligible,ficheSlug,ficheHref,ficheAlternatives,ficheTitle} from '../../../lib/fiches';
import {ficheSummaryEn,ficheChecksEn,detailRowsEn,categoryEn,movementEn} from '../../../lib/fiches-en';
export function getStaticPaths(){
 const all=data.products as CatalogueProduct[],seen=new Set<string>();
 return all.filter(ficheEligible).sort((a,b)=>a.price-b.price).filter(p=>{const s=ficheSlug(p);if(seen.has(s))return false;seen.add(s);return true;}).map(p=>({params:{slug:ficheSlug(p)},props:{p}}));
}
const {p}=Astro.props as {p:CatalogueProduct};
const all=data.products as CatalogueProduct[];
const checkedAt=(data as any).offersCheckedAt||data.checkedAt;
const money=(n:number)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'EUR'}).format(n);
const day=(d:string)=>dateLabel(d,'en');
const name=ficheTitle(p),summary=ficheSummaryEn(p),checks=ficheChecksEn(p),{similar,cheaper}=ficheAlternatives(p,all);
const analysisPath=editorialLinks[p.reference]?localPath(`/montres/${editorialLinks[p.reference]}/`,'en'):null;
const analysis=analysisPath&&analysisPath!=='/en/'?analysisPath:null;
const record=bf.items.find(i=>p.source.endsWith('/products/'+i.handle));
const rows=((history as any).items[p.id]||[]) as [string,number,number][];const lowest=rows.length?rows.reduce((m,r)=>r[1]<m[1]?r:m):null;const since=(history as any).since as string;
const brandSlug=({Citizen:'citizen',Orient:'orient',Seiko:'seiko',Longines:'longines','G-Shock':'casio-g-shock'} as Record<string,string>)[p.brand];
const brandHref=brandSlug?localPath(`/marques/${brandSlug}/`,'en'):null;
// Never the bare product name: the French page may already use it, and the two languages need distinct titles.
const short=(n:number)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'EUR',minimumFractionDigits:n%1?2:0}).format(n),tName=name.replace(/\s+-\s+/g,' '),tPrice=short(p.price);
const title=[`${tName}: price ${tPrice}, size, water resistance`,`${tName}: price ${tPrice} and specs`,`${p.brand} ${p.reference}: price ${tPrice} and specs`,`${p.brand} ${p.reference}: ${tPrice} watch`].find(x=>x.length<=61)??`${p.brand} ${p.reference} watch`;
const descBase=`${p.brand} ${p.reference}: ${money(p.price)} in France on ${day(checkedAt)}. ${summary}`;
const description=[descBase+' Checks before buying and alternatives.',descBase,`${p.brand} ${p.reference}: ${money(p.price)} in France on ${day(checkedAt)}. Specifications, checks and alternatives.`].find(x=>x.length<=160)??descBase.slice(0,157)+'…';
const missingSpecs=[!p.caseSize&&'Case size',!p.glass&&'Crystal',!p.water&&'Water resistance'].filter(Boolean) as string[];
const guideLinks=[...new Map(checks.filter(c=>c.guide).map(c=>[c.guide!.url,c.guide!])).values()];
const href=ficheHref(p,true)!;
---
<Cadrin title={title} description={description} crumbs={[{name:'Catalogue',url:'/en/catalogue/'},{name:`${p.brand} ${p.reference}`,url:href}]}>
 <div class="container fiche">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/en/">Home</a><span>/</span><a href="/en/catalogue/">Catalogue</a><span>/</span><a href={'/en/catalogue/?brand='+encodeURIComponent(p.brand)}>{p.brand}</a><span>/</span><span>{p.reference}</span></nav>
  <header class="fiche-head">
   <div class="fiche-photo"><img src={p.image} width={p.width} height={p.height} alt={`${p.title}, retailer photo`} fetchpriority="high"/><small>Retailer photo, unretouched</small></div>
   <div class="fiche-intro">
    <span class="eyebrow">{p.brand}{p.category?` · ${categoryEn(p.category)}`:''}</span>
    <h1>{name}</h1>
    <p class="fiche-lead">{summary}</p>
    <div class="fiche-buy">
     <p class="fiche-price"><strong>{money(p.price)}</strong><small>Price in France recorded on {day(checkedAt)}, excluding delivery.</small></p>
     <p class="fiche-status">{orderLabel(p,true)}</p>
     <a class="button merchant-button" data-placement="product" href={affiliateUrl(p.source)} rel="sponsored"><span>{purchaseLabel(p,true)}</span><span aria-hidden="true">↗</span></a>
     <button class="save-watch" type="button" data-save-id={p.id} data-save-label={p.reference} hidden>Save this watch</button>
     <small class="affiliate-note">Affiliate link: Cadrin may earn a commission at no extra cost to you. Outside France, Tempus may show a local price and currency: check the price, delivery and any import charges before ordering.</small>
    </div>
   </div>
  </header>

  <div class="fiche-body">
   {checks.length>0&&<section class="fiche-checks" aria-labelledby="checks">
    <h2 id="checks">Check before buying</h2>
    <ol>{checks.map(c=><li><h3>{c.title}</h3><p>{c.text}</p></li>)}</ol>
    {guideLinks.length>0&&<p class="fiche-guides">Further reading: {guideLinks.map((g,i)=><>{i>0&&' · '}<a href={g.url}>{g.label}</a></>)}</p>}
   </section>}

   <section aria-labelledby="specs">
    <h2 id="specs">Specifications</h2>
    <dl class="fiche-specs"><div><dt>Brand</dt><dd>{p.brand}</dd></div><div><dt>Reference</dt><dd>{p.reference}</dd></div><div><dt>Movement</dt><dd>{p.movement?movementEn(p.movement):'Not stated'}</dd></div>{detailRowsEn(p).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}{missingSpecs.map(label=><div><dt>{label}</dt><dd class="fiche-na">Not provided by the retailer</dd></div>)}</dl>
    <p class="small-note">Specifications stated in the retailer listing{p.specCheckedAt?`, recorded on ${day(p.specCheckedAt)}`:''}, translated from French by Cadrin.</p>
    {analysis&&<p><a class="text-link" href={analysis}>Read our detailed analysis of this model →</a></p>}
   </section>

   <section aria-labelledby="price-record"><h2 id="price-record">Our price record</h2>
    {rows.length>1?<><table class="fiche-history"><thead><tr><th scope="col">Date recorded</th><th scope="col">Price</th><th scope="col">Change</th></tr></thead><tbody>{rows.slice().reverse().map((r,i,a)=>{const prev=a[i+1];const d=prev?r[1]-prev[1]:0;return <tr><td>{day(r[0])}</td><td>{money(r[1])}{!r[2]&&' (not orderable)'}</td><td>{prev?(d<0?'Down '+money(-d):d>0?'Up '+money(d):'—'):'First record'}</td></tr>;})}</tbody></table>
    <p class="fiche-lowest">Lowest price recorded since {day(since)}: <strong>{money(lowest![1])}</strong>, on {day(lowest![0])}.</p></>
    :<p>Cadrin has recorded this price every day since {day(since)}. No change so far: {money(p.price)}.</p>}
    {record&&<p class="small-note">{record.was?<>Struck-through price shown by the retailer: {money(record.was)}. </>:null}Only a dated record can confirm a reduction.</p>}
    <p class="small-note">Automatic records of the French price, excluding delivery. These are not currency conversions or delivered quotes.</p>
   </section>

   {(similar.length>0||cheaper)&&<section aria-labelledby="alternatives"><h2 id="alternatives">In the same spirit</h2><p class="fiche-sub">{movementEn(p.movement)}, at a similar price{similar.some(x=>x.brand!==p.brand)?', from other brands':''}.</p>
    <ul class="fiche-alts">{[...similar,...(cheaper?[cheaper]:[])].map(x=><li><a href={ficheHref(x,true)!}><img src={x.image} width={x.width} height={x.height} loading="lazy" alt=""/><span class="eyebrow">{x===cheaper?'Less expensive':x.brand}</span><strong>{ficheTitle(x)}</strong><span>{money(x.price)} · {ficheSummaryEn(x)}</span></a></li>)}</ul></section>}

   <section class="fiche-more" aria-labelledby="compare"><h2 id="compare">Compare before choosing</h2><ul>
    <li><a href={'/en/catalogue/?brand='+encodeURIComponent(p.brand)+'&compare='+p.id+'#catalogue-count'}>Compare with other {p.brand} watches in the catalogue →</a></li>
    {brandHref&&brandHref!=='/en/'&&<li><a href={brandHref}>Our {p.brand} brand guide →</a></li>}
    <li><a href="/en/watch-finder/">Find a watch by your criteria →</a></li>
    <li><a href="/en/our-method/">How we select and check →</a></li>
   </ul></section>
   <InternationalNotice/>
  </div>
 </div>
</Cadrin>
<style>
.fiche{padding-bottom:var(--section)}
.fiche-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:var(--space-5);align-items:start;padding-block:var(--space-2) var(--space-5);border-bottom:1px solid var(--line)}
.fiche-photo{background:#fff;padding:var(--space-4);text-align:center}.fiche-photo img{width:100%;max-width:420px;height:auto;aspect-ratio:4/5;object-fit:contain}.fiche-photo small{display:block;margin-top:var(--space-1);font-size:12px;color:var(--muted)}
.fiche-intro h1{font:500 clamp(40px,5vw,68px)/1 var(--display);text-transform:uppercase;margin:var(--space-2) 0;text-wrap:balance}
.fiche-lead{font-size:19px;line-height:1.5;max-width:34em}
.fiche-buy{margin-top:var(--space-4);padding:var(--space-3);background:var(--sand)}
.fiche-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-2);margin:0 0 var(--space-1)}.fiche-price strong{font:500 46px/1 var(--display);white-space:nowrap}.fiche-price small{font-size:12px;color:var(--muted)}
.fiche-status{font-size:14px;margin:0 0 var(--space-2)}
.fiche-buy .merchant-button{width:100%;min-height:52px;justify-content:center}
.fiche-buy .affiliate-note{display:block;margin-top:var(--space-2);font-size:12px;line-height:1.5;color:var(--muted)}
.fiche-body{display:grid;gap:var(--section);padding-top:var(--section);max-width:960px}
.fiche-body h2{font:500 clamp(30px,3.4vw,44px)/1.05 var(--display);text-transform:uppercase;margin:0 0 var(--space-3)}
.fiche-checks ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--space-3);counter-reset:c}
.fiche-checks li{counter-increment:c;border-top:3px solid var(--accent);padding-top:var(--space-2)}
.fiche-checks li::before{content:counter(c,decimal-leading-zero);font:500 28px/1 var(--display);color:var(--accent)}
.fiche-checks h3{font-size:18px;line-height:1.3;margin:var(--space-1) 0}.fiche-checks p{margin:0;line-height:1.55}
.fiche-guides{margin-top:var(--space-4)!important;padding-top:var(--space-2);border-top:1px solid var(--line);font-size:15px;max-width:none!important}
.fiche-specs{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:0 var(--space-4);margin:0}
.fiche-specs div{display:grid;grid-template-columns:11em 1fr;gap:var(--space-2);padding:12px 0;border-bottom:1px solid var(--line)}.fiche-specs dt{color:var(--muted);font-size:14px}.fiche-specs dd{margin:0;font-weight:600;font-size:15px}
.fiche-specs .fiche-na{font-weight:400;color:var(--muted)}
.fiche-history{border-collapse:collapse;min-width:min(100%,420px)}.fiche-history th,.fiche-history td{text-align:left;padding:10px 16px 10px 0;border-bottom:1px solid var(--line)}
.fiche-lowest{margin-top:var(--space-2)}
.fiche-sub{margin:-8px 0 var(--space-3);color:var(--muted)}
.fiche-alts{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:var(--space-3)}
.fiche-alts a{display:flex;flex-direction:column;gap:6px;height:100%;padding:var(--space-2);background:#f9f6f0;border-top:3px solid var(--wine);text-decoration:none;color:inherit}
.fiche-alts a:hover strong,.fiche-alts a:focus-visible strong{text-decoration:underline}
.fiche-alts img{width:100%;height:190px;object-fit:contain;background:#fff;margin-bottom:var(--space-1)}
.fiche-alts strong{font-size:16px;line-height:1.3}.fiche-alts span:last-child{font-size:14px;line-height:1.45;color:var(--muted)}
.fiche-more ul{list-style:none;padding:0;margin:0;display:grid;gap:var(--space-1)}.fiche-more a{display:inline-flex;min-height:44px;align-items:center;font-weight:600}
@media(max-width:800px){.fiche-head{grid-template-columns:1fr;gap:var(--space-3)}.fiche-photo{padding:var(--space-3)}.fiche-photo img{max-width:300px}.fiche-specs div{grid-template-columns:9em 1fr}}
</style>
