---
import Cadrin from '../layouts/Cadrin.astro';
import {catalogue,dateLabel} from '../lib/editorial';
export async function getStaticPaths() {
  const {finder} = await catalogue();
  return finder.length ? [{params:{outil:'trouver-ma-montre'},props:{models:finder}}] : [];
}
const {models} = Astro.props;
const money = (n:number) => new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:Number.isInteger(n)?0:2}).format(n);
const fields = [
  {key:'budget',label:'Budget plafond',options:[['50','50 €'],['150','150 €'],['300','300 €'],['350','350 €'],['500','500 €']]},
  {key:'mouvement',label:'Mouvement',options:['Automatique','Solaire','Quartz'].map(x=>[x,x])},
  {key:'bracelet',label:'Bracelet',options:['Acier','Cuir','Résine'].map(x=>[x,x])},
  {key:'categorie',label:'Catégorie catalogue',options:['Femme','Homme'].map(x=>[x,x])},
  {key:'largeur',label:'Largeur du boîtier',options:[['30','Jusqu’à 30 mm'],['39','Jusqu’à 39 mm'],['40','Jusqu’à 40 mm']]},
];
const rows = [
  ['Prix relevé', (w:typeof models[number])=>w.data.price!=null?money(w.data.price):'Non renseigné'],
  ['Date du relevé', (w:typeof models[number])=>w.data.priceCheckedAt?dateLabel(w.data.priceCheckedAt):'—'],
  ['Mouvement',(w:typeof models[number])=>w.data.movement],
  ['Boîtier',(w:typeof models[number])=>w.data.sizeLabel],
  ['Bracelet',(w:typeof models[number])=>w.data.finder!.bracelet],
  ['Affichage',(w:typeof models[number])=>w.data.finder!.display],
  ['À vérifier',(w:typeof models[number])=>w.data.limit],
] as const;
---
<Cadrin title="Trouver ma montre" description="Filtrez les montres documentées par budget, mouvement ou bracelet et comparez vos favorites côte à côte." crumbs={[{name:'Trouver ma montre',url:'/trouver-ma-montre/'}]}>
  <div class="container finder">
    <div class="breadcrumb"><a href="/">Accueil</a> / Sélecteur</div>
    <header class="intro"><div><span class="eyebrow">Le sélecteur Cadrin</span><h1>Trouver ma montre.</h1></div>
      <p>Partez d’un budget ou d’un bracelet que vous aimez. Gardez jusqu’à trois montres côte à côte pour voir ce qui les distingue.</p>
    </header>
    <div class="workspace">
      <aside><form id="criteria" hidden><h2>Vos critères</h2>
        <button id="filter-toggle" type="button" aria-controls="filter-options" aria-expanded="false" hidden>Filtrer les montres</button>
        <div id="filter-options"><label>Marque ou référence<input name="recherche" type="search" maxlength="80" placeholder="Ex. Citizen, SRPE55…"/></label>
        {fields.map(f=><label>{f.label}<select name={f.key}><option value="">Sans préférence</option>{f.options.map(([v,l])=><option value={v}>{l}</option>)}</select></label>)}
        <button type="reset">Effacer les critères</button></div>
      </form></aside>
      <section aria-labelledby="list-title"><noscript><p>Les filtres interactifs nécessitent JavaScript. Toutes les fiches et leur tableau comparatif sont disponibles ci-dessous.</p></noscript><div class="list-head"><h2 id="list-title">Les modèles</h2><output id="matches" aria-live="polite">{models.length} références</output></div>
        <p class="fine">Prix affichés par Tempus Shop à la date indiquée, hors livraison. Les catégories reprennent les libellés documentés des catalogues.</p>
        <div id="models">{models.map(w=><article class="model" data-id={w.id} data-search={[w.data.brand,w.data.name,w.data.reference].join(' ')} data-budget={w.data.price} data-mouvement={w.data.movement} data-bracelet={w.data.finder!.bracelet} data-categorie={w.data.finder!.category} data-largeur={w.data.size}>
          <div class="model-line"><div><span class="eyebrow">{w.data.brand}</span><h3><a href={'/montres/'+w.id+'/'}>{w.data.name}</a></h3><small>{w.data.reference}</small></div>
          <div class="quote">{w.data.price!=null && <><strong>{money(w.data.price)}</strong><small>Relevé du {w.data.priceCheckedAt && dateLabel(w.data.priceCheckedAt)}</small></>}</div></div>
          <p class="spec">{w.data.movement} · {w.data.finder!.bracelet} · {w.data.size===null?"Largeur à confirmer":w.data.sizeLabel}</p><p>{w.data.note}</p>
          <div class="actions"><a class="text-link" href={'/montres/'+w.id+'/'}>Consulter la fiche →</a><label class="pick" hidden><input type="checkbox" value={w.id} aria-label={'Comparer '+w.data.brand+' '+w.data.reference}/> Comparer</label></div>
        </article>)}</div>
        <div id="no-matches" hidden><h3>Aucun modèle pour ces critères</h3><p>Vous pouvez retirer un critère ou repartir de toute la sélection.</p><button type="button">Afficher toutes les montres</button></div>
        <a class="text-link" id="to-compare" href="#comparaison" hidden>Voir ma comparaison ↓</a>
      </section>
    </div>
    <section id="comparaison" tabindex="-1"><h2>Comparer les montres</h2><p id="compare-info" role="status">Les caractéristiques des {models.length} modèles, côte à côte.</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Caractéristiques comparées"><table><caption>Les repères de choix</caption><thead><tr><th scope="col">Repère</th>{models.map(w=><th scope="col" data-col={w.id}><a href={'/montres/'+w.id+'/'}>{w.data.brand} {w.data.name}<br/>{w.data.reference}</a><button hidden type="button" class="remove" data-remove={w.id} aria-label={'Retirer '+w.data.reference}>Retirer</button></th>)}</tr></thead>
      <tbody>{rows.map(([label,read])=><tr><th scope="row">{label}</th>{models.map(w=><td data-col={w.id}>{read(w)}</td>)}</tr>)}</tbody></table></div>
    </section>
  </div>
</Cadrin>
<script src="../scripts/finder.ts"></script>
<style>
.finder{padding-bottom:70px}.intro{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:end;padding:20px 0 38px;border-bottom:2px solid var(--wine)}.intro h1{font:500 clamp(54px,6vw,86px)/1 var(--display);margin-top:10px}.intro p{max-width:49ch;font-size:18px}.workspace{display:grid;grid-template-columns:minmax(215px,.8fr) minmax(0,2.5fr);gap:clamp(24px,5vw,78px);margin:32px 0 48px}form{background:var(--sand);padding:22px}form h2,.list-head h2,#comparaison h2{font:500 36px/1.1 var(--display)}form label{display:grid;gap:6px;margin-top:14px;font-weight:600;font-size:.88rem}select,input[type=search]{width:100%;min-height:43px;padding:8px;background:var(--ivory);color:var(--wine);border:1px solid var(--muted);font:inherit}button{cursor:pointer;font:inherit;color:var(--wine)}form button,.remove{border:0;text-decoration:underline;background:none;margin-top:12px;padding:8px 0}.list-head,.model-line,.actions{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.fine,small,#compare-info{color:var(--muted);font-size:.88rem}.fine,#compare-info{margin:10px 0 18px}.model{padding:20px 0;border-top:1px solid var(--line)}.model h3{font:500 clamp(32px,4vw,42px)/1.1 var(--display)}.model h3 a{text-decoration:none}.model small{display:block}.quote{text-align:right}.quote strong{font:500 30px/1 var(--display)}.model p{max-width:64ch}.spec{color:var(--wine);font-weight:600;margin:12px 0 5px}.actions{margin-top:12px;align-items:center;flex-wrap:wrap}.pick{min-height:44px;display:inline-flex;align-items:center;gap:7px;cursor:pointer}.pick input{accent-color:var(--wine);width:18px;height:18px}#comparaison{border-top:2px solid var(--wine);padding-top:22px;scroll-margin-top:16px}table{width:100%;border-collapse:collapse}th,td{min-width:145px;padding:12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}thead{background:var(--sand)}caption{text-align:left;padding:8px}.remove{display:block;font-size:.8rem}.finder [hidden]{display:none!important}#no-matches{padding:22px 0}#no-matches button{padding:8px;margin-top:12px}#to-compare{margin:10px 0}
@media(max-width:740px){.intro,.workspace{grid-template-columns:1fr;gap:16px}.intro{padding:10px 0 24px}.intro p{font-size:16px}.workspace{margin-top:20px}form{padding:12px 15px}form h2{display:none}#filter-toggle{font-weight:600;display:block;width:100%;text-align:left;margin:0;padding:8px 0;text-decoration:none}#filter-toggle::after{content:"+";float:right}#filter-toggle[aria-expanded=true]::after{content:"−"}#filter-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;padding-top:12px}form label:first-of-type{grid-column:1/-1}form label{margin-top:4px}form button{align-self:end;text-align:left}th,td{min-width:125px}.quote small{max-width:14ch}}
</style>
