---
import WatchFinder from '../components/WatchFinder.astro';
import InformationPage from '../components/InformationPage.astro';
import {catalogue,production} from '../lib/editorial';
import {launch} from '../data/launch';
export async function getStaticPaths(){const {finder}=await catalogue();return [
 ...(finder.length?[{params:{outil:'trouver-ma-montre'},props:{models:finder,page:null}}]:[]),
 {params:{outil:'contact'},props:{models:[],page:'contact' as const}},
 ...(!production||launch.legalPagesApproved?[{params:{outil:'mentions-legales'},props:{models:[],page:'legal' as const}},{params:{outil:'confidentialite'},props:{models:[],page:'privacy' as const}}]:[])
];}
const {models,page}=Astro.props;
---
{page?<InformationPage page={page}/>:<WatchFinder models={models}/>}
