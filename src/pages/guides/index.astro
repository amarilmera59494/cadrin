---
import Cadrin from '../../layouts/Cadrin.astro';import Photo from '../../components/Photo.astro';import {catalogue} from '../../lib/editorial';
const {guides}=await catalogue();
---
<Cadrin title="Les guides pour bien choisir" description="Des repères de budget, de proportions et de mouvement pour trouver une montre qui vous ressemble." crumbs={[{name:'Guides',url:'/guides/'}]}><div class="container"><nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span>/</span><span>Guides</span></nav><header class="page-heading"><h1>Les guides Cadrin.</h1><p>Du premier budget au choix du mouvement, quelques repères pour trouver la montre que vous aimerez porter.</p></header>{guides.map(g=><section class="guide-index-item"><div>{g.data.image && <Photo name={g.data.image} sizes="(max-width:700px) 100vw, 36vw"/>}</div><div><h2><a href={`/guides/${g.id}/`}>{g.data.title}</a></h2><p>{g.data.description}</p><a class="text-link" href={`/guides/${g.id}/`}>Lire le guide →</a></div></section>)}{!guides.length&&<p class="section">Nos guides sont en cours de préparation. <a href="/notre-methode/">Découvrez notre méthode.</a></p>}</div></Cadrin>

<style>.guide-index-item{display:grid;grid-template-columns:minmax(0,1fr) 1.6fr;gap:clamp(24px,5vw,72px);align-items:center;border-top:1px solid var(--line);padding:clamp(28px,4vw,54px) 0}.guide-index-item:not(:has(figure)){display:block}.guide-index-item p{max-width:62ch;margin:14px 0}.guide-index-item h2{font-size:clamp(30px,4vw,52px)}.guide-index-item h2 a{text-decoration:none}.guide-index-item :global(img){max-height:270px;object-fit:cover}@media(max-width:700px){.guide-index-item{display:block}.guide-index-item :global(figure){margin-bottom:20px}}</style>