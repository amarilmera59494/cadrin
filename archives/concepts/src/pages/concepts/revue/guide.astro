---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';import Photo from '../../../components/Photo.astro';import Comparison from '../../../components/Comparison.astro';import Method from '../../../components/Method.astro';
import '../../../styles/revue.css';
const entries=(await getCollection('guide')).sort((a,b)=>a.data.order-b.data.order);
const chapters=await Promise.all(entries.map(async e=>({...e,...await render(e)})));
---
<Base direction="revue" article title="Choisir sa première montre : budget, taille et mouvement" description="Un guide de lecture pour choisir sa première montre, comprendre les dimensions et comparer les mouvements."><Header direction="revue" guide/><main id="main" class="wrap"><div class="breadcrumb"><a href="/concepts/revue/">La revue</a><span>/</span>Le guide essentiel</div><header class="revue-guide-title"><div><span class="eyebrow">Le guide essentiel</span><div class="guide-number" aria-hidden="true">01.</div></div><div><h1>Choisir sa<br/><em>première montre.</em></h1><p class="intro">Budget, taille et mouvement : des repères pour une décision qui vous ressemble.</p><p class="guide-author">Synthèse documentaire · Lecture : environ 7 minutes<br/>Auteur et relecture à attribuer avant publication · 12 novembre 2026</p></div></header><div class="revue-guide-cover"><Photo name="leather" eager/><section class="guide-summary"><span class="eyebrow">L’essentiel, avant tout</span><h2>Commencez par votre quotidien.</h2><p>Fixez un budget confortable. Regardez les proportions, pas seulement le diamètre. Choisissez le mouvement dont vous appréciez les contraintes autant que les qualités. Et, si possible, essayez.</p></section></div><div class="revue-guide-layout"><aside><nav class="toc" aria-label="Sommaire du guide"><span class="eyebrow">Dans ce guide</span>{chapters.map(e=><a href={`#${e.id}`}><span>0{e.data.order}</span>{e.data.short}</a>)}<a href="#comparatif">Comparer les mouvements</a><a href="#methode">Sources & méthode</a></nav></aside><article class="guide-body">{chapters.map(({id,data,Content})=><section class="guide-chapter" id={id}><span class="eyebrow">0{data.order} / {data.short}</span><h2>{data.title}</h2><Content/></section>)}<section id="comparatif" class="guide-chapter"><h2>Choisir son mouvement, d’un regard.</h2><Comparison/></section><Method/><div class="guide-end"><a class="text-link" href="/concepts/revue/#selection">Revenir aux six références ↗</a></div></article></div></main><Footer direction="revue"/></Base>
