---
import {getCollection,render} from 'astro:content';import Base from '../../../layouts/Base.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';import Photo from '../../../components/Photo.astro';import Comparison from '../../../components/Comparison.astro';import Method from '../../../components/Method.astro';import '../../../styles/allure.css';
const entries=(await getCollection('guide')).sort((a,b)=>a.data.order-b.data.order);const chapters=await Promise.all(entries.map(async e=>({...e,...await render(e)})));
---
<Base direction="allure" article title="Choisir sa première montre : budget, taille et mouvement" description="Le guide de votre première montre : une approche par le quotidien, le confort, le budget et les mouvements."><Header direction="allure" guide/><main id="main"><div class="allure-guide-cover"><header><div class="breadcrumb"><a href="/concepts/allure/">Le carnet</a><span>/</span>Le guide</div><span class="eyebrow">Première montre / Les essentiels</span><h1>La première.<br/>Surtout<br/>la vôtre.</h1><p class="intro">Choisir sa première montre :<br/>budget, taille et mouvement.</p><p class="guide-author">Synthèse documentaire · Environ 7 minutes<br/>Auteur et relecture à attribuer · 12 novembre 2026</p></header><Photo name="sleeve" eager sizes="(max-width: 600px) 100vw, 50vw"/></div><div class="wrap allure-guide-intro"><section class="guide-summary"><span class="eyebrow">À garder en tête</span><h2>Choisissez pour la vie que vous menez.</h2><p>Un budget confortable. Des proportions qui vous plaisent. Un mouvement adapté à vos habitudes. Laissez les classements de côté, réduisez votre sélection et, si possible, prenez le temps d’essayer.</p></section><nav class="toc" aria-label="Sommaire du guide"><span class="eyebrow">Le fil de lecture</span>{chapters.map(e=><a href={`#${e.id}`}><span>0{e.data.order}</span>{e.data.short}</a>)}<a href="#comparatif">Les mouvements, en regard</a><a href="#methode">Sources & méthode</a></nav></div><article class="allure-article guide-body">{chapters.map(({id,data,Content})=><section id={id} class="guide-chapter"><span class="eyebrow">0{data.order} / {data.short}</span><h2>{data.title}</h2><Content/></section>)}<section id="comparatif" class="guide-chapter"><h2>Trois mouvements.<br/>Trois habitudes.</h2><Comparison/></section><Method/><div class="guide-end"><a class="text-link" href="/concepts/allure/#selection">Retrouver la sélection ↗</a></div></article></main><Footer direction="allure"/></Base>
