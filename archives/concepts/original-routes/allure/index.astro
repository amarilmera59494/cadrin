---
import Base from '../../../layouts/Base.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';import Photo from '../../../components/Photo.astro';import Product from '../../../components/Product.astro';import Affiliation from '../../../components/Affiliation.astro';import {products} from '../../../data/products';import {affiliateDisclosure} from '../../../data/merchants';import '../../../styles/allure.css';
const guide='/concepts/allure/guide/';
---
<Base direction="allure" title="ALLURE — L’heure de vivre" description="Une montre dans la vie : matières, silhouettes et usages pour explorer une sélection horlogère."><Header direction="allure"/><main id="main"><section class="allure-hero"><div class="allure-hero-copy"><div class="hero-index"><span>Le carnet de style</span><span>Volume 01</span></div><h1>L’heure<br/>de vivre.</h1><p>Une manche retroussée.<br/>Un geste familier. Une montre à soi.<br/>Le style commence au quotidien.</p><a href="#selection" class="text-link">Trouver son caractère <span aria-hidden="true">↗</span></a></div><Photo name="sleeve" eager sizes="(max-width: 600px) 100vw, 55vw"/></section><nav class="editorial-ribbon wrap" aria-label="Choisir par usage"><span class="ribbon-title">À chaque jour, son allure.</span><div class="use-links"><a href="#seiko-srpe55">Quotidien ↗</a><a href="#citizen-aw1231">Bureau ↗</a><a href="#seiko-srpg35">Week-end ↗</a><a href={`${guide}#usage`}>Cadeau ↗</a></div></nav>
<section class="wrap section" id="selection"><div class="section-heading"><div><span class="eyebrow">Six références, plusieurs façons de les imaginer</span><h2>Du caractère.<br/>Sans surjouer.</h2></div><p>Des pistes de style, à confronter au porté.<br/>Fiches documentaires, sans essai.</p></div><div class="allure-products">{products.map((p,i)=><Product product={p} index={i} placement="allure-selection"/>)}</div><p class="selection-disclosure">Photos produit autorisées à obtenir ; prix et disponibilités non vérifiés. {affiliateDisclosure} Aucun lien affilié actif ici.</p></section>
<section class="allure-story" id="budget"><div class="wrap allure-diptych"><Photo name="wrist"/><div><span class="eyebrow">Le vestiaire des essentiels</span><h2>Moins de codes.<br/>Plus de vous.</h2><p>Le cuir avec une veste. L’acier avec une maille. Ou tout l’inverse. Une montre ne devrait pas vous imposer un personnage.</p><p>Commencez par un budget qui vous convient, puis cherchez une présence qui vous plaît.</p><div class="budget-inline"><a href={`${guide}#budget`}>100–200 € ↗</a><a href={`${guide}#budget`}>200–400 € ↗</a><a href={`${guide}#budget`}>400–600 € ↗</a></div><p class="selection-disclosure">Repères de budget, pas des offres produits.</p><Photo name="leather" class="small-photo" sizes="(max-width: 600px) 80vw, 30vw"/></div></div></section>
<section class="wrap section allure-guide-feature"><span class="oversized-number" aria-hidden="true">01</span><div><span class="eyebrow">La première, surtout la vôtre</span><h2>Bien choisir.<br/>Puis ne plus y penser.</h2><p>Budget, taille, mouvement : le vocabulaire peut sembler compliqué. Le choix, lui, peut rester simple. Notre guide remet les choses dans l’ordre.</p><a href={guide} class="text-link">Lire le guide de la première montre ↗</a></div></section>
<section class="allure-manifesto" id="approche"><div class="wrap"><h2>On aime les montres.<br/>On préfère les porter.</h2><div><p>Le prestige ne remplace pas le plaisir. Nous regardons d’abord ce qu’un objet apporte à une journée : une lecture claire, un équilibre, un détail qui nous plaît.</p><p>Ce regard est éditorial. Les caractéristiques viennent des fabricants ; les impressions au poignet attendront un vrai essai.</p><a href={`${guide}#methode`} class="text-link">Notre façon de regarder ↗</a></div></div></section><div class="wrap"><Affiliation/></div></main><Footer direction="allure"/></Base>
